---
const stats = [
  { en: 'Healed Patients',      ml: 'രോഗ നിവൃത്തി',       value: '25000', suffix: '+' },
  { en: 'Years of Experience',  ml: 'വർഷത്തെ അനുഭവം',     value: '35',    suffix: '+' },
  { en: 'Authentic Treatments', ml: 'ആധികാരിക ചികിത്സകൾ', value: '50',    suffix: '+' },
];
---

<div class="bg-white py-8 md:py-16 border-y border-accent-gold/20 relative overflow-hidden">
  
  <!-- Subtle organic background details -->
  <div class="absolute inset-0 bg-parchment-texture opacity-[0.02]"></div>
  
  <div class="container mx-auto px-2 sm:px-4 relative z-10">
    <div class="grid grid-cols-3 gap-1.5 sm:gap-6 lg:gap-8 max-w-5xl mx-auto">
      {stats.map((stat, index) => (
        <div class="bg-white p-2.5 sm:p-6 lg:p-8 rounded-lg md:rounded-2xl border border-accent-gold/15 shadow-sm hover:shadow-lg sm:hover:-translate-y-1 transition-all duration-300 text-center relative group">
          
          <!-- Inner card glow -->
          <div class="absolute inset-0 bg-accent-gold/5 rounded-lg md:rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

          <!-- Stat Number -->
          <div class="text-[15px] sm:text-3xl md:text-5xl font-serif font-bold text-primary-dark mb-1 relative z-10 leading-tight">
            <span class="stat-number text-primary" data-value={stat.value}>0</span><span class="text-accent-gold">{stat.suffix}</span>
          </div>

          <!-- English Title -->
          <div class="lang-en text-[7px] sm:text-[10px] font-sans text-text-muted uppercase tracking-wider sm:tracking-widest font-bold relative z-10 leading-tight">
            {stat.en}
          </div>

          <!-- Malayalam Title -->
          <div class="lang-ml font-malayalam text-[8px] sm:text-[11px] text-text-muted font-bold relative z-10 leading-tight mt-0.5">
            {stat.ml}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  function initStats() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const target = entry.target as HTMLElement;
          const endValue = parseInt(target.getAttribute('data-value') || '0');
          const duration = 1800;
          const startTime = performance.now();
          const updateCount = (currentTime: number) => {
            const progress = Math.min((currentTime - startTime) / duration, 1);
            target.innerText = Math.floor(progress * endValue).toLocaleString();
            if (progress < 1) requestAnimationFrame(updateCount);
            else target.innerText = endValue.toLocaleString();
          };
          requestAnimationFrame(updateCount);
          observer.unobserve(target);
        }
      });
    }, { threshold: 0.2 });

    document.querySelectorAll('.stat-number').forEach(stat => observer.observe(stat));
  }

  // Initial load
  initStats();

  // Re-run on View Transitions
  document.addEventListener('astro:page-load', initStats);
</script>
