---
import { Heart, Flower2, Sparkles, Leaf, Apple, Smile, ArrowRight, CalendarHeart, PhoneCall, Baby, PersonStanding, UserPlus } from 'lucide-react';
---

<div class="relative bg-[#F9F6F0] py-16 md:py-24 overflow-x-hidden border-y border-[#2D4A3E]/10 font-sans">
  <!-- Subtle Background Accents -->
  <div class="absolute inset-0 opacity-[0.02] mix-blend-multiply pointer-events-none bg-parchment-texture bg-repeat z-0"></div>
  <div class="absolute -top-40 -right-40 w-96 h-96 bg-[#E8F0EA] rounded-full blur-[120px] pointer-events-none z-0"></div>
  <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-[#E8F0EA] rounded-full blur-[120px] pointer-events-none z-0"></div>

  <div class="container mx-auto px-4 md:px-6 max-w-7xl relative z-10">
    
    <!-- 1. Hero Section -->
    <div class="text-center max-w-3xl mx-auto mb-12 md:mb-20 animate-on-scroll opacity-0 translate-y-6 transition-all duration-1000 ease-out">
      <div class="inline-flex items-center justify-center gap-2 px-3 py-1.5 md:px-4 md:py-2 rounded-full bg-[#2D4A3E]/5 border border-[#2D4A3E]/10 mb-4 md:mb-6">
        <Heart class="text-[#2D4A3E] w-3 h-3 md:w-4 md:h-4" />
        <span class="text-[#2D4A3E] text-[10px] md:text-xs uppercase tracking-[0.2em] font-bold">Complete Women's Wellness Program</span>
      </div>
      
      <h2 class="text-3xl md:text-5xl lg:text-6xl text-[#2D4A3E] font-serif mb-4 md:mb-6 leading-tight">
        She Care Package
      </h2>
      
      <p class="text-[#2D4A3E]/80 text-base md:text-xl leading-relaxed max-w-2xl mx-auto">
        A holistic wellness package designed to support women through every stage of life including menarche, pregnancy, postnatal recovery, and menopause care using Ayurveda, Siddha, Yoga, and natural therapies.
      </p>
    </div>

    <!-- 2. Minimal Icon-Based Care Cards -->
    <div class="shecare-carousel flex sm:grid sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 lg:gap-8 mb-16 md:mb-24 overflow-x-auto pb-6 snap-x snap-mandatory hide-scrollbar" style="scroll-behavior: smooth;">
      {
        [
          {
            title: "Menarche Care",
            desc: "Guiding young women through their first transition with natural hormonal balance.",
            delay: "0",
            icon: Sparkles,
            color: "bg-[#2D4A3E]"
          },
          {
            title: "Prenatal Care",
            desc: "Nurturing mother and baby with specialized Ayurvedic diets and gentle therapies.",
            delay: "150",
            icon: Heart,
            color: "bg-[#2D4A3E]"
          },
          {
            title: "Postnatal Care",
            desc: "Aiding recovery with traditional strengthening treatments and restorative care.",
            delay: "300",
            icon: Baby,
            color: "bg-[#2D4A3E]"
          },
          {
            title: "Menopause Care",
            desc: "Easing the transition with cooling therapies and natural emotional balance.",
            delay: "450",
            icon: PersonStanding,
            color: "bg-[#2D4A3E]"
          }
        ].concat([
          {
            title: "Menarche Care",
            desc: "Guiding young women through their first transition with natural hormonal balance.",
            delay: "0",
            icon: Sparkles,
            color: "bg-[#2D4A3E]"
          },
          {
            title: "Prenatal Care",
            desc: "Nurturing mother and baby with specialized Ayurvedic diets and gentle therapies.",
            delay: "150",
            icon: Heart,
            color: "bg-[#2D4A3E]"
          },
          {
            title: "Postnatal Care",
            desc: "Aiding recovery with traditional strengthening treatments and restorative care.",
            delay: "300",
            icon: Baby,
            color: "bg-[#2D4A3E]"
          },
          {
            title: "Menopause Care",
            desc: "Easing the transition with cooling therapies and natural emotional balance.",
            delay: "450",
            icon: PersonStanding,
            color: "bg-[#2D4A3E]"
          }
        ]).map((card, idx) => {
          const Icon = card.icon;
          return (
            <div 
              class={`group relative rounded-[1.5rem] md:rounded-[2rem] p-6 md:p-8 overflow-hidden shadow-[0_8px_30px_rgb(0,0,0,0.03)] hover:shadow-[0_20px_40px_rgb(45,74,62,0.08)] transition-all duration-500 hover:-translate-y-2 animate-on-scroll opacity-0 translate-y-8 ${card.color} border border-white flex flex-col shrink-0 w-[85vw] sm:w-auto snap-center`}
              style={`transition-delay: ${card.delay}ms`}
            >
              <div class="absolute -top-10 -right-10 w-24 h-24 md:w-32 md:h-32 bg-white/10 rounded-full opacity-50 group-hover:scale-150 transition-transform duration-700 ease-out z-0"></div>
              
              <div class="relative z-10 flex flex-col h-full">
                <div class="w-12 h-12 md:w-14 md:h-14 rounded-xl md:rounded-2xl bg-white shadow-sm flex items-center justify-center mb-4 md:mb-6 text-[#2D4A3E] group-hover:scale-110 group-hover:bg-[#E8F0EA] transition-all duration-500">
                  <Icon class="w-6 h-6 md:w-7 md:h-7" strokeWidth={1.5} />
                </div>
                
                <h3 class="text-xl md:text-2xl text-white font-serif font-bold mb-2 md:mb-3">{card.title}</h3>
                
                <p class="text-white/80 text-sm leading-relaxed mb-4 md:mb-6 flex-grow">{card.desc}</p>
                
                <div class="flex items-center text-[10px] md:text-xs font-bold uppercase tracking-wider text-white group-hover:text-accent-gold transition-colors mt-auto">
                  Explore Therapy
                  <ArrowRight class="w-3 h-3 md:w-4 md:h-4 ml-2 transform group-hover:translate-x-2 transition-transform duration-300" />
                </div>
              </div>
            </div>
          )
        })
      }
    </div>

    <!-- 3. Benefits Section -->
    <div class="mb-16 md:mb-24 animate-on-scroll opacity-0 translate-y-8">
      <div class="text-center mb-8 md:mb-12">
        <h3 class="text-2xl md:text-4xl text-[#2D4A3E] font-serif mb-3 md:mb-4">Holistic Care Pillars</h3>
        <div class="w-12 md:w-16 h-1 bg-[#2D4A3E]/20 mx-auto rounded-full"></div>
      </div>
      
      <div class="shecare-carousel flex md:grid md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 overflow-x-auto pb-6 snap-x snap-mandatory hide-scrollbar" style="scroll-behavior: smooth;">
        {
          [
            { icon: Leaf, title: "Authentic Treatments", text: "Traditional Ayurvedic & Siddha Treatments" },
            { icon: Apple, title: "Nutrition", text: "Personalized Diet & Lifestyle Guidance" },
            { icon: Flower2, title: "Wellness", text: "Yoga & Wellness Support" },
            { icon: Sparkles, title: "Natural Care", text: "Natural Therapies for Women’s Health" },
            { icon: Smile, title: "Mental Health", text: "Postpartum Emotional Wellness Support" }
          ].map(benefit => {
            const Icon = benefit.icon;
            return (
              <div class="bg-white/60 backdrop-blur-md rounded-2xl p-4 md:p-6 flex items-start gap-4 md:gap-5 border border-white hover:border-[#2D4A3E]/20 hover:shadow-lg transition-all duration-300 group shrink-0 w-[85vw] md:w-auto snap-center">
                <div class="w-10 h-10 md:w-12 md:h-12 rounded-xl bg-[#E8F0EA] text-[#2D4A3E] flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform duration-300">
                  <Icon strokeWidth={1.5} size={20} class="md:w-6 md:h-6" />
                </div>
                <div>
                  <h4 class="text-[#2D4A3E] font-bold font-serif text-base md:text-lg mb-1">{benefit.title}</h4>
                  <p class="text-[#2D4A3E]/70 text-xs md:text-sm leading-snug">{benefit.text}</p>
                </div>
              </div>
            )
          })
        }
      </div>
    </div>

    <!-- 4. CTA Section -->
    <div class="bg-[#2D4A3E] rounded-[1.5rem] md:rounded-[2.5rem] p-6 md:p-10 lg:p-16 text-center relative overflow-hidden shadow-2xl shadow-[#2D4A3E]/20 animate-on-scroll opacity-0 translate-y-8">
      <!-- Deco elements -->
      <div class="absolute top-0 right-0 w-32 h-32 md:w-64 md:h-64 bg-white/5 rounded-full blur-[50px] mix-blend-overlay"></div>
      <div class="absolute bottom-0 left-0 w-32 h-32 md:w-64 md:h-64 bg-[#E8F0EA]/10 rounded-full blur-[50px] mix-blend-overlay"></div>
      
      <div class="relative z-10 max-w-2xl mx-auto">
        <h4 class="text-2xl md:text-3xl lg:text-5xl text-white font-serif mb-4 md:mb-6 leading-tight">Book Your Consultation Today</h4>
        <p class="text-white/80 text-sm md:text-lg mb-8 md:mb-10">
          Take the first step towards holistic feminine health and balance. Our female specialists are here to guide you.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 md:gap-6">
          <a href="/appointment" class="w-full sm:w-auto inline-flex items-center justify-center px-6 md:px-8 py-3 md:py-4 bg-[#E8F0EA] text-[#2D4A3E] rounded-full font-bold uppercase tracking-wider text-[11px] md:text-sm hover:bg-white hover:-translate-y-1 transition-all duration-300 shadow-lg">
            <CalendarHeart class="w-4 h-4 md:w-5 md:h-5 mr-2" />
            Book Appointment
          </a>
          
          <a href="tel:+918593821553" class="w-full sm:w-auto inline-flex items-center justify-center px-6 md:px-8 py-3 md:py-4 bg-transparent border-2 border-white/30 text-white rounded-full font-bold uppercase tracking-wider text-[11px] md:text-sm hover:border-white hover:bg-white/10 hover:-translate-y-1 transition-all duration-300">
            <PhoneCall class="w-4 h-4 md:w-5 md:h-5 mr-2" />
            Call Now
          </a>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  /* Fix for smooth height transition on hover */
  .grid-rows-\[0fr\] {
    grid-template-rows: 0fr;
  }
  .grid-rows-\[1fr\] {
    grid-template-rows: 1fr;
  }
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  function initSheCareAnimations() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.remove('opacity-0', 'translate-y-6', 'translate-y-8');
          entry.target.classList.add('opacity-100', 'translate-y-0');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.animate-on-scroll').forEach(el => {
      observer.observe(el);
    });
  }

  function initMobileAutoScroll() {
    if (window.shecareIntervals) {
      window.shecareIntervals.forEach(clearInterval);
    }
    window.shecareIntervals = [];

    const carousels = document.querySelectorAll('.shecare-carousel');
    
    carousels.forEach((carousel) => {
      let isPaused = false;
      
      // Pause on touch
      carousel.addEventListener('touchstart', () => isPaused = true, {passive: true});
      carousel.addEventListener('touchend', () => {
        setTimeout(() => isPaused = false, 3000);
      });
      
      const interval = setInterval(() => {
        // Only run on mobile where flex layout is active
        if (isPaused || window.innerWidth >= 640) return;
        
        const firstChild = carousel.firstElementChild;
        if (!firstChild) return;
        
        const itemWidth = firstChild.clientWidth + 16; // width + approx gap
        const totalScrollWidth = carousel.scrollWidth;
        const visibleWidth = carousel.clientWidth;
        
        // If we are at or past the middle (end of the first set of duplicated cards)
        if (carousel.scrollLeft >= totalScrollWidth / 2) {
          // Instantly reset to the identical position in the first set without smooth scroll
          carousel.style.scrollBehavior = 'auto';
          carousel.scrollLeft = carousel.scrollLeft - (totalScrollWidth / 2);
          
          // Wait a frame, then smooth scroll to the next item
          requestAnimationFrame(() => {
            carousel.style.scrollBehavior = 'smooth';
            carousel.scrollBy({ left: itemWidth, behavior: 'smooth' });
          });
        } else {
          // Smoothly scroll to the next item
          carousel.scrollBy({ left: itemWidth, behavior: 'smooth' });
        }
      }, 3000);

      window.shecareIntervals.push(interval);
    });
  }

  initSheCareAnimations();
  initMobileAutoScroll();
  
  document.addEventListener('astro:page-load', () => {
    initSheCareAnimations();
    // Auto-scroll initialization will be duplicated if not careful, 
    // but setInterval without clearing might cause double loops.
    // Astro page transitions might preserve DOM or recreate.
    // For safety, the script tag is re-executed on swap.
    initMobileAutoScroll();
  });
</script>
