---
import { Heart, Flower2, Sparkles, Leaf, Apple, Smile, CalendarHeart, PhoneCall, Baby, PersonStanding, CheckCircle2 } from 'lucide-react';
---

<section class="relative py-16 md:py-24 border-y border-primary/10 overflow-hidden" id="shecare-section">
  <!-- Parallax Background Layer -->
  <div class="absolute -inset-[20%] z-0 bg-cover bg-center will-change-transform" style="background-image: url('https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/herbal-garden-2.jpg');" data-parallax="0.15"></div>
  <!-- Overlay -->
  <div class="absolute inset-0 bg-gray-50/70 backdrop-blur-[1px] z-0"></div>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl relative z-10">
    
    <!-- Premium Logo Header -->
    <div class="text-center mb-16 relative flex flex-col items-center" data-aos="fade-up" data-aos-duration="1000">
      
      <div class="relative mb-8 inline-flex items-center justify-center">
        <div class="w-32 h-32 md:w-40 md:h-40 rounded-full flex items-center justify-center overflow-hidden z-10">
          <img 
            src="https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/shecarelogo_circle.png" 
            alt="She Care Ayurveda Logo" 
            class="w-full h-full object-cover scale-[1.02] animate-float" 
          />
        </div>
      </div>
      
      <div class="inline-flex items-center justify-center gap-4 mb-5">
        <div class="w-12 h-px bg-gradient-to-r from-transparent to-accent-gold"></div>
        <span class="lang-en text-accent-gold uppercase tracking-[0.3em] text-[10px] md:text-xs font-bold font-sans">Exclusive For Women</span>
        <span class="lang-ml font-malayalam text-accent-gold text-sm font-semibold">സ്ത്രീകൾക്ക് മാത്രം</span>
        <div class="w-12 h-px bg-gradient-to-l from-transparent to-accent-gold"></div>
      </div>
      
      <h2 class="lang-en text-3xl md:text-4xl lg:text-5xl font-serif text-primary-dark font-bold mb-6 tracking-tight leading-tight">
        The She Care <span class="italic text-accent-gold">Journey</span>
      </h2>
      <h2 class="lang-ml font-malayalam text-3xl md:text-4xl lg:text-5xl text-primary-dark font-bold mb-6 tracking-tight leading-tight">
        ഷീ കെയർ <span class="text-accent-gold">യാത്ര</span>
      </h2>

      <p class="lang-en text-text-muted text-sm md:text-base lg:text-lg max-w-2xl mx-auto leading-relaxed font-sans">
        A sanctuary of healing tailored exclusively for women. We blend ancient Ayurvedic wisdom with compassionate care to support you through every stage of womanhood.
      </p>
      <p class="lang-ml font-malayalam text-text-muted text-sm md:text-base lg:text-lg max-w-2xl mx-auto leading-relaxed font-medium">
        സ്ത്രീകൾക്ക് മാത്രമായി തയ്യാറാക്കിയ ഒരു ചികിത്സാ കേന്ദ്രം. പുരാതന ആയുർവേദ അറിവുകളും സ്നേഹപൂർവ്വമായ പരിചരണവും സമന്വയിപ്പിച്ച് സ്ത്രീത്വത്തിന്റെ ഓരോ ഘട്ടത്തിലും ഞങ്ങൾ നിങ്ങളെ പിന്തുണയ്ക്കുന്നു.
      </p>
    </div>

    <!-- Bootstrap-Style Cards Carousel -->
    <div class="relative w-full py-4 max-w-7xl mx-auto mb-16 carousel-container" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="200">
      
      <!-- Navigation Arrows (Desktop) -->
      <button 
        id="shecare-prev-btn" 
        class="carousel-arrow absolute -left-2 lg:-left-8 top-1/2 -translate-y-1/2 z-30 hidden md:flex w-12 h-12 bg-white rounded-full shadow-lg items-center justify-center text-primary hover:bg-primary hover:text-white transition-all border border-gray-100 opacity-0 translate-x-4 duration-300"
        aria-label="Previous"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      
      <button 
        id="shecare-next-btn" 
        class="carousel-arrow absolute -right-2 lg:-right-8 top-1/2 -translate-y-1/2 z-30 hidden md:flex w-12 h-12 bg-white rounded-full shadow-lg items-center justify-center text-primary hover:bg-primary hover:text-white transition-all border border-gray-100 opacity-0 -translate-x-4 duration-300"
        aria-label="Next"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <div 
        id="shecare-carousel"
        class="shecare-carousel-container flex overflow-x-auto pb-8 hide-scrollbar scroll-smooth"
      >
        {
          (() => {
            const cards = [
              { titleEn: "Menarche Care", titleMl: "ആർത്തവാരംഭ പരിചരണം", descEn: "Guiding young women through their first transition with natural hormonal balance and nurturing dietary guidance.", descMl: "സ്വാഭാവിക ഹോർമോൺ സന്തുലിതാവസ്ഥയിലൂടെയും പോഷകാഹാര നിർദ്ദേശങ്ങളിലൂടെയും യുവതികളെ അവരുടെ ആദ്യ മാറ്റത്തിലൂടെ നയിക്കുന്നു.", img: "https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/menarche_care.png" },
              { titleEn: "Prenatal Care", titleMl: "ഗർഭകാല പരിചരണം", descEn: "Nurturing mother and baby with specialized Ayurvedic diets, gentle therapies, and emotional wellness support.", descMl: "പ്രത്യേക ആയുർവേദ ഭക്ഷണക്രമം, മൃദുവായ ചികിത്സകൾ, വൈകാരിക ക്ഷേമ പിന്തുണ എന്നിവ ഉപയോഗിച്ച് അമ്മയെയും കുഞ്ഞിനെയും പോറ്റുന്നു.", img: "https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/prenatal_care.png" },
              { titleEn: "Postnatal Care", titleMl: "പ്രസവാനന്തര പരിചരണം", descEn: "Aiding recovery with traditional strengthening treatments, restorative care, and postpartum mental health focus.", descMl: "പരമ്പരാഗത ശാക്തീകരണ ചികിത്സകളും, പുനരുജ്ജീവന പരിചരണവും, പ്രസവാനന്തര മാനസികാരോഗ്യ ശ്രദ്ധയും നൽകി വീണ്ടെടുക്കലിനെ സഹായിക്കുന്നു.", img: "https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/postnatal_care.png" },
              { titleEn: "Menopause Care", titleMl: "ആർത്തവവിരാമ പരിചരണം", descEn: "Easing the transition with cooling therapies, bone health support, and natural emotional balance treatments.", descMl: "ശരീരം തണുപ്പിക്കുന്ന ചികിത്സകൾ, അസ്ഥികളുടെ ആരോഗ്യ പിന്തുണ, സ്വാഭാവിക വൈകാരിക സന്തുലിതാവസ്ഥകൾ എന്നിവ ഉപയോഗിച്ച് ഈ മാറ്റം എളുപ്പമാക്കുന്നു.", img: "https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/menopause_care.png" }
            ];
            return cards.map((card, idx) => (
            <div 
              class="shecare-card shrink-0 bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.08)] hover:shadow-[0_20px_40px_rgb(0,0,0,0.12)] border border-accent-gold/10 transition-all duration-500 flex flex-col overflow-hidden select-none group"
            >
              <!-- Card Image (Top) -->
              <div class="w-full aspect-[4/3] overflow-hidden bg-gray-50 relative">
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
                <img src={card.img} alt={card.titleEn} class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700 pointer-events-none" draggable="false" />
              </div>

              <!-- Card Body (Bottom) -->
              <div class="p-8 flex flex-col flex-grow bg-white z-20 relative -mt-4 rounded-t-2xl">
                <div class="w-12 h-1 bg-accent-gold mb-6 rounded-full"></div>
                
                <h3 class="lang-en text-xl text-primary font-serif font-bold mb-4">{card.titleEn}</h3>
                <h3 class="lang-ml font-malayalam text-xl text-primary font-bold mb-4">{card.titleMl}</h3>
                
                <p class="lang-en text-text-muted text-base leading-relaxed mb-8 flex-grow">{card.descEn}</p>
                <p class="lang-ml font-malayalam text-text-muted text-base leading-relaxed mb-8 flex-grow">{card.descMl}</p>
                
                <a href="/treatments" class="mt-auto inline-flex items-center justify-between w-full py-4 px-6 bg-primary/5 text-primary rounded-xl font-bold text-sm hover:bg-primary hover:text-white transition-all duration-300 group/btn">
                  <span class="lang-en">View Details</span>
                  <span class="lang-ml font-malayalam">കൂടുതൽ വിവരങ്ങൾ</span>
                  <span class="transform group-hover/btn:translate-x-2 transition-transform">→</span>
                </a>
              </div>
            </div>
          ))
          })()
        }
      </div>
    </div>

    <!-- Premium Features Grid -->
    <div class="text-center mb-10">
      <h3 class="lang-en text-2xl md:text-3xl text-primary-dark font-serif font-bold mb-4">Why Choose She Care?</h3>
      <h3 class="lang-ml font-malayalam text-2xl md:text-3xl text-primary-dark font-bold mb-4">എന്തുകൊണ്ട് ഷീ കെയർ?</h3>
      <div class="w-24 h-1 bg-accent-gold mx-auto rounded-full"></div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {
        [
          { titleEn: "Authentic Ayurveda", titleMl: "ആധികാരിക ആയുർവേദം", descEn: "Traditional Siddha & Ayurvedic therapies", descMl: "പരമ്പരാഗത സിദ്ധ, ആയുർവേദ ചികിത്സകൾ", icon: Sparkles },
          { titleEn: "Personalized Diet", titleMl: "വ്യക്തിഗത ഭക്ഷണക്രമം", descEn: "Nutrition plans tailored to your dosha", descMl: "നിങ്ങളുടെ പ്രകൃതത്തിന് അനുയോജ്യമായ പോഷകാഹാരം", icon: Apple },
          { titleEn: "Yoga & Wellness", titleMl: "യോഗ & വെൽനസ്", descEn: "Guided exercises for physical balance", descMl: "ശാരീരിക സന്തുലിതാവസ്ഥയ്ക്കുള്ള വ്യായാമങ്ങൾ", icon: PersonStanding },
          { titleEn: "Mental Health", titleMl: "മാനസികാരോഗ്യം", descEn: "Counseling and emotional support", descMl: "കൗൺസിലിംഗും വൈകാരിക പിന്തുണയും", icon: Smile }
        ].map(benefit => (
          <div class="bg-white/80 backdrop-blur-sm p-8 rounded-[1.5rem] border border-accent-gold/20 shadow-[0_8px_30px_rgb(0,0,0,0.04)] hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group flex flex-col items-center text-center">
            <div class="w-14 h-14 rounded-full bg-primary-dark/5 flex items-center justify-center mb-5 group-hover:scale-110 group-hover:bg-accent-gold/10 transition-all duration-300 border border-accent-gold/10">
              <benefit.icon className="text-accent-gold w-6 h-6" />
            </div>
            <h4 class="lang-en text-primary-dark font-serif font-bold text-lg mb-2">{benefit.titleEn}</h4>
            <h4 class="lang-ml font-malayalam text-primary-dark font-bold text-lg mb-2">{benefit.titleMl}</h4>
            
            <p class="lang-en text-text-muted font-sans text-sm leading-relaxed">{benefit.descEn}</p>
            <p class="lang-ml font-malayalam text-text-muted text-sm leading-relaxed">{benefit.descMl}</p>
          </div>
        ))
      }
    </div>

    <!-- Elegant CTA Box -->
    <div class="relative rounded-[2.5rem] bg-gradient-to-br from-primary to-primary-dark p-10 md:p-16 text-center shadow-2xl overflow-hidden border border-accent-gold/20">
      <!-- Decorative Elements -->
      <div class="absolute top-0 right-0 w-64 h-64 bg-accent-gold/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
      <div class="absolute bottom-0 left-0 w-64 h-64 bg-white/5 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>
      
      <div class="absolute top-1/2 left-10 opacity-[0.03] -translate-y-1/2 hidden lg:block pointer-events-none">
        <Flower2 className="w-48 h-48 text-accent-gold" />
      </div>
      <div class="absolute top-1/2 right-10 opacity-[0.03] -translate-y-1/2 hidden lg:block pointer-events-none">
        <Leaf className="w-48 h-48 text-accent-gold" />
      </div>
      
      <div class="relative z-10 max-w-3xl mx-auto">
        <span class="lang-en inline-block py-1.5 px-4 rounded-full border border-accent-gold/30 bg-accent-gold/10 text-accent-gold text-[9px] sm:text-[10px] font-bold uppercase tracking-widest mb-6">Begin Your Journey</span>
        <span class="lang-ml font-malayalam inline-block py-1.5 px-4 rounded-full border border-accent-gold/30 bg-accent-gold/10 text-accent-gold text-[10px] font-bold tracking-widest mb-6">നിങ്ങളുടെ യാത്ര ആരംഭിക്കുക</span>
        
        <h4 class="lang-en text-2xl md:text-4xl font-serif text-white font-bold mb-6 leading-tight">Embrace Your <span class="italic text-accent-gold">Natural Balance</span></h4>
        <h4 class="lang-ml font-malayalam text-2xl md:text-4xl text-white font-bold mb-6 leading-tight">നിങ്ങളുടെ <span class="text-accent-gold">സ്വാഭാവിക സന്തുലിതാവസ്ഥ</span> വീണ്ടെടുക്കുക</h4>
        
        <p class="lang-en text-white/70 text-sm md:text-base mb-10 font-sans leading-relaxed max-w-2xl mx-auto">
          Take the first step towards profound wellness. Consult with our specialized female practitioners to create a care plan that perfectly matches your body's needs.
        </p>
        <p class="lang-ml font-malayalam text-white/70 text-sm md:text-base mb-10 font-medium leading-relaxed max-w-2xl mx-auto">
          സമ്പൂർണ്ണ ആരോഗ്യത്തിലേക്കുള്ള ആദ്യ ചുവടുവെക്കാം. നിങ്ങളുടെ ശരീരത്തിന്റെ ആവശ്യങ്ങൾക്കനുസരിച്ചുള്ള ഒരു ചികിത്സാ പദ്ധതി തയ്യാറാക്കാൻ ഞങ്ങളുടെ വിദഗ്ദ്ധ വനിതാ ഡോക്ടർമാരുമായി ബന്ധപ്പെടുക.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
          <a href="/appointment" class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 bg-accent-gold text-primary-dark rounded-xl font-bold text-base hover:bg-yellow-500 shadow-[0_10px_25px_rgba(212,175,55,0.3)] transition-all transform hover:-translate-y-0.5 group">
            <CalendarHeart className="w-5 h-5 mr-2 group-hover:scale-110 transition-transform" />
            <span class="lang-en">Book a Consultation</span>
            <span class="lang-ml font-malayalam">കൺസൾട്ടേഷൻ ബുക്ക് ചെയ്യുക</span>
          </a>
          <a href="tel:+918593821553" class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 bg-transparent border border-white/20 text-white rounded-xl font-bold text-base hover:bg-white/10 hover:border-white/40 transition-all group">
            <PhoneCall className="w-5 h-5 mr-2 group-hover:rotate-12 transition-transform" />
            <span class="lang-en">Call Our Specialists</span>
            <span class="lang-ml font-malayalam">ഞങ്ങളെ വിളിക്കുക</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
  }
  
  .hide-scrollbar::-webkit-scrollbar {
    display: none !important;
  }
  .hide-scrollbar {
    -ms-overflow-style: none !important;
    scrollbar-width: none !important;
  }

  /* Carousel layout: CSS-scroll-snapping handles everything */
  .shecare-carousel-container {
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  /* Each card occupies the full carousel width on mobile */
  .shecare-card {
    /* Mobile: full width, 16px side padding from the container */
    width: calc(100% - 2rem);
    margin: 0 0.5rem;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* Tablet: fixed width */
  @media (min-width: 640px) {
    .shecare-card {
      width: 350px;
      margin: 0 0.75rem;
    }
  }

  /* Desktop */
  @media (min-width: 768px) {
    .shecare-card {
      width: 400px;
      margin: 0 0.75rem;
    }
  }

  /* Add leading/trailing phantom padding so first/last card snaps flush */
  .shecare-carousel-container::before,
  .shecare-carousel-container::after {
    content: '';
    display: block;
    flex-shrink: 0;
    width: 0.5rem;
  }

  /* Custom Hover for Arrows */
  @media (hover: hover) {
    .carousel-container:hover .carousel-arrow {
      opacity: 1;
      transform: translateY(-50%) translateX(0);
    }
  }
</style>

<script>
  function initSheCareCarousel() {
    const carousel = document.getElementById('shecare-carousel') as HTMLElement;
    if (!carousel || carousel.dataset.initialized) return;
    carousel.dataset.initialized = 'true';

    const originalItems = Array.from(carousel.querySelectorAll('.shecare-card'));
    if (originalItems.length === 0) return;

    const originalCount = originalItems.length;

    // Clone nodes dynamically for infinite loop
    originalItems.forEach(item => {
      carousel.appendChild(item.cloneNode(true));
    });
    
    [...originalItems].reverse().forEach(item => {
      carousel.insertBefore(item.cloneNode(true), carousel.firstChild);
    });

    const items = Array.from(carousel.querySelectorAll('.shecare-card')) as HTMLElement[];

    let currentIndex = originalCount; // start in the middle set
    let autoScrollInterval: any;
    let isUserInteracting = false;
    let isProgrammaticScroll = false;
    let interactionTimeout: any;

    let scrollTimeout: any;
    const scrollToItem = (index: number, instant = false) => {
      const item = items[index];
      if (!item) return;
      const target = item.offsetLeft - carousel.offsetLeft;
      isProgrammaticScroll = true;
      clearTimeout(scrollTimeout);
      if (instant) {
        carousel.style.scrollBehavior = 'auto';
        carousel.scrollLeft = target;
        scrollTimeout = setTimeout(() => {
          carousel.style.scrollBehavior = '';
          isProgrammaticScroll = false;
        }, 50);
      } else {
        carousel.style.scrollBehavior = 'smooth';
        carousel.scrollLeft = target;
        scrollTimeout = setTimeout(() => {
          carousel.style.scrollBehavior = '';
          isProgrammaticScroll = false;
          if (!isDown) resetIfNeeded();
        }, 700);
      }
    };

    const resetIfNeeded = () => {
      if (currentIndex < Math.floor(originalCount / 2) || currentIndex >= originalCount * 2 + Math.ceil(originalCount / 2)) {
        const relativeIndex = ((currentIndex % originalCount) + originalCount) % originalCount;
        currentIndex = originalCount + relativeIndex;
        scrollToItem(currentIndex, true);
      }
    };

    const updateCurrentIndex = () => {
      const scrollLeft = carousel.scrollLeft + carousel.offsetLeft;
      let closestIndex = 0;
      let minDist = Infinity;
      items.forEach((item, idx) => {
        const dist = Math.abs(item.offsetLeft - carousel.offsetLeft - carousel.scrollLeft);
        if (dist < minDist) {
          minDist = dist;
          closestIndex = idx;
        }
      });
      currentIndex = closestIndex;
    };

    const slideToNext = (force = false) => {
      if (isUserInteracting && !force) return;
      currentIndex++;
      scrollToItem(currentIndex, false);
    };

    const slideToPrev = (force = false) => {
      if (isUserInteracting && !force) return;
      currentIndex--;
      scrollToItem(currentIndex, false);
    };

    const startAutoScroll = () => {
      stopAutoScroll();
      const delay = window.innerWidth < 768 ? 4000 : 3000;
      autoScrollInterval = setInterval(slideToNext, delay);
    };

    const stopAutoScroll = () => {
      if (autoScrollInterval) clearInterval(autoScrollInterval);
    };

    let hoverScrollTimeout: any;
    let hoverScrollInterval: any;

    const startHoverScroll = (direction: 'next' | 'prev') => {
      stopHoverScroll();
      hoverScrollTimeout = setTimeout(() => {
        const slideAction = direction === 'next' ? slideToNext : slideToPrev;
        slideAction(true);
        hoverScrollInterval = setInterval(() => {
          slideAction(true);
        }, 2000);
      }, 5000);
    };

    const stopHoverScroll = () => {
      clearTimeout(hoverScrollTimeout);
      if (hoverScrollInterval) clearInterval(hoverScrollInterval);
    };

    scrollToItem(currentIndex, true);

    let scrollEndTimeout: any;
    carousel.addEventListener('scroll', () => {
      if (isProgrammaticScroll) return;
      clearTimeout(scrollEndTimeout);
      scrollEndTimeout = setTimeout(() => {
        updateCurrentIndex();
        if (!isDown) {
          resetIfNeeded();
        }
      }, 200);
    }, { passive: true });

    const onInteractionStart = () => {
      isUserInteracting = true;
      stopAutoScroll();
      clearTimeout(interactionTimeout);
    };

    const onInteractionEnd = () => {
      clearTimeout(interactionTimeout);
      interactionTimeout = setTimeout(() => {
        isUserInteracting = false;
        startAutoScroll();
      }, 2000);
    };

    carousel.addEventListener('mouseenter', onInteractionStart);
    carousel.addEventListener('mouseleave', onInteractionEnd);
    carousel.addEventListener('touchstart', () => {
      onInteractionStart();
      carousel.classList.remove('scroll-smooth');
      carousel.style.scrollBehavior = 'auto';
    }, { passive: true });
    carousel.addEventListener('touchend', () => {
      onInteractionEnd();
      carousel.classList.add('scroll-smooth');
      carousel.style.scrollBehavior = 'smooth';
      setTimeout(() => {
         updateCurrentIndex();
         if (!isDown) resetIfNeeded();
      }, 500);
    }, { passive: true });

    let isDown = false;
    let startX: number;
    let scrollLeftState: number;

    carousel.addEventListener('mousedown', (e) => {
      isDown = true;
      carousel.style.cursor = 'grabbing';
      
      // Ensure smooth behavior is completely disabled for raw drag speed
      carousel.classList.remove('scroll-smooth');
      carousel.style.scrollBehavior = 'auto'; 
      
      startX = e.pageX - carousel.offsetLeft;
      scrollLeftState = carousel.scrollLeft;
      onInteractionStart();
    });
    
    window.addEventListener('mouseup', () => {
      if (!isDown) return;
      isDown = false;
      carousel.style.cursor = 'grab';
      
      // Re-enable smooth behavior so it organically snaps to the nearest card
      carousel.classList.add('scroll-smooth');
      carousel.style.scrollBehavior = 'smooth';
      
      onInteractionEnd();
      
      // After letting go, give the CSS time to snap, then fix boundaries if needed
      setTimeout(() => {
        updateCurrentIndex();
        if (!isDown) resetIfNeeded();
      }, 500);
    });
    
    carousel.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - carousel.offsetLeft;
      const walk = (x - startX) * 1.5;
      carousel.scrollLeft = scrollLeftState - walk;
    });

    const prevBtn = document.getElementById('shecare-prev-btn');
    const nextBtn = document.getElementById('shecare-next-btn');
    
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        onInteractionStart();
        stopHoverScroll();
        slideToPrev(true);
        onInteractionEnd();
      });
      prevBtn.addEventListener('mouseenter', () => {
        onInteractionStart();
        startHoverScroll('prev');
      });
      prevBtn.addEventListener('mouseleave', () => {
        stopHoverScroll();
        onInteractionEnd();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        onInteractionStart();
        stopHoverScroll();
        slideToNext(true);
        onInteractionEnd();
      });
      nextBtn.addEventListener('mouseenter', () => {
        onInteractionStart();
        startHoverScroll('next');
      });
      nextBtn.addEventListener('mouseleave', () => {
        stopHoverScroll();
        onInteractionEnd();
      });
    }

    startAutoScroll();
  }

  initSheCareCarousel();
  document.addEventListener('astro:page-load', initSheCareCarousel);
</script>
