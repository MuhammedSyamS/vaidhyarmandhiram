---
import { Heart, Flower2, Sparkles, Leaf, Apple, Smile, ArrowRight, CalendarHeart, PhoneCall, Baby, PersonStanding, UserPlus } from 'lucide-react';
---

<div class="relative bg-[#F9F6F0] py-24 overflow-hidden border-y border-[#2D4A3E]/10 font-sans">
  <!-- Subtle Background Accents -->
  <div class="absolute inset-0 opacity-[0.02] mix-blend-multiply pointer-events-none bg-parchment-texture bg-repeat z-0"></div>
  <div class="absolute -top-40 -right-40 w-96 h-96 bg-[#E8F0EA] rounded-full blur-[120px] pointer-events-none z-0"></div>
  <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-[#E8F0EA] rounded-full blur-[120px] pointer-events-none z-0"></div>

  <div class="container mx-auto px-4 max-w-7xl relative z-10">
    
    <!-- 1. Hero Section -->
    <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll opacity-0 translate-y-6 transition-all duration-1000 ease-out">
      <div class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-full bg-[#2D4A3E]/5 border border-[#2D4A3E]/10 mb-6">
        <Heart class="text-[#2D4A3E] w-4 h-4" />
        <span class="text-[#2D4A3E] text-xs uppercase tracking-[0.2em] font-bold">Complete Women's Wellness Program</span>
      </div>
      
      <h2 class="text-4xl md:text-5xl lg:text-6xl text-[#2D4A3E] font-serif mb-6 leading-tight">
        She Care Package
      </h2>
      
      <p class="text-[#2D4A3E]/80 text-lg md:text-xl leading-relaxed max-w-2xl mx-auto">
        A holistic wellness package designed to support women through every stage of life including menarche, pregnancy, postnatal recovery, and menopause care using Ayurveda, Siddha, Yoga, and natural therapies.
      </p>
    </div>

    <!-- 2. Minimal Icon-Based Care Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 mb-24">
      {
        [
          {
            title: "Menarche Care",
            desc: "Guiding young women through their first transition with natural hormonal balance.",
            delay: "0",
            icon: Sparkles,
            color: "bg-[#f5f8f6]"
          },
          {
            title: "Prenatal Care",
            desc: "Nurturing mother and baby with specialized Ayurvedic diets and gentle therapies.",
            delay: "150",
            icon: Heart,
            color: "bg-[#fcf8f6]"
          },
          {
            title: "Postnatal Care",
            desc: "Aiding recovery with traditional strengthening treatments and restorative care.",
            delay: "300",
            icon: Baby,
            color: "bg-[#f6f8fa]"
          },
          {
            title: "Menopause Care",
            desc: "Easing the transition with cooling therapies and natural emotional balance.",
            delay: "450",
            icon: PersonStanding,
            color: "bg-[#fdf6f9]"
          }
        ].map(card => {
          const Icon = card.icon;
          return (
            <div 
              class={`group relative rounded-[2rem] p-8 overflow-hidden shadow-[0_8px_30px_rgb(0,0,0,0.03)] hover:shadow-[0_20px_40px_rgb(45,74,62,0.08)] transition-all duration-500 hover:-translate-y-2 animate-on-scroll opacity-0 translate-y-8 ${card.color} border border-white flex flex-col`}
              style={`transition-delay: ${card.delay}ms`}
            >
              <!-- Decorative Circle -->
              <div class="absolute -top-10 -right-10 w-32 h-32 bg-white rounded-full opacity-50 group-hover:scale-150 transition-transform duration-700 ease-out z-0"></div>
              
              <div class="relative z-10 flex flex-col h-full">
                <div class="w-14 h-14 rounded-2xl bg-white shadow-sm flex items-center justify-center mb-6 text-[#2D4A3E] group-hover:scale-110 group-hover:bg-[#2D4A3E] group-hover:text-white transition-all duration-500">
                  <Icon class="w-7 h-7" strokeWidth={1.5} />
                </div>
                
                <h3 class="text-2xl text-[#2D4A3E] font-serif font-bold mb-3">{card.title}</h3>
                
                <p class="text-[#2D4A3E]/75 text-sm leading-relaxed mb-6 flex-grow">{card.desc}</p>
                
                <div class="flex items-center text-xs font-bold uppercase tracking-wider text-[#2D4A3E] group-hover:text-accent-gold transition-colors mt-auto">
                  Explore Therapy
                  <ArrowRight class="w-4 h-4 ml-2 transform group-hover:translate-x-2 transition-transform duration-300" />
                </div>
              </div>
            </div>
          )
        })
      }
    </div>

    <!-- 3. Benefits Section -->
    <div class="mb-24 animate-on-scroll opacity-0 translate-y-8">
      <div class="text-center mb-12">
        <h3 class="text-3xl md:text-4xl text-[#2D4A3E] font-serif mb-4">Holistic Care Pillars</h3>
        <div class="w-16 h-1 bg-[#2D4A3E]/20 mx-auto rounded-full"></div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          [
            { icon: Leaf, title: "Authentic Treatments", text: "Traditional Ayurvedic & Siddha Treatments" },
            { icon: Apple, title: "Nutrition", text: "Personalized Diet & Lifestyle Guidance" },
            { icon: Flower2, title: "Wellness", text: "Yoga & Wellness Support" },
            { icon: Sparkles, title: "Natural Care", text: "Natural Therapies for Women’s Health" },
            { icon: Smile, title: "Mental Health", text: "Postpartum Emotional Wellness Support" }
          ].map(benefit => {
            const Icon = benefit.icon;
            return (
              <div class="bg-white/60 backdrop-blur-md rounded-2xl p-6 flex items-start gap-5 border border-white hover:border-[#2D4A3E]/20 hover:shadow-lg transition-all duration-300 group">
                <div class="w-12 h-12 rounded-xl bg-[#E8F0EA] text-[#2D4A3E] flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform duration-300">
                  <Icon strokeWidth={1.5} size={24} />
                </div>
                <div>
                  <h4 class="text-[#2D4A3E] font-bold font-serif text-lg mb-1">{benefit.title}</h4>
                  <p class="text-[#2D4A3E]/70 text-sm leading-snug">{benefit.text}</p>
                </div>
              </div>
            )
          })
        }
      </div>
    </div>

    <!-- 4. CTA Section -->
    <div class="bg-[#2D4A3E] rounded-[2.5rem] p-10 md:p-16 text-center relative overflow-hidden shadow-2xl shadow-[#2D4A3E]/20 animate-on-scroll opacity-0 translate-y-8">
      <!-- Deco elements -->
      <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full blur-[50px] mix-blend-overlay"></div>
      <div class="absolute bottom-0 left-0 w-64 h-64 bg-[#E8F0EA]/10 rounded-full blur-[50px] mix-blend-overlay"></div>
      
      <div class="relative z-10 max-w-2xl mx-auto">
        <h4 class="text-3xl md:text-5xl text-white font-serif mb-6 leading-tight">Book Your Consultation Today</h4>
        <p class="text-white/80 text-lg mb-10">
          Take the first step towards holistic feminine health and balance. Our female specialists are here to guide you.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
          <a href="/appointment" class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 bg-[#E8F0EA] text-[#2D4A3E] rounded-full font-bold uppercase tracking-wider text-sm hover:bg-white hover:-translate-y-1 transition-all duration-300 shadow-lg">
            <CalendarHeart class="w-5 h-5 mr-2" />
            Book Appointment
          </a>
          
          <a href="tel:+918593821553" class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 bg-transparent border-2 border-white/30 text-white rounded-full font-bold uppercase tracking-wider text-sm hover:border-white hover:bg-white/10 hover:-translate-y-1 transition-all duration-300">
            <PhoneCall class="w-5 h-5 mr-2" />
            Call Now
          </a>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  /* Fix for smooth height transition on hover */
  .grid-rows-\[0fr\] {
    grid-template-rows: 0fr;
  }
  .grid-rows-\[1fr\] {
    grid-template-rows: 1fr;
  }
</style>

<script>
  function initSheCareAnimations() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.remove('opacity-0', 'translate-y-6', 'translate-y-8');
          entry.target.classList.add('opacity-100', 'translate-y-0');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.animate-on-scroll').forEach(el => {
      observer.observe(el);
    });
  }

  initSheCareAnimations();
  document.addEventListener('astro:page-load', initSheCareAnimations);
</script>
