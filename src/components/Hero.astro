---
import { ArrowRight, ChevronLeft, ChevronRight, Sparkles, Quote } from 'lucide-react';
---

<section class="relative bg-background-parchment overflow-hidden border-b border-accent-gold/20 py-16 lg:py-24 flex flex-col justify-center min-h-[700px] lg:min-h-screen lg:h-screen w-full">
  <!-- Decorative background elements -->
  <div class="absolute inset-0 opacity-[0.04] mix-blend-multiply pointer-events-none bg-parchment-texture bg-repeat"></div>
  <div class="absolute -top-40 -left-40 w-96 h-96 bg-accent-gold/5 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-primary/5 rounded-full blur-[120px] pointer-events-none"></div>

  <!-- Slow-Rotating Gold Mandala Watermark in Background -->
  <div class="absolute top-1/2 right-10 -translate-y-1/2 w-[550px] h-[550px] opacity-[0.035] text-accent-gold pointer-events-none select-none animate-spin-slow z-0 hidden lg:block">
    <svg viewBox="0 0 100 100" fill="currentColor" class="w-full h-full">
      <path d="M50 0C48.8 0 47.9 1 47.9 2.1C47.9 6.2 46 10.1 42.9 12.9C39.8 15.7 35.8 17.1 31.7 16.9C30.5 16.9 29.5 17.8 29.5 19C29.5 20.2 30.5 21.1 31.7 21.1C35.8 20.9 39.8 22.3 42.9 25.1C46 27.9 47.9 31.8 47.9 35.9C47.9 37 48.9 38 50 38C51.1 38 52.1 37 52.1 35.9C52.1 31.8 54 27.9 57.1 25.1C60.2 22.3 64.2 20.9 68.3 21.1C69.5 21.1 70.5 20.2 70.5 19C70.5 17.8 69.5 16.9 68.3 16.9C64.2 17.1 60.2 15.7 57.1 12.9C54 10.1 52.1 6.2 52.1 2.1C52.1 1 51.2 0 50 0Z"/>
      <path d="M50 42C45.6 42 42 45.6 42 50C42 54.4 45.6 58 50 58C54.4 58 58 54.4 58 50C58 45.6 54.4 42 50 42ZM50 55C47.2 55 45 52.8 45 50C45 47.2 47.2 45 50 45C52.8 45 55 47.2 55 50C55 52.8 52.8 55 50 55Z"/>
      <path d="M19 29.5C17.8 29.5 16.9 30.5 16.9 31.7C17.1 35.8 15.7 39.8 12.9 42.9C10.1 46 6.2 47.9 2.1 47.9C1 47.9 0 48.8 0 50C0 51.2 1 52.1 2.1 52.1C6.2 52.1 10.1 54 12.9 57.1C15.7 60.2 17.1 64.2 16.9 68.3C16.9 69.5 17.8 70.5 19 70.5C20.2 70.5 21.1 69.5 21.1 68.3C20.9 64.2 22.3 60.2 25.1 57.1C27.9 54 31.8 52.1 35.9 52.1C37 52.1 38 51.1 38 50C38 48.9 37 47.9 35.9 47.9C31.8 47.9 27.9 46 25.1 42.9C22.3 39.8 20.9 35.8 21.1 31.7C21.1 30.5 20.2 29.5 19 29.5Z"/>
      <path d="M81 29.5C79.8 29.5 78.9 30.5 78.9 31.7C79.1 35.8 77.7 39.8 74.9 42.9C72.1 46 68.2 47.9 64.1 47.9C63 47.9 62 48.8 62 50C62 51.2 63 52.1 64.1 52.1C68.2 52.1 72.1 54 74.9 57.1C77.7 60.2 79.1 64.2 78.9 68.3C78.9 69.5 79.8 70.5 81 70.5C82.2 70.5 83.1 69.5 83.1 68.3C82.9 64.2 84.3 60.2 87.1 57.1C89.9 54 93.8 52.1 97.9 52.1C99 52.1 100 51.2 100 50C100 48.8 99 47.9 97.9 47.9C93.8 47.9 89.9 46 87.1 42.9C84.3 39.8 82.9 35.8 83.1 31.7C83.1 30.5 82.2 29.5 81 29.5Z"/>
      <path d="M50 62C48.9 62 47.9 63 47.9 64.1C47.9 68.2 46 72.1 42.9 74.9C39.8 77.7 35.8 79.1 31.7 78.9C30.5 78.9 29.5 79.8 29.5 81C29.5 82.2 30.5 83.1 31.7 83.1C35.8 82.9 39.8 84.3 42.9 87.1C46 89.9 47.9 93.8 47.9 97.9C47.9 99 48.9 100 50 100C51.1 100 52.1 99 52.1 97.9C52.1 93.8 54 89.9 57.1 87.1C60.2 84.3 64.2 82.9 68.3 83.1C69.5 83.1 70.5 82.2 70.5 81C70.5 79.8 69.5 78.9 68.3 78.9C64.2 79.1 60.2 77.7 57.1 74.9C54 72.1 52.1 68.2 52.1 64.1C52.1 63 51.1 62 50 62Z"/>
    </svg>
  </div>

  <div class="container mx-auto px-4 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-6 items-center">
      
      <!-- Column 1: Institutional Heritage (Left - 5/12 width) -->
      <div class="lg:col-span-5 flex flex-col justify-center space-y-6 text-left relative z-10">
        <div>
          <!-- Double-Ring Gold Badge (Heritage Emblem) with Rotating Text -->
          <div class="flex items-center gap-4 mb-6 animate-fade-in-up group cursor-default">
            <div class="relative flex items-center justify-center w-20 h-20 shrink-0">
              <!-- Slowly rotating outer text ring -->
              <svg viewBox="0 0 100 100" class="absolute w-20 h-20 animate-spin-slow pointer-events-none select-none opacity-80">
                <path id="crestPath" d="M 50, 50 m -37, 0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0" fill="none" />
                <text class="font-sans font-extrabold uppercase fill-accent-gold text-[7.2px] tracking-[0.18em]">
                  <textPath href="#crestPath" startOffset="0%">• VAIDYARMANDIRAM • SINCE 1983</textPath>
                </text>
              </svg>
              
              <!-- Static inner golden crest -->
              <div class="w-13 h-13 rounded-full border border-accent-gold/45 bg-background-cream/60 flex flex-col items-center justify-center shadow-inner group-hover:scale-[1.03] transition-transform duration-500 relative">
                <div class="absolute inset-[2.5px] rounded-full border border-dashed border-accent-gold/30"></div>
                <span class="text-[7.5px] font-sans tracking-widest text-accent-gold font-bold uppercase leading-none z-10">Estd</span>
                <span class="text-xs font-serif font-bold text-primary-dark mt-0.5 leading-none z-10">1983</span>
              </div>
            </div>
            
            <div class="flex flex-col justify-center">
              <span class="lang-en text-[11px] font-sans tracking-[0.22em] text-accent-gold uppercase font-bold">Kerala Traditional Ayurveda</span>
              <span class="lang-ml font-malayalam text-xs text-accent-gold font-semibold leading-none mb-0.5">കേരള പരമ്പരാഗത ആയുർവേദം</span>
              <span class="text-[10px] text-text-muted mt-0.5 font-sans tracking-wider uppercase">Legacy of Holistic Healing</span>
            </div>
          </div>

          <!-- Heading -->
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-serif text-primary-dark leading-tight mb-2 animate-fade-in-up">
            <span class="lang-en">A Legacy of <br/><span class="text-accent-gold italic">Pure Healing</span></span>
            <span class="lang-ml font-malayalam block text-3xl sm:text-4xl md:text-5xl leading-tight font-bold">ശുദ്ധമായ <br/><span class="text-accent-gold">ചികിത്സാ പാരമ്പര്യം</span></span>
          </h1>

          <!-- Copy -->
          <p class="lang-en text-sm sm:text-base text-text/90 font-sans leading-relaxed max-w-xl animate-fade-in-up delay-100 mt-4">
            Rooted in the ancient wisdom of Kerala, Vaidyarmandiram Hospital offers personalized care that heals from within, preserving the rich lineage of our beloved founder Dr. P. Abdul Sathar Gurukkal.
          </p>
          <p class="lang-ml font-malayalam text-sm sm:text-base text-text/90 leading-relaxed max-w-xl animate-fade-in-up delay-100 mt-4">
            കേരളീയ ആയുർവേദത്തിന്റെ തനിമയാർന്ന പാരമ്പര്യത്തിൽ ഊന്നി, ഞങ്ങളുടെ പ്രിയ സ്ഥാപകൻ ഡോ. പി. അബ്ദുൽ സത്താർ ഗുരുക്കളുടെ ആപ്തവാക്യങ്ങളെ നെഞ്ചേറ്റി, ശരീരവും മനസ്സും സുഖപ്പെടുത്തുന്ന ആധികാരിക ചികിത്സകൾ ഞങ്ങൾ നൽകുന്നു.
          </p>

          <!-- Mini Stats Line with Gold Borders -->
          <div class="grid grid-cols-3 gap-2 border-y border-accent-gold/15 py-3.5 my-6 animate-fade-in-up delay-150 max-w-xl">
            <div class="text-center md:text-left">
              <p class="text-xl md:text-2xl font-serif font-bold text-primary-dark leading-none">40+</p>
              <p class="lang-en text-[9px] uppercase tracking-wider text-text-muted mt-1.5 font-sans">Years Legacy</p>
              <p class="lang-ml font-malayalam text-[9px] text-text-muted mt-1.5 leading-none">വർഷത്തെ പാരമ്പര്യം</p>
            </div>
            <div class="text-center md:text-left border-x border-accent-gold/15 px-2 sm:px-4">
              <p class="text-xl md:text-2xl font-serif font-bold text-primary-dark leading-none">3</p>
              <p class="lang-en text-[9px] uppercase tracking-wider text-text-muted mt-1.5 font-sans">Hospitals</p>
              <p class="lang-ml font-malayalam text-[9px] text-text-muted mt-1.5 leading-none">ആശുപത്രികൾ</p>
            </div>
            <div class="text-center md:text-left">
              <p class="text-xl md:text-2xl font-serif font-bold text-primary-dark leading-none">25K+</p>
              <p class="lang-en text-[9px] uppercase tracking-wider text-text-muted mt-1.5 font-sans">Cured Patients</p>
              <p class="lang-ml font-malayalam text-[9px] text-text-muted mt-1.5 leading-none">സുഖം പ്രാപിച്ചവർ</p>
            </div>
          </div>
        </div>

        <!-- Buttons with Shimmer & Expand Effects -->
        <div class="flex flex-col sm:flex-row gap-3.5 pt-2 animate-fade-in-up delay-200">
          <a href="/appointment" class="btn-shimmer bg-primary hover:bg-primary-dark text-white flex items-center justify-center gap-2 group shadow-md hover:shadow-lg rounded-lg px-8 py-4 text-base font-serif font-bold transition-all duration-300">
            <span class="lang-en">Book Consultation</span>
            <span class="lang-ml font-malayalam normal-case tracking-normal">കൺസൾട്ടേഷൻ ബുക്ക് ചെയ്യൂ</span>
            <ArrowRight size={18} class="transition-transform group-hover:translate-x-1 shrink-0" />
          </a>
          <a href="/treatments" class="btn-expand-border border-2 border-accent-gold/60 text-accent-gold hover:text-white flex items-center justify-center rounded-lg px-8 py-4 text-base font-serif font-bold transition-all duration-300">
            <span class="lang-en">Explore Treatments</span>
            <span class="lang-ml font-malayalam normal-case tracking-normal">ചികിത്സകൾ കാണുക</span>
          </a>
        </div>
      </div>

      <!-- Column 2: Dual-Arched Heritage Showcase (Right - 7/12 width) -->
      <div class="lg:col-span-7 flex flex-row items-center justify-center gap-4 sm:gap-6 relative mt-12 lg:mt-0 px-2 sm:px-0">
        
        <!-- Left Arch: The Founder (Legacy Pillar) -->
        <div class="w-[48%] max-w-[245px] aspect-[9/15] rounded-t-full rounded-b-2xl border-2 border-primary/20 p-1.5 shadow-[0_15px_30px_rgba(0,0,0,0.12)] bg-white/70 backdrop-blur-sm relative group/founder animate-fade-in-up delay-100 flex flex-col overflow-hidden">
          <!-- Inner container -->
          <div class="relative w-full h-full rounded-t-full rounded-b-[10px] overflow-hidden bg-background-cream/40 flex-grow">
            <img 
              src="/images/vmfounder.jpg" 
              alt="Dr. P. Abdul Sathar Gurukkal" 
              class="w-full h-full object-cover object-top transition-transform duration-[6000ms] ease-out scale-100 group-hover/founder:scale-105" 
            />
            <!-- Dark Vignette Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/35 to-transparent"></div>
            
            <!-- Embedded Quote & Details -->
            <div class="absolute bottom-3 left-3 right-3 text-left">
              <span class="lang-en text-[7.5px] uppercase tracking-[0.2em] text-accent-gold font-sans font-bold block mb-0.5">Our Eternal Guide</span>
              <span class="lang-ml font-malayalam text-[8px] text-accent-gold font-bold block mb-0.5">ഞങ്ങളുടെ വഴികാട്ടി</span>
              
              <!-- Quote snippet -->
              <div class="border-t border-white/10 mt-1 pt-1.5 mb-1.5">
                <Quote size={10} class="text-accent-gold/40 mb-1" />
                <p class="lang-en text-[9.5px] italic text-white/90 font-serif leading-snug">"True cure restores the balance of life."</p>
                <p class="lang-ml font-malayalam text-[9px] italic text-white/90 leading-snug">"യഥാർത്ഥ ചികിത്സ ജീവിത സമതുലിതാവസ്ഥ വീണ്ടെടുക്കലാണ്."</p>
              </div>
            </div>
          </div>

          <!-- Permanent Gold Nameplate at the Arch Bottom -->
          <div class="w-full bg-primary-dark/95 border-t border-accent-gold/20 py-2.5 px-2 text-center rounded-b-[10px]">
            <h3 class="lang-en text-[11px] sm:text-xs font-serif text-white font-bold tracking-wide">Dr. P. Abdul Sathar Gurukkal</h3>
            <h3 class="lang-ml font-malayalam text-[10px] sm:text-[11px] text-white font-bold leading-tight">ഡോ. പി. അബ്ദുൽ സത്താർ ഗുരുക്കൾ</h3>
            <p class="lang-en text-[8px] uppercase tracking-wider text-accent-gold/80 mt-0.5 font-sans">Founder & Chief Physician</p>
            <p class="lang-ml font-malayalam text-[8px] text-accent-gold/80 mt-0.5 leading-none">സ്ഥാപകൻ & ചീഫ് ഫിസിഷ്യൻ</p>
          </div>
        </div>

        <!-- Right Arch: Sanctuary Slider (Facilities Showcase) - Offset Downwards & Overlapping slightly -->
        <div class="w-[48%] max-w-[245px] aspect-[9/15] rounded-t-full rounded-b-2xl border-2 border-accent-gold/25 p-1.5 shadow-[0_20px_40px_rgba(0,0,0,0.15)] bg-white/70 backdrop-blur-sm relative group/slider animate-fade-in-up delay-200 flex flex-col overflow-hidden translate-y-8 sm:translate-y-12">
          
          <!-- Inner Slides Container -->
          <div id="sanctuary-slider" class="relative w-full h-full rounded-t-full rounded-b-[10px] overflow-hidden bg-background-cream/40 flex-grow">
            
            <!-- Slide 1: Treatment Room -->
            <div class="absolute inset-0 opacity-100 transition-opacity duration-1000 ease-in-out sanctuary-slide z-10 overflow-hidden">
              <img src="/images/treatment-room-1.jpg" alt="Treatment Room" class="w-full h-full object-cover sanctuary-slide-img" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/20 to-transparent"></div>
              <div class="absolute bottom-4 left-3.5 right-3.5 text-left z-20">
                <span class="lang-en text-[8px] uppercase tracking-[0.2em] text-accent-gold font-sans font-bold block mb-0.5">Facility</span>
                <span class="lang-ml font-malayalam text-[8px] text-accent-gold font-bold block mb-0.5">സൗകര്യം</span>
                <h4 class="lang-en text-xs sm:text-sm font-serif text-white font-bold leading-tight">Authentic Treatment Rooms</h4>
                <h4 class="lang-ml font-malayalam text-[11px] sm:text-xs text-white font-bold leading-tight">ചികിത്സാ മുറികൾ</h4>
              </div>
            </div>
            
            <!-- Slide 2: Herbal Garden -->
            <div class="absolute inset-0 opacity-0 transition-opacity duration-1000 ease-in-out sanctuary-slide z-0 overflow-hidden">
              <img src="/images/herbal-garden-1.jpg" alt="Herbal Garden" class="w-full h-full object-cover sanctuary-slide-img" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/20 to-transparent"></div>
              <div class="absolute bottom-4 left-3.5 right-3.5 text-left z-20">
                <span class="lang-en text-[8px] uppercase tracking-[0.2em] text-accent-gold font-sans font-bold block mb-0.5">Natural Herbs</span>
                <span class="lang-ml font-malayalam text-[8px] text-accent-gold font-bold block mb-0.5">ഔഷധങ്ങൾ</span>
                <h4 class="lang-en text-xs sm:text-sm font-serif text-white font-bold leading-tight">Organic In-House Garden</h4>
                <h4 class="lang-ml font-malayalam text-[11px] sm:text-xs text-white font-bold leading-tight">ഔഷധ സസ്യത്തോട്ടം</h4>
              </div>
            </div>
            
            <!-- Slide 3: Spine & Joint -->
            <div class="absolute inset-0 opacity-0 transition-opacity duration-1000 ease-in-out sanctuary-slide z-0 overflow-hidden">
              <img src="/images/spine-joint.jpg" alt="Traditional Therapies" class="w-full h-full object-cover sanctuary-slide-img" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/20 to-transparent"></div>
              <div class="absolute bottom-4 left-3.5 right-3.5 text-left z-20">
                <span class="lang-en text-[8px] uppercase tracking-[0.2em] text-accent-gold font-sans font-bold block mb-0.5">Expertise</span>
                <span class="lang-ml font-malayalam text-[8px] text-accent-gold font-bold block mb-0.5">വൈദഗ്ദ്ധ്യം</span>
                <h4 class="lang-en text-xs sm:text-sm font-serif text-white font-bold leading-tight">Traditional Spine & Joint Care</h4>
                <h4 class="lang-ml font-malayalam text-[11px] sm:text-xs text-white font-bold leading-tight">നട്ടെല്ല്, സന്ധി രോഗ ചികിത്സ</h4>
              </div>
            </div>
            
            <!-- Slide 4: Yoga -->
            <div class="absolute inset-0 opacity-0 transition-opacity duration-1000 ease-in-out sanctuary-slide z-0 overflow-hidden">
              <img src="/images/yoga-meditation.jpg" alt="Yoga & Meditation" class="w-full h-full object-cover sanctuary-slide-img" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/20 to-transparent"></div>
              <div class="absolute bottom-4 left-3.5 right-3.5 text-left z-20">
                <span class="lang-en text-[8px] uppercase tracking-[0.2em] text-accent-gold font-sans font-bold block mb-0.5">Wellness</span>
                <span class="lang-ml font-malayalam text-[8px] text-accent-gold font-bold block mb-0.5">വെൽനസ്സ്</span>
                <h4 class="lang-en text-xs sm:text-sm font-serif text-white font-bold leading-tight">Yoga & Meditation Guidance</h4>
                <h4 class="lang-ml font-malayalam text-[11px] sm:text-xs text-white font-bold leading-tight">ശാസ്ത്രീയ യോഗാ പരിശീലനങ്ങൾ</h4>
              </div>
            </div>

          </div>

          <!-- Manual Arrow Controls (Hover Activated on Arch) -->
          <button id="prev-sanctuary" class="absolute left-3 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full border border-white/20 bg-black/40 hover:bg-black/70 text-white flex items-center justify-center z-30 opacity-0 group-hover/slider:opacity-100 transition-opacity duration-300 shadow-md" aria-label="Previous Slide">
            <ChevronLeft size={16} />
          </button>
          <button id="next-sanctuary" class="absolute right-3 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full border border-white/20 bg-black/40 hover:bg-black/70 text-white flex items-center justify-center z-30 opacity-0 group-hover/slider:opacity-100 transition-opacity duration-300 shadow-md" aria-label="Next Slide">
            <ChevronRight size={16} />
          </button>
          
          <!-- Slide Navigation Indicators -->
          <div class="absolute top-3 right-3 flex gap-1 z-20 bg-black/30 backdrop-blur-sm px-1.5 py-1 rounded-full border border-white/10">
            <button class="w-1.5 h-1.5 rounded-full bg-white transition-all duration-300 sanctuary-dot active-dot" aria-label="Slide 1"></button>
            <button class="w-1.5 h-1.5 rounded-full bg-white/40 hover:bg-white transition-all duration-300 sanctuary-dot" aria-label="Slide 2"></button>
            <button class="w-1.5 h-1.5 rounded-full bg-white/40 hover:bg-white transition-all duration-300 sanctuary-dot" aria-label="Slide 3"></button>
            <button class="w-1.5 h-1.5 rounded-full bg-white/40 hover:bg-white transition-all duration-300 sanctuary-dot" aria-label="Slide 4"></button>
          </div>
        </div>

      </div>
      
    </div>
  </div>
</section>

<script>
  function initSanctuarySlider() {
    const slides = document.querySelectorAll('.sanctuary-slide');
    const dots = document.querySelectorAll('.sanctuary-dot');
    const prevBtn = document.getElementById('prev-sanctuary');
    const nextBtn = document.getElementById('next-sanctuary');
    if (slides.length === 0) return;

    let currentSlide = 0;
    let timer: ReturnType<typeof setInterval>;

    function showSlide(index: number) {
      slides.forEach((slide, i) => {
        if (i === index) {
          slide.classList.remove('opacity-0', 'z-0');
          slide.classList.add('opacity-100', 'z-10');
        } else {
          slide.classList.remove('opacity-100', 'z-10');
          slide.classList.add('opacity-0', 'z-0');
        }
      });

      dots.forEach((dot, i) => {
        if (i === index) {
          dot.classList.add('active-dot', 'bg-white');
          dot.classList.remove('bg-white/40');
        } else {
          dot.classList.remove('active-dot', 'bg-white');
          dot.classList.add('bg-white/40');
        }
      });

      currentSlide = index;
    }

    function nextSlide() {
      let next = currentSlide + 1;
      if (next >= slides.length) next = 0;
      showSlide(next);
    }

    function prevSlide() {
      let prev = currentSlide - 1;
      if (prev < 0) prev = slides.length - 1;
      showSlide(prev);
    }

    function startTimer() {
      stopTimer();
      timer = setInterval(nextSlide, 5000); // 5 seconds interval
    }

    function stopTimer() {
      if (timer) clearInterval(timer);
    }

    // Attach click events to dots
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        showSlide(i);
        startTimer();
      });
    });

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        prevSlide();
        startTimer();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        nextSlide();
        startTimer();
      });
    }

    // Start
    startTimer();
  }

  // Initialize
  initSanctuarySlider();

  // Re-run safely on Astro page transitions
  document.addEventListener('astro:page-load', initSanctuarySlider);
</script>

