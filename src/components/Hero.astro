---
import { ArrowRight } from 'lucide-react';
---

<section class="relative min-h-[600px] md:h-screen md:min-h-[700px] flex items-center overflow-hidden py-20 md:py-0">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/images/hero-bg.jpg" 
      alt="Ayurvedic Treatment"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-primary-dark/75 backdrop-blur-[1px]"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-primary-dark via-transparent to-transparent opacity-60"></div>
  </div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="max-w-3xl">
      <h1 class="text-3xl sm:text-5xl md:text-7xl font-serif text-background-parchment leading-tight mb-6 animate-fade-in-up">
        Authentic Healing <br/>
        <span class="text-accent-gold italic">Rooted in Tradition</span>
      </h1>
      <p class="text-base md:text-xl text-background-parchment/80 font-sans mb-10 leading-relaxed max-w-xl animate-fade-in-up delay-200">
        Experience the profound wisdom of Kerala Ayurveda at Vaidyarmandiram. Guided by decades of heritage and the legacy of Dr. P. Abdul Sathar Gurukkal.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 animate-fade-in-up delay-400">
        <a href="/appointment" class="btn-primary flex items-center justify-center gap-2 group">
          Book a Consultation
          <ArrowRight size={20} class="transition-transform group-hover:translate-x-1" />
        </a>
        <a href="/treatments" class="btn-outline !text-background-parchment !border-background-parchment hover:!bg-background-parchment hover:!text-primary-dark flex items-center justify-center">
          Explore Treatments
        </a>
      </div>
    </div>
  </div>
</section>


<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
  }

  .delay-200 { animation-delay: 0.2s; }
  .delay-400 { animation-delay: 0.4s; }
</style>
