---
import { ArrowRight } from 'lucide-react';
---

<section class="relative bg-background-parchment overflow-hidden border-b border-accent-gold/20 py-16 lg:py-24 flex flex-col justify-center min-h-[600px]">
  <!-- Decorative background elements -->
  <div class="absolute inset-0 opacity-5 mix-blend-multiply pointer-events-none bg-parchment-texture bg-repeat"></div>
  <div class="absolute -top-40 -left-40 w-96 h-96 bg-accent-gold/5 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-primary/5 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="container mx-auto px-4 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Column 1: Institutional Heritage (Left - 5/12 width) -->
      <div class="lg:col-span-5 flex flex-col justify-center space-y-6 text-left">
        <!-- Heritage Emblem -->
        <div class="flex items-center gap-3 animate-fade-in-up">
          <div class="flex flex-col items-center justify-center w-14 h-14 rounded-full border-2 border-accent-gold/40 bg-background-cream/30 shrink-0 shadow-inner">
            <span class="text-[8px] font-sans tracking-widest text-accent-gold font-bold uppercase leading-none">Estd</span>
            <span class="text-xs font-serif font-bold text-primary-dark mt-0.5 leading-none">1983</span>
          </div>
          <div class="flex flex-col">
            <span class="lang-en text-xs font-sans tracking-[0.2em] text-accent-gold uppercase font-bold">Kerala Traditional Ayurveda</span>
            <span class="lang-ml font-malayalam text-xs text-accent-gold font-semibold leading-none">കേരള പരമ്പരാഗത ആയുർവേദം</span>
            <span class="text-[10px] text-text-muted mt-0.5 font-sans uppercase tracking-wider">Heritage & Legacy of Healing</span>
          </div>
        </div>

        <!-- Heading -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-serif text-primary-dark leading-tight mb-2 animate-fade-in-up">
          <span class="lang-en">Authentic Healing <br/><span class="text-accent-gold italic">Rooted in Tradition</span></span>
          <span class="lang-ml font-malayalam block text-3xl sm:text-4xl leading-tight font-bold">പരമ്പരാഗത ശൈലിയിൽ <br/><span class="text-accent-gold">ആധികാരിക ചികിത്സ</span></span>
        </h1>

        <!-- Copy -->
        <p class="lang-en text-base text-text/90 font-sans leading-relaxed max-w-xl animate-fade-in-up delay-100">
          Experience the profound wisdom of Kerala Ayurveda at Vaidyarmandiram Hospital. We provide authentic treatments focused on root-cause healing, preserving the rich legacy of our beloved founder Dr. P. Abdul Sathar Gurukkal.
        </p>
        <p class="lang-ml font-malayalam text-base text-text/90 leading-relaxed max-w-xl animate-fade-in-up delay-100">
          വൈദ്യർമന്ദിരം ആയുർവേദ ഹോസ്പിറ്റലിൽ കേരളീയ ആയുർവേദത്തിന്റെ ആധികാരികത അനുഭവിക്കുക. ഞങ്ങളുടെ സ്ഥാപകൻ ഡോ. പി. അബ്ദുൽ സത്താർ ഗുരുക്കളുടെ സമ്പന്നമായ പാരമ്പര്യം കാത്തുസൂക്ഷിച്ചുകൊണ്ട്, രോഗകാരണം കണ്ടെത്തിയുള്ള ചികിത്സകൾ ഞങ്ങൾ നൽകുന്നു.
        </p>

        <!-- Buttons -->
        <div class="flex flex-col sm:flex-row gap-3 pt-2 animate-fade-in-up delay-200">
          <a href="/appointment" class="btn-primary !bg-primary hover:!bg-primary-dark text-white flex items-center justify-center gap-2 group shadow-md hover:shadow-lg rounded-lg px-6 py-3 text-base">
            <span class="lang-en">Book Consultation</span>
            <span class="lang-ml font-malayalam normal-case tracking-normal">കൺസൾട്ടേഷൻ ബുക്ക് ചെയ്യൂ</span>
            <ArrowRight size={18} class="transition-transform group-hover:translate-x-1 shrink-0" />
          </a>
          <a href="/treatments" class="btn-outline !border-accent-gold !text-accent-gold hover:!bg-accent-gold hover:!text-white flex items-center justify-center rounded-lg px-6 py-3 text-base">
            <span class="lang-en">Explore Treatments</span>
            <span class="lang-ml font-malayalam normal-case tracking-normal">ചികിത്സകൾ കാണുക</span>
          </a>
        </div>
      </div>

      <!-- Column 2: Interactive Slideshow (Middle - 4/12 width) -->
      <div class="lg:col-span-4 flex flex-col justify-center">
        <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden border border-accent-gold/30 shadow-lg bg-background-cream/30 group/slider animate-fade-in-up delay-150">
          <!-- Slides Container -->
          <div id="hero-slider" class="relative w-full h-full">
            <!-- Slide 1 -->
            <div class="absolute inset-0 opacity-100 transition-opacity duration-1000 ease-in-out hero-slide z-10">
              <img src="/images/treatment-room-1.jpg" alt="Treatment Room" class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent"></div>
              <div class="absolute bottom-4 left-4 right-4 text-left">
                <span class="lang-en text-[10px] uppercase tracking-[0.2em] text-accent-gold font-sans font-bold">Our Infrastructure</span>
                <span class="lang-ml font-malayalam text-[10px] text-accent-gold font-bold block">ഞങ്ങളുടെ സൗകര്യങ്ങൾ</span>
                <h3 class="lang-en text-sm font-serif text-white font-bold leading-tight mt-0.5">Authentic & Clean Treatment Rooms</h3>
                <h3 class="lang-ml font-malayalam text-sm text-white font-bold leading-tight mt-0.5">വൃത്തിയുള്ള ആധികാരിക ചികിത്സാ മുറികൾ</h3>
              </div>
            </div>
            <!-- Slide 2 -->
            <div class="absolute inset-0 opacity-0 transition-opacity duration-1000 ease-in-out hero-slide z-0">
              <img src="/images/herbal-garden-1.jpg" alt="Herbal Garden" class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent"></div>
              <div class="absolute bottom-4 left-4 right-4 text-left">
                <span class="lang-en text-[10px] uppercase tracking-[0.2em] text-accent-gold font-sans font-bold">Nature's Pharmacy</span>
                <span class="lang-ml font-malayalam text-[10px] text-accent-gold font-bold block">പ്രകൃതിദത്ത ഔഷധങ്ങൾ</span>
                <h3 class="lang-en text-sm font-serif text-white font-bold leading-tight mt-0.5">Organic In-House Herbal Garden</h3>
                <h3 class="lang-ml font-malayalam text-sm text-white font-bold leading-tight mt-0.5">സ്വന്തം ഔഷധ സസ്യത്തോട്ടം</h3>
              </div>
            </div>
            <!-- Slide 3 -->
            <div class="absolute inset-0 opacity-0 transition-opacity duration-1000 ease-in-out hero-slide z-0">
              <img src="/images/spine-joint.jpg" alt="Traditional Therapies" class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent"></div>
              <div class="absolute bottom-4 left-4 right-4 text-left">
                <span class="lang-en text-[10px] uppercase tracking-[0.2em] text-accent-gold font-sans font-bold">Specialized Care</span>
                <span class="lang-ml font-malayalam text-[10px] text-accent-gold font-bold block">പ്രത്യേക ചികിത്സകൾ</span>
                <h3 class="lang-en text-sm font-serif text-white font-bold leading-tight mt-0.5">Traditional Spine & Joint Therapies</h3>
                <h3 class="lang-ml font-malayalam text-sm text-white font-bold leading-tight mt-0.5">തനത് നട്ടെല്ല്, സന്ധി രോഗ ചികിത്സകൾ</h3>
              </div>
            </div>
            <!-- Slide 4 -->
            <div class="absolute inset-0 opacity-0 transition-opacity duration-1000 ease-in-out hero-slide z-0">
              <img src="/images/yoga-meditation.jpg" alt="Yoga & Meditation" class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent"></div>
              <div class="absolute bottom-4 left-4 right-4 text-left">
                <span class="lang-en text-[10px] uppercase tracking-[0.2em] text-accent-gold font-sans font-bold">Holistic Well-being</span>
                <span class="lang-ml font-malayalam text-[10px] text-accent-gold font-bold block">ഹോലിസ്റ്റിക് വെൽനസ്സ്</span>
                <h3 class="lang-en text-sm font-serif text-white font-bold leading-tight mt-0.5">Integrated Yoga & Wellness Guidance</h3>
                <h3 class="lang-ml font-malayalam text-sm text-white font-bold leading-tight mt-0.5">യോഗയും അനുബന്ധ ചികിത്സാ മാർഗ്ഗങ്ങളും</h3>
              </div>
            </div>
          </div>
          
          <!-- Slide Navigation Indicators -->
          <div class="absolute bottom-4 right-4 flex gap-1.5 z-20">
            <button class="w-2 h-2 rounded-full bg-white transition-colors hero-dot active-dot" aria-label="Slide 1"></button>
            <button class="w-2 h-2 rounded-full bg-white/40 hover:bg-white transition-colors hero-dot" aria-label="Slide 2"></button>
            <button class="w-2 h-2 rounded-full bg-white/40 hover:bg-white transition-colors hero-dot" aria-label="Slide 3"></button>
            <button class="w-2 h-2 rounded-full bg-white/40 hover:bg-white transition-colors hero-dot" aria-label="Slide 4"></button>
          </div>
        </div>
      </div>

      <!-- Column 3: Founder Spotlight Card (Right - 3/12 width) -->
      <div class="lg:col-span-3 flex flex-col justify-center">
        <div class="relative w-full bg-white border border-accent-gold/25 rounded-2xl p-4 shadow-md flex flex-col items-center text-center group animate-fade-in-up delay-200 max-w-[280px] sm:max-w-[320px] lg:max-w-none mx-auto">
          <!-- Elegant arched background overlay pattern inside border -->
          <div class="absolute inset-0 bg-gradient-to-b from-background-parchment/30 to-transparent rounded-2xl pointer-events-none"></div>

          <!-- Portrait Frame -->
          <div class="relative w-full aspect-[4/5] rounded-xl overflow-hidden border border-accent-gold/20 mb-4 shadow-sm">
            <img 
              src="/images/vmfounder.jpg" 
              alt="Dr. P. Abdul Sathar Gurukkal"
              class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
            />
          </div>
          
          <!-- Content -->
          <span class="lang-en text-[9px] uppercase tracking-[0.25em] text-accent-gold font-sans font-bold mb-1 block">Founder & Visionary</span>
          <span class="lang-ml font-malayalam text-[10px] text-accent-gold font-bold block mb-1">സ്ഥാപകനും മാർഗ്ഗദർശിയും</span>

          <h3 class="lang-en text-base font-serif text-primary-dark font-bold leading-tight">Dr. P. Abdul Sathar Gurukkal</h3>
          <h3 class="lang-ml font-malayalam text-base text-primary-dark font-bold leading-tight">ഡോ. പി. അബ്ദുൽ സത്താർ ഗുരുക്കൾ</h3>
          
          <p class="lang-en text-[11px] text-text-muted font-sans mt-0.5 leading-none">Chief Physician (1983 - 2024)</p>
          <p class="lang-ml font-malayalam text-[11px] text-text-muted mt-0.5 leading-none">ചീഫ് ഫിസിഷ്യൻ (1983 - 2024)</p>
          
          <!-- Philosophy/Quote -->
          <div class="w-full border-t border-accent-gold/10 mt-3 pt-3">
            <p class="lang-en text-xs italic text-primary font-serif leading-snug">
              "Curing illness is not just symptom management; it is reviving the natural balance of life."
            </p>
            <p class="lang-ml font-malayalam text-xs italic text-primary leading-snug">
              "രോഗം സുഖപ്പെടുത്തുക എന്നാൽ ലക്ഷണങ്ങൾ മാറ്റുക മാത്രമല്ല; അത് ജീവിതത്തിന്റെ സ്വാഭാവിക സമതുലിതാവസ്ഥ വീണ്ടെടുക്കുകയാണ്."
            </p>
          </div>
        </div>
      </div>
      
    </div>

    <!-- Trust Strip Integration -->
    <div class="w-full border-t border-accent-gold/20 mt-12 lg:mt-16 pt-6">
      <div class="flex flex-wrap justify-center items-center gap-x-6 gap-y-3 md:gap-x-12 text-center">
        <div class="flex items-center gap-2">
          <span class="lang-en text-xs font-serif font-bold text-primary-dark tracking-wide">NABH Approved Hospital</span>
          <span class="lang-ml font-malayalam text-xs font-bold text-primary-dark">NABH അംഗീകൃത ആശുപത്രി</span>
          <span class="w-1.5 h-1.5 rounded-full bg-accent-gold/60"></span>
        </div>
        <div class="flex items-center gap-2">
          <span class="lang-en text-xs font-serif font-bold text-primary-dark tracking-wide">Ministry of AYUSH Certified</span>
          <span class="lang-ml font-malayalam text-xs font-bold text-primary-dark">മിനിസ്ട്രി ഓഫ് ആയുഷ് സാക്ഷ്യപ്പെടുത്തിയത്</span>
          <span class="w-1.5 h-1.5 rounded-full bg-accent-gold/60"></span>
        </div>
        <div class="flex items-center gap-2">
          <span class="lang-en text-xs font-serif font-bold text-primary-dark tracking-wide">ISO 9001:2015 Certified</span>
          <span class="lang-ml font-malayalam text-xs font-bold text-primary-dark">ISO 9001:2015 അംഗീകൃതം</span>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  function initHeroSlider() {
    const slides = document.querySelectorAll('.hero-slide');
    const dots = document.querySelectorAll('.hero-dot');
    if (slides.length === 0) return;

    let currentSlide = 0;
    let timer: ReturnType<typeof setInterval>;

    function showSlide(index: number) {
      slides.forEach((slide, i) => {
        if (i === index) {
          slide.classList.remove('opacity-0', 'z-0');
          slide.classList.add('opacity-100', 'z-10');
        } else {
          slide.classList.remove('opacity-100', 'z-10');
          slide.classList.add('opacity-0', 'z-0');
        }
      });

      dots.forEach((dot, i) => {
        if (i === index) {
          dot.classList.add('active-dot', 'bg-white');
          dot.classList.remove('bg-white/40');
        } else {
          dot.classList.remove('active-dot', 'bg-white');
          dot.classList.add('bg-white/40');
        }
      });

      currentSlide = index;
    }

    function nextSlide() {
      let next = currentSlide + 1;
      if (next >= slides.length) next = 0;
      showSlide(next);
    }

    function startTimer() {
      stopTimer();
      timer = setInterval(nextSlide, 4500);
    }

    function stopTimer() {
      if (timer) clearInterval(timer);
    }

    // Attach click events to dots
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        showSlide(i);
        startTimer();
      });
    });

    // Start
    startTimer();
  }

  // Initialize
  initHeroSlider();

  // Re-run safely on Astro page transitions
  document.addEventListener('astro:page-load', initHeroSlider);
</script>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
  }

  .delay-100 { animation-delay: 0.1s; }
  .delay-150 { animation-delay: 0.15s; }
  .delay-200 { animation-delay: 0.2s; }
</style>
