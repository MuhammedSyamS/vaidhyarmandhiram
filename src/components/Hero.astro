---
import { ArrowRight } from 'lucide-react';
---

<section class="relative min-h-[750px] lg:h-screen lg:min-h-[800px] flex items-center overflow-hidden py-24 lg:py-0">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/images/hero-bg.jpg" 
      alt="Ayurvedic Treatment"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-primary-dark/80 backdrop-blur-[1px]"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-primary-dark via-transparent to-transparent opacity-70"></div>
  </div>

  <div class="container mx-auto px-4 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-7 space-y-6 text-left">
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-serif text-background-parchment leading-tight mb-4 animate-fade-in-up">
          Authentic Healing <br/>
          <span class="text-accent-gold italic">Rooted in Tradition</span>
        </h1>
        <p class="text-base md:text-lg text-background-parchment/80 font-sans leading-relaxed max-w-xl animate-fade-in-up delay-200">
          Experience the profound wisdom of Kerala Ayurveda at Vaidyarmandiram. Guided by decades of heritage and the legacy of Dr. P. Abdul Sathar Gurukkal.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 pt-2 animate-fade-in-up delay-400">
          <a href="/appointment" class="btn-primary flex items-center justify-center gap-2 group">
            Book a Consultation
            <ArrowRight size={20} class="transition-transform group-hover:translate-x-1" />
          </a>
          <a href="/treatments" class="btn-outline !text-background-parchment !border-background-parchment hover:!bg-background-parchment hover:!text-primary-dark flex items-center justify-center">
            Explore Treatments
          </a>
        </div>
      </div>

      <!-- Right Column: Founder Portrait (Attractive and high impact) -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end animate-fade-in-up delay-300">
        <div class="relative w-full max-w-[320px] sm:max-w-[360px] md:max-w-[380px] group">
          <!-- Decorative glowing border behind image -->
          <div class="absolute -inset-1.5 bg-gradient-to-r from-accent-gold/40 to-primary/40 rounded-[2.2rem] blur-xl opacity-40 group-hover:opacity-60 transition duration-1000"></div>
          
          <!-- Image Container -->
          <div class="relative bg-primary-dark/50 border border-accent-gold/25 rounded-[2rem] overflow-hidden shadow-2xl">
            <img 
              src="/images/vmfounder.jpg" 
              alt="Dr. P. Abdul Sathar Gurukkal"
              class="w-full aspect-[4/5] object-cover object-top filter contrast-[1.03] brightness-[0.98] transition-transform duration-700 group-hover:scale-105"
            />
            <!-- Elegant Subtle Overlay Gradient on the bottom of the photo -->
            <div class="absolute inset-0 bg-gradient-to-t from-primary-dark/95 via-primary-dark/20 to-transparent"></div>
            
            <!-- Name/Designation Overlay -->
            <div class="absolute bottom-6 left-6 right-6 text-left">
              <p class="text-[10px] uppercase tracking-[0.25em] text-accent-gold font-sans font-bold mb-1">Our Founder</p>
              <h3 class="text-lg sm:text-xl font-serif text-background-parchment font-bold leading-tight">Dr. P. Abdul Sathar Gurukkal</h3>
              <p class="text-xs text-background-parchment/70 font-sans mt-0.5">Chief Physician (1983 - 2024)</p>
            </div>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>


<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
  }

  .delay-200 { animation-delay: 0.2s; }
  .delay-400 { animation-delay: 0.4s; }
</style>
