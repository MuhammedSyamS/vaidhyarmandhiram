---
import { ArrowRight, Sparkles, Quote } from 'lucide-react';
---

<section class="relative bg-cover bg-center overflow-hidden border-b border-accent-gold/20 pt-4 pb-12 lg:py-24 flex flex-col justify-start lg:justify-center min-h-[100svh] w-full" style="background-image: url('https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/herbal-garden-2.jpg');">
  <!-- Decorative background elements -->
  <div class="absolute inset-0 bg-white/80 mix-blend-overlay z-0"></div>
  <div class="absolute inset-0 opacity-[0.04] mix-blend-multiply pointer-events-none bg-parchment-texture bg-repeat z-0"></div>

  <div class="container mx-auto px-4 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Column 1: Institutional Heritage (Left - 6/12 width) -->
      <div class="lg:col-span-6 flex flex-col justify-center space-y-6 text-left relative z-10">
        <div>
          <!-- Double-Ring Gold Badge (Heritage Emblem) with Rotating Text -->
          <div class="flex items-center gap-4 mb-6 group cursor-default" data-aos="fade-up">
            <div class="relative flex items-center justify-center w-20 h-20 shrink-0">
              <!-- Elegant static outer text ring with rotation -->
              <svg viewBox="0 0 100 100" class="absolute inset-0 w-full h-full origin-center pointer-events-none select-none opacity-80 animate-spin-slow">
                <path id="crestPath" d="M 50, 50 m -38, 0 a 38,38 0 1,1 76,0 a 38,38 0 1,1 -76,0" fill="none" />
                <text class="font-sans font-extrabold uppercase fill-accent-gold text-[7.2px] tracking-[0.18em]">
                  <textPath href="#crestPath" startOffset="0%">• VAIDYARMANDIRAM • SINCE 1983</textPath>
                </text>
              </svg>
              
              <!-- Static inner golden crest -->
              <div class="w-14 h-14 rounded-full border border-accent-gold/45 bg-background-cream/60 flex flex-col items-center justify-center shadow-inner group-hover:scale-[1.03] transition-transform duration-500 relative">
                <div class="absolute inset-[2.5px] rounded-full border border-dashed border-accent-gold/30"></div>
                <span class="text-[7.5px] font-sans tracking-widest text-accent-gold font-bold uppercase leading-none z-10">Estd</span>
                <span class="text-xs font-serif font-bold text-primary-dark mt-0.5 leading-none z-10">1983</span>
              </div>
            </div>
            
            <div class="flex flex-col justify-center">
              <span class="lang-en text-[11px] font-sans tracking-[0.22em] text-accent-gold uppercase font-bold">Kerala Traditional Ayurveda</span>
