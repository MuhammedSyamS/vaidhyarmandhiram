<style>
  /* ── Slow spin animation for outer text ring & Mandala ── */
  @keyframes spinSlow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  @keyframes spinSlowReverse {
    from { transform: rotate(360deg); }
    to { transform: rotate(0deg); }
  }
  .animate-spin-slow {
    animation: spinSlow 20s linear infinite;
    transform-origin: center;
  }
  .animate-spin-slow-reverse {
    animation: spinSlowReverse 28s linear infinite;
    transform-origin: center;
  }

  /* ── Fade In Up Animation for Hero Entry ── */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .delay-100 { animation-delay: 0.1s; }
  .delay-150 { animation-delay: 0.15s; }
  .delay-200 { animation-delay: 0.2s; }

  /* ── Shimmering Gold Button Effect ── */
  .btn-shimmer {
    position: relative;
    overflow: hidden;
  }
  .btn-shimmer::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -70%;
    width: 40%;
    height: 200%;
    background: linear-gradient(
      to right,
      transparent,
      rgba(255, 255, 255, 0.25),
      transparent
    );
    transform: rotate(30deg);
    transition: none;
  }
  .btn-shimmer:hover::after {
    left: 170%;
    transition: all 1s cubic-bezier(0.19, 1, 0.22, 1);
  }

  /* ── Expanding Outline for Secondary Button ── */
  .btn-expand-border {
    position: relative;
    z-index: 1;
    overflow: hidden;
  }
  .btn-expand-border::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #B8860B; /* accent-gold */
    z-index: -1;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .btn-expand-border:hover::before {
    transform: scaleX(1);
  }
  .btn-expand-border:hover {
    border-color: transparent;
  }
</style>

<script>
  function initHeroFounderCarousel() {
    const carousels = [
      { slideClass: 'mobile-hero-slide' },
      { slideClass: 'desktop-hero-slide' }
    ];

    carousels.forEach(({ slideClass }) => {
      const slides = document.querySelectorAll('.' + slideClass);
      if (slides.length < 2) return;
      
      let activeIdx = 0;
      
      // Clear existing interval if any to prevent multiple intervals on re-runs
      if ((window as any)['heroCarouselTimer_' + slideClass]) {
        clearInterval((window as any)['heroCarouselTimer_' + slideClass]);
      }
      
      (window as any)['heroCarouselTimer_' + slideClass] = setInterval(() => {
        slides[activeIdx].classList.remove('opacity-100');
        slides[activeIdx].classList.add('opacity-0');
        
        activeIdx = (activeIdx + 1) % slides.length;
        
        slides[activeIdx].classList.remove('opacity-0');
        slides[activeIdx].classList.add('opacity-100');
      }, 5000);
    });
  }

  initHeroFounderCarousel();
  document.addEventListener('astro:page-load', initHeroFounderCarousel);
</script>

<script>
  function initHeroStats() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const target = entry.target as HTMLElement;
          const endValue = parseInt(target.getAttribute('data-value') || '0');
          const duration = 2000;
          const startTime = performance.now();
          const updateCount = (currentTime: number) => {
            const progress = Math.min((currentTime - startTime) / duration, 1);
            const easeOut = progress * (2 - progress);
            target.innerText = Math.floor(easeOut * endValue).toLocaleString();
            if (progress < 1) requestAnimationFrame(updateCount);
            else target.innerText = endValue.toLocaleString();
          };
          requestAnimationFrame(updateCount);
          observer.unobserve(target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.hero-stat-number').forEach(stat => observer.observe(stat));
  }

  initHeroStats();
  document.addEventListener('astro:page-load', initHeroStats);
</script>
