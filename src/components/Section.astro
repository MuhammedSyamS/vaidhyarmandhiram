---
interface Props {
  className?: string;
  id?: string;
  background?: 'parchment' | 'cream' | 'white' | 'dark';
  withDivider?: boolean;
}

const { 
  className = "", 
  id, 
  background = 'parchment',
  withDivider = false 
} = Astro.props;

const bgClasses = {
  parchment: 'bg-background-parchment',
  cream: 'bg-background-cream',
  white: 'bg-cover bg-center',
  dark: 'bg-primary-dark text-background-parchment',
};

const isWhite = background === 'white';
---

<section 
  id={id} 
  class:list={["py-16 md:py-24 relative overflow-hidden", bgClasses[background], className]}
  style={isWhite ? "background-image: url('https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/herbal-garden-2.jpg');" : ""}
>
  {isWhite && <div class="absolute inset-0 bg-white/60 backdrop-blur-[1px] z-0"></div>}
  <div class="container mx-auto px-4 relative z-10">
    <slot />
  </div>
  {withDivider && <div class="section-divider relative z-10"></div>}
</section>
