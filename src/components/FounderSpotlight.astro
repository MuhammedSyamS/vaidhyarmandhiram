---
import { ArrowRight } from 'lucide-react';
---

<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center max-w-6xl mx-auto py-8">
  
  <!-- Left Column: Portrait -->
  <div class="relative animate-on-scroll opacity-0 translate-y-8 transition-all duration-1000 flex justify-center lg:justify-end pr-0 lg:pr-8">
    <div class="relative w-[85%] sm:w-[70%] lg:w-[85%] aspect-[3/4] rounded-2xl overflow-hidden shadow-xl" id="spotlight-carousel">
      
      <!-- Slide 1: Founder -->
      <div class="absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-100 spotlight-slide">
        <img
          src="https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/vmfounder.jpg"
          alt="Dr. P. Abdul Sathar Gurukkal - Founder"
          class="w-full h-full object-cover object-[center_10%] scale-125"
        />
        <!-- Subtle gradient at bottom for name -->
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent p-5 sm:p-6 pt-20">
          <h3 class="lang-en text-white font-serif font-bold text-lg sm:text-xl tracking-wide leading-tight">Dr. P. Abdul Sathar Gurukkal</h3>
          <h3 class="lang-ml font-malayalam text-white font-bold text-base sm:text-lg leading-tight">ഡോ. പി. അബ്ദുൽ സത്താർ ഗുരുക്കൾ</h3>
          <p class="lang-en text-accent-gold text-xs sm:text-sm font-sans uppercase tracking-[0.2em] mt-1.5 font-semibold">Founder</p>
          <p class="lang-ml font-malayalam text-accent-gold text-xs sm:text-sm mt-1">സ്ഥാപകൻ</p>
        </div>
      </div>

      <!-- Slide 2: Co-founder -->
      <div class="absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-0 spotlight-slide">
        <img
          src="/images/Jafarkhan.jpg"
          alt="P. Jafar Khan Gurukkal - Co-founder & Managing Director"
          class="w-full h-full object-cover object-[35%_10%]"
        />
        <!-- Subtle gradient at bottom for name -->
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent p-5 sm:p-6 pt-20">
          <h3 class="lang-en text-white font-serif font-bold text-lg sm:text-xl tracking-wide leading-tight">P. Jafar Khan Gurukkal</h3>
          <h3 class="lang-ml font-malayalam text-white font-bold text-base sm:text-lg leading-tight">പി. ജാഫർ ഖാൻ ഗുരുക്കൾ</h3>
          <p class="lang-en text-accent-gold text-[10px] sm:text-[11px] font-sans uppercase tracking-[0.2em] mt-1.5 font-semibold">Co-founder & Managing Director</p>
          <p class="lang-ml font-malayalam text-accent-gold text-[10px] sm:text-[11px] mt-1">സഹസ്ഥാപകൻ & മാനേജിംഗ് ഡയറക്ടർ</p>
        </div>
      </div>

    </div>
  </div>

  <!-- Right Column: Content -->
  <div class="space-y-8 animate-on-scroll opacity-0 translate-y-8 transition-all duration-1000 delay-200 lg:pl-6">
    
    <div>
      <span class="lang-en text-accent-gold font-sans uppercase tracking-[0.2em] text-sm font-bold block mb-3">Our Legacy</span>
      <span class="lang-ml font-malayalam text-accent-gold text-sm font-bold block mb-3">ഞങ്ങളുടെ പാരമ്പര്യം</span>
      
      <h2 class="lang-en text-4xl md:text-5xl text-primary-dark font-serif leading-tight">
        Preserving the pure essence of <span class="italic text-accent-gold">Ayurveda.</span>
      </h2>
      <h2 class="lang-ml font-malayalam text-3xl md:text-4xl text-primary-dark font-bold leading-tight">
        ആയുർവേദത്തിന്റെ ശുദ്ധമായ <span class="text-accent-gold">സത്ത സംരക്ഷിക്കുന്നു.</span>
      </h2>
    </div>

    <div class="space-y-6 text-gray-600 font-sans text-lg leading-relaxed">
      <p class="lang-en">
        Founded in 1983 in Pangode, Trivandrum, by <strong>Dr. P. Abdul Sathar Gurukkal</strong>, our institution was established with a singular vision — to preserve and share the sacred wisdom of traditional healing with every soul who seeks it.
      </p>
      <p class="lang-ml font-malayalam text-justify font-medium">
        1983-ൽ തിരുവനന്തപുരം പാങ്ങോട്, ഡോ. പി. അബ്ദുൽ സത്താർ ഗുരുക്കൾ സ്ഥാപിച്ച ഈ സ്ഥാപനം, പരമ്പരാഗത ചികിത്സയുടെ പാവനമായ അറിവുകൾ സംരക്ഷിക്കുകയും പ്രചരിപ്പിക്കുകയും ചെയ്യുക എന്ന ഏക ലക്ഷ്യത്തോടെ രൂപീകൃതമായത്.
      </p>
      
      <p class="lang-en">
        Passed down through three generations, we continue to uphold the purest practices of Ayurveda. Today, we are proud to be accredited by <strong>NABH</strong> and the <strong>Ministry of AYUSH</strong>, ensuring world-class care rooted in ancient wisdom.
      </p>
      <p class="lang-ml font-malayalam text-justify font-medium">
        മൂന്ന് തലമുറകളായി കൈമാറി വന്ന ഞങ്ങൾ ആയുർവേദത്തിന്റെ ഏറ്റവും ശുദ്ധമായ രീതികൾ തുടരുന്നു. ഇന്ന്, NABH, ആയുഷ് മന്ത്രാലയം എന്നിവയുടെ അംഗീകാരത്തോടെ മികച്ച ചികിത്സ ഉറപ്പാക്കുന്നതിൽ ഞങ്ങൾ അഭിമാനിക്കുന്നു.
      </p>
    </div>

    <blockquote class="pl-6 border-l-2 border-accent-gold py-2">
      <p class="lang-en font-serif italic text-xl text-primary-dark/90 leading-relaxed">
        "Healing is not merely the absence of disease, but the harmonious alignment of body, mind, and spirit with the laws of nature."
      </p>
      <p class="lang-ml font-malayalam font-semibold text-lg text-primary-dark/90 leading-relaxed">
        "രോഗമില്ലാത്ത അവസ്ഥ മാത്രമല്ല ആരോഗ്യം, ശരീരവും മനസ്സും ആത്മാവും പ്രകൃതിനിയമങ്ങളുമായി പൊരുത്തപ്പെടുന്ന സന്തുലിതാവസ്ഥയാണ്."
      </p>
    </blockquote>

    <div class="pt-4">
      <a href="/about" class="inline-flex items-center gap-3 text-primary-dark font-sans font-bold text-base hover:text-accent-gold transition-colors group pb-1 border-b-2 border-primary-dark hover:border-accent-gold">
        <span class="lang-en">Discover Our Full Story</span>
        <span class="lang-ml font-malayalam">കൂടുതൽ അറിയുക</span>
        <ArrowRight size={18} className="group-hover:translate-x-1 transition-transform" />
      </a>
    </div>

  </div>

</div>

<script>
  function initFounderSpotlightAnimation() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.remove('opacity-0', 'translate-y-8');
          entry.target.classList.add('opacity-100', 'translate-y-0');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.animate-on-scroll').forEach(el => {
      observer.observe(el);
    });

    const statObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const target = entry.target as HTMLElement;
          const endValue = parseInt(target.getAttribute('data-value') || '0');
          const duration = 2000;
          const startTime = performance.now();
          const updateCount = (currentTime: number) => {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const current = Math.floor(progress * endValue);
            target.innerText = current.toString();
            if (progress < 1) requestAnimationFrame(updateCount);
          };
          requestAnimationFrame(updateCount);
          statObserver.unobserve(target);
        }
      });
    });

    document.querySelectorAll('.stat-number').forEach(el => statObserver.observe(el));
  }

  function initSpotlightCarousel() {
    const slides = document.querySelectorAll('.spotlight-slide');
    if (slides.length < 2) return;
    
    let activeIdx = 0;
    
    if ((window as any).spotlightCarouselTimer) {
      clearInterval((window as any).spotlightCarouselTimer);
    }
    
    (window as any).spotlightCarouselTimer = setInterval(() => {
      slides[activeIdx].classList.remove('opacity-100');
      slides[activeIdx].classList.add('opacity-0');
      
      activeIdx = (activeIdx + 1) % slides.length;
      
      slides[activeIdx].classList.remove('opacity-0');
      slides[activeIdx].classList.add('opacity-100');
    }, 5000);
  }

  initFounderSpotlightAnimation();
  initSpotlightCarousel();
  document.addEventListener('astro:page-load', () => {
    initFounderSpotlightAnimation();
    initSpotlightCarousel();
  });
</script>
