---
import { Calendar, Shield, Award, ArrowRight, Quote } from 'lucide-react';
---

<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">

  <!-- ══════════════════════════════════════════
       Left Column: Portrait Card (5/12)
  ══════════════════════════════════════════ -->
  <div class="lg:col-span-5 relative animate-on-scroll opacity-0 translate-x-[-30px] transition-all duration-1000 ease-out group/founder-card">

    <!-- Offset shadow border (behind the card) -->
    <div class="absolute inset-0 border border-accent-gold/20 rounded-2xl pointer-events-none translate-x-3 translate-y-3 group-hover/founder-card:translate-x-0 group-hover/founder-card:translate-y-0 transition-all duration-700 ease-out -z-10"></div>



    <!-- Main Portrait Card -->
    <div class="relative z-10 rounded-2xl border-2 border-accent-gold/40 p-3 bg-white shadow-[0_24px_55px_rgba(0,0,0,0.18)] group-hover/founder-card:scale-[1.01] transition-transform duration-500 ease-out">

      <!-- ── Top Badge: Ornate Corner (Right) ── -->
      <div class="absolute -top-3 -right-3 w-8 h-8 z-30">
        <div class="w-full h-full border-t-2 border-r-2 border-accent-gold/50 rounded-tr-lg"></div>
      </div>

      <!-- ── Photo Container ── -->
      <div class="relative rounded-xl overflow-hidden aspect-[3/4] border border-accent-gold/20 bg-primary-dark">
        <img
          src="/images/vmfounder.jpg"
          alt="Dr. P. Abdul Sathar Gurukkal - Founder, Vaidyarmandiram Ayurveda Hospital Kerala"
          class="w-full h-full object-cover object-[center_10%] scale-[1.25] hover:scale-[1.3] transition-transform duration-[7000ms] ease-out"
        />

        <!-- Gradient overlay -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>

        <!-- Photo corner accents -->
        <div class="absolute top-3 left-3 w-5 h-5 border-t border-l border-accent-gold/50"></div>
        <div class="absolute top-3 right-3 w-5 h-5 border-t border-r border-accent-gold/50"></div>
        <div class="absolute bottom-3 left-3 w-5 h-5 border-b border-l border-accent-gold/50"></div>
        <div class="absolute bottom-3 right-3 w-5 h-5 border-b border-r border-accent-gold/50"></div>
      </div>

      <!-- ── Name Plaque (inside card, below photo) ── -->
      <div class="mt-3 px-4 py-3.5 text-center relative border-t border-accent-gold/15">
        <!-- Corner accents on plaque -->
        <div class="absolute top-2 left-2 w-2.5 h-2.5 border-t border-l border-accent-gold/35"></div>
        <div class="absolute top-2 right-2 w-2.5 h-2.5 border-t border-r border-accent-gold/35"></div>
        <div class="absolute bottom-2 left-2 w-2.5 h-2.5 border-b border-l border-accent-gold/35"></div>
        <div class="absolute bottom-2 right-2 w-2.5 h-2.5 border-b border-r border-accent-gold/35"></div>

        <h3 class="lang-en text-base font-serif text-primary-dark font-bold tracking-wide">Dr. P. Abdul Sathar Gurukkal</h3>
        <h3 class="lang-ml font-malayalam text-sm text-primary-dark font-bold leading-snug">ഡോ. പി. അബ്ദുൽ സത്താർ ഗുരുക്കൾ</h3>
        <p class="lang-en text-[9px] uppercase tracking-widest text-accent-gold font-sans font-bold mt-1">Founder</p>
        <p class="lang-ml font-malayalam text-[9px] text-accent-gold mt-0.5 leading-none">സ്ഥാപകൻ</p>
      </div>

    </div><!-- /Main Portrait Card -->

    <!-- ── Bottom corner ornament ── -->
    <div class="absolute -bottom-3 -left-3 w-8 h-8 z-30">
      <div class="w-full h-full border-b-2 border-l-2 border-accent-gold/50 rounded-bl-lg"></div>
    </div>

  </div><!-- /Left Column -->


  <!-- ══════════════════════════════════════════
       Right Column: Bio Content (7/12)
  ══════════════════════════════════════════ -->
  <div class="lg:col-span-7 space-y-7 animate-on-scroll opacity-0 translate-x-[30px] transition-all duration-1000 ease-out delay-200">

    <!-- Section tag -->
    <div class="space-y-4">
      <span class="lang-en text-accent-gold font-sans uppercase tracking-[0.3em] text-xs font-bold block">Our Founder</span>
      <span class="lang-ml font-malayalam text-accent-gold uppercase tracking-wider text-sm font-semibold block">ഞങ്ങളുടെ സ്ഥാപകൻ</span>

      <!-- Heading -->
      <h2 class="lang-en text-4xl md:text-5xl text-primary-dark leading-tight font-serif">
        Decades of Healing, <br/>
        <span class="text-accent-gold italic">Rooted in Tradition</span>
      </h2>
      <h2 class="lang-ml font-malayalam text-3xl md:text-4xl text-primary-dark leading-tight font-bold">
        പാരമ്പര്യത്തിൽ അധിഷ്ഠിതമായ <br/>
        <span class="text-accent-gold font-semibold">പതിറ്റാണ്ടുകളുടെ സൗഖ്യം</span>
      </h2>

      <!-- Ornate Gold Divider -->
      <div class="flex items-center gap-3 pt-1">
        <div class="h-[1px] w-16 bg-gradient-to-r from-transparent to-accent-gold/60"></div>
        <div class="w-1.5 h-1.5 rotate-45 bg-accent-gold"></div>
        <div class="h-[1px] w-16 bg-gradient-to-l from-transparent to-accent-gold/60"></div>
      </div>
    </div>

    <!-- Biography paragraph -->
    <div>
      <p class="lang-en first-letter:text-5xl first-letter:font-serif first-letter:font-bold first-letter:text-accent-gold first-letter:mr-3 first-letter:float-left first-letter:leading-[0.8] first-letter:mt-1 text-primary-dark/85 italic font-serif text-base sm:text-lg leading-relaxed">
        Founded in 1983 in Pangode, Trivandrum, by Dr. P. Abdul Sathar Gurukkal, our institution was created with a single vision — to preserve and share the sacred wisdom of traditional healing.
      </p>
      <p class="lang-ml font-malayalam text-primary-dark/90 font-semibold text-base sm:text-lg leading-relaxed text-justify">
        1983-ൽ തിരുവനന്തപുരം പാങ്ങോട്, ഡോ. പി. അബ്ദുൽ സത്താർ ഗുരുക്കൾ സ്ഥാപിച്ച ഈ സ്ഥാപനം, പരമ്പരാഗത ചികിത്സയുടെ പാവനമായ അറിവുകൾ സംരക്ഷിക്കുകയും പ്രചരിപ്പിക്കുകയും ചെയ്യുക എന്ന ഏക ലക്ഷ്യത്തോടെയാണ് രൂപീകൃതമായത്.
      </p>
    </div>

    <!-- Legacy Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">

      <!-- Card 1: 1983 Founding -->
      <div class="bg-background-cream/30 border border-accent-gold/20 rounded-xl p-4 hover:bg-white hover:border-accent-gold/55 hover:-translate-y-1 hover:shadow-[0_12px_28px_rgba(184,134,11,0.09)] transition-all duration-400 group/card">
        <div class="w-11 h-11 rounded-full bg-background-cream/70 border border-accent-gold/25 flex items-center justify-center text-accent-gold mb-3 group-hover/card:bg-primary-dark group-hover/card:text-white group-hover/card:border-transparent transition-all duration-400 shadow-sm relative">
          <div class="absolute inset-[2px] rounded-full border border-dashed border-accent-gold/20 group-hover/card:border-white/20"></div>
          <Calendar size={16} class="group-hover/card:scale-110 transition-transform duration-400 relative z-10" />
        </div>
        <h4 class="lang-en text-sm font-serif text-primary-dark font-bold tracking-wide">1983 Founding</h4>
        <h4 class="lang-ml font-malayalam text-sm text-primary-dark font-bold">1983 സ്ഥാപനം</h4>
        <p class="lang-en text-xs text-text-muted mt-1.5 font-sans leading-relaxed">Established in Pangode, Trivandrum to preserve the ancient wisdom of Ayurveda.</p>
        <p class="lang-ml font-malayalam text-xs text-text-muted mt-1.5 leading-relaxed">ആയുർവേദ ജ്ഞാനം സംരക്ഷിക്കാൻ തിരുവനന്തപുരം പാങ്ങോട് ആരംഭിച്ചു.</p>
      </div>

      <!-- Card 2: Healing Sanctuary -->
      <div class="bg-background-cream/30 border border-accent-gold/20 rounded-xl p-4 hover:bg-white hover:border-accent-gold/55 hover:-translate-y-1 hover:shadow-[0_12px_28px_rgba(184,134,11,0.09)] transition-all duration-400 group/card">
        <div class="w-11 h-11 rounded-full bg-background-cream/70 border border-accent-gold/25 flex items-center justify-center text-accent-gold mb-3 group-hover/card:bg-primary-dark group-hover/card:text-white group-hover/card:border-transparent transition-all duration-400 shadow-sm relative">
          <div class="absolute inset-[2px] rounded-full border border-dashed border-accent-gold/20 group-hover/card:border-white/20"></div>
          <Shield size={16} class="group-hover/card:scale-110 transition-transform duration-400 relative z-10" />
        </div>
        <h4 class="lang-en text-sm font-serif text-primary-dark font-bold tracking-wide">Healing Sanctuary</h4>
        <h4 class="lang-ml font-malayalam text-sm text-primary-dark font-bold">ചികിത്സാ സങ്കേതം</h4>
        <p class="lang-en text-xs text-text-muted mt-1.5 font-sans leading-relaxed">A sanctuary where ancient Siddhis and holistic care restore balance to body and soul.</p>
        <p class="lang-ml font-malayalam text-xs text-text-muted mt-1.5 leading-relaxed">പുരാതന സിദ്ധികളിലൂടെ ശരീരവും മനസ്സും സുഖപ്പെടുത്തുന്നു.</p>
      </div>

      <!-- Card 3: Pure Lineage -->
      <div class="bg-background-cream/30 border border-accent-gold/20 rounded-xl p-4 hover:bg-white hover:border-accent-gold/55 hover:-translate-y-1 hover:shadow-[0_12px_28px_rgba(184,134,11,0.09)] transition-all duration-400 group/card">
        <div class="w-11 h-11 rounded-full bg-background-cream/70 border border-accent-gold/25 flex items-center justify-center text-accent-gold mb-3 group-hover/card:bg-primary-dark group-hover/card:text-white group-hover/card:border-transparent transition-all duration-400 shadow-sm relative">
          <div class="absolute inset-[2px] rounded-full border border-dashed border-accent-gold/20 group-hover/card:border-white/20"></div>
          <Award size={16} class="group-hover/card:scale-110 transition-transform duration-400 relative z-10" />
        </div>
        <h4 class="lang-en text-sm font-serif text-primary-dark font-bold tracking-wide">Pure Lineage</h4>
        <h4 class="lang-ml font-malayalam text-sm text-primary-dark font-bold">പാവന പാരമ്പര്യം</h4>
        <p class="lang-en text-xs text-text-muted mt-1.5 font-sans leading-relaxed">Traditions passed onto the third generation, ensuring absolute purity of care.</p>
        <p class="lang-ml font-malayalam text-xs text-text-muted mt-1.5 leading-relaxed">ചികിത്സാ ജ്ഞാനം മൂന്നാം തലമുറയ്ക്ക് കൈമാറി പാരമ്പര്യം നിലനിർത്തുന്നു.</p>
      </div>

    </div><!-- /Legacy Cards -->

    <!-- Parchment Quote Block -->
    <div class="relative bg-background-cream/45 border border-accent-gold/22 p-6 sm:p-7 rounded-2xl shadow-sm font-serif text-center overflow-hidden">
      <!-- Inner dashed border -->
      <div class="absolute inset-[3px] rounded-xl border border-dashed border-accent-gold/22 pointer-events-none"></div>
      <!-- Corner dots -->
      <div class="absolute top-3 left-3 w-1 h-1 rounded-full bg-accent-gold/40"></div>
      <div class="absolute top-3 right-3 w-1 h-1 rounded-full bg-accent-gold/40"></div>
      <div class="absolute bottom-3 left-3 w-1 h-1 rounded-full bg-accent-gold/40"></div>
      <div class="absolute bottom-3 right-3 w-1 h-1 rounded-full bg-accent-gold/40"></div>

      <Quote size={34} class="mx-auto text-accent-gold/20 mb-3" />

      <p class="lang-en text-base sm:text-lg text-primary-dark leading-relaxed font-serif italic relative z-10">
        "Healing is not merely the absence of disease, but the harmonious alignment of the body, mind, and spirit with the laws of nature."
      </p>
      <p class="lang-ml font-malayalam text-sm sm:text-base text-primary-dark leading-relaxed font-semibold relative z-10">
        "രോഗമില്ലാത്ത അവസ്ഥ മാത്രമല്ല ആരോഗ്യം, മറിച്ച് ശരീരവും മനസ്സും ആത്മാവും പ്രകൃതിനിയമങ്ങളുമായി പൊരുത്തപ്പെടുന്ന സന്തുലിതാവസ്ഥയാണ്."
      </p>

      <!-- Signature -->
      <div class="mt-4 border-t border-accent-gold/15 pt-3 max-w-[210px] mx-auto relative z-10">
        <p class="lang-en text-[9px] uppercase tracking-widest text-accent-gold font-sans font-bold">Dr. P. Abdul Sathar Gurukkal</p>
        <p class="lang-ml font-malayalam text-[8px] text-accent-gold font-bold mt-0.5">ഡോ. പി. അബ്ദുൽ സത്താർ ഗുരുക്കൾ</p>
      </div>
    </div><!-- /Quote Block -->

    <!-- Story Link -->
    <div class="pt-1">
      <a
        href="/about"
        class="relative inline-flex items-center gap-2.5 text-primary-dark hover:text-accent-gold transition-colors duration-300 group font-serif text-lg font-bold pb-1 overflow-hidden"
      >
        <span class="lang-en">Read the Full Story</span>
        <span class="lang-ml font-malayalam">കൂടുതൽ വായിക്കുക</span>
        <ArrowRight size={16} class="transition-transform group-hover:translate-x-1.5 shrink-0 text-accent-gold" />
        <span class="absolute bottom-0 left-0 w-full h-[2px] bg-accent-gold scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></span>
      </a>
    </div>

  </div><!-- /Right Column -->

</div><!-- /Grid -->

<script>
  function initFounderSpotlightAnimation() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.remove('opacity-0', 'translate-x-[-30px]', 'translate-x-[30px]');
          entry.target.classList.add('opacity-100', 'translate-x-0');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.animate-on-scroll').forEach(el => {
      observer.observe(el);
    });
  }

  // Run on initial load
  initFounderSpotlightAnimation();

  // Re-run safely on View Transitions
  document.addEventListener('astro:page-load', initFounderSpotlightAnimation);
</script>
