---
import { Video, Mail, MessageCircle, UserCheck } from 'lucide-react';
---

<div class="relative bg-cover bg-center overflow-hidden py-16 md:py-24 border-y border-accent-gold/20" style="background-image: url('https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/herbal-garden-2.jpg');">
  <!-- Background overlay to ensure readability -->
  <div class="absolute inset-0 bg-background-cream/60 backdrop-blur-[1px] z-0"></div>
  
  <div class="container mx-auto px-4 md:px-6 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12 lg:gap-16 items-center max-w-6xl mx-auto">
      
      <!-- Top Column on Mobile / Right Top on Desktop: Headings & Writing -->
      <div class="col-span-1 lg:col-span-7 lg:col-start-6 order-1 lg:order-2 space-y-2 md:space-y-3 text-center lg:text-left">
        <span class="lang-en text-accent-gold font-sans uppercase tracking-[0.25em] text-[11px] md:text-sm font-bold">Expert Guidance</span>
        <span class="lang-ml font-malayalam text-accent-gold text-sm md:text-base font-semibold block">വിദഗ്ദ്ധ മാർഗ്ഗനിർദ്ദേശം</span>
        
        <h2 class="lang-en text-2xl sm:text-3xl md:text-5xl text-primary-dark font-serif leading-tight">
          Flexible <span class="text-accent-gold italic">Consultations</span>
        </h2>
        <div class="lang-ml font-malayalam block text-2xl sm:text-3xl md:text-5xl text-primary-dark font-bold leading-tight">
          നിങ്ങൾക്കനുയോജ്യമായ <span class="text-accent-gold">കൺസൾട്ടേഷൻ</span>
        </div>
        
        <p class="lang-en text-primary-dark/80 font-sans text-sm sm:text-base md:text-lg mt-3 md:mt-4 max-w-xl mx-auto lg:mx-0">
          Connecting with our experienced Ayurvedic physicians is easy. Choose from our various consultation modes designed for your convenience.
        </p>
        <p class="lang-ml font-malayalam text-primary-dark/80 text-sm sm:text-base md:text-lg mt-3 md:mt-4 max-w-xl mx-auto lg:mx-0 leading-relaxed">
          ഞങ്ങളുടെ വിദഗ്ദ്ധ ഡോക്ടർമാരുമായി ബന്ധപ്പെടാൻ ഇപ്പോൾ എളുപ്പമാണ്. നിങ്ങൾക്ക് ഏറ്റവും സൗകര്യപ്രദമായ കൺസൾട്ടേഷൻ രീതി തിരഞ്ഞെടുക്കുക.
        </p>
      </div>

      <!-- Middle Column on Mobile / Left Column on Desktop: Consultation Visual -->
      <div class="col-span-1 lg:col-span-5 order-2 lg:order-1 lg:row-span-2 relative" data-aos="fade-right" data-aos-duration="1000">
        <!-- Decorative background glow -->
        <div class="absolute inset-0 bg-accent-gold/10 rounded-[1.5rem] md:rounded-[2rem] transform translate-x-2 translate-y-2 md:translate-x-4 md:translate-y-4 -z-10"></div>
        <div class="absolute -top-10 -left-10 w-32 h-32 md:w-40 md:h-40 bg-accent-gold/15 rounded-full blur-3xl z-0 pointer-events-none"></div>
        
        <div class="relative z-10 rounded-[1.5rem] md:rounded-[2rem] overflow-hidden border-2 border-accent-gold/30 shadow-[0_20px_50px_rgba(0,0,0,0.15)] bg-white aspect-[4/3] sm:aspect-[1.2] md:aspect-square lg:aspect-[4/5] group">
          <!-- Slide 1: In-Person Visit -->
          <div id="consult-slide-1" class="absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-100">
            <img 
              src="https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/in-PersonVisit.webp" 
              alt="In-Person Consultation" 
              class="w-full h-full object-cover object-center group-hover:scale-[1.03] transition-transform duration-[6000ms] ease-out"
            />
            <div class="absolute bottom-10 sm:bottom-12 left-4 sm:left-6 right-4 sm:right-6 z-20 text-white font-serif text-xs sm:text-base tracking-wide bg-black/45 backdrop-blur-[2px] p-2 rounded-lg border border-white/10 text-center">
              <span class="lang-en">In-Person Visit</span>
              <span class="lang-ml font-malayalam">നേരിട്ടുള്ള സന്ദർശനം</span>
            </div>
          </div>
          
          <!-- Slide 2: Video Consultation -->
          <div id="consult-slide-2" class="absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-0">
            <img 
              src="https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/online_consultation.png" 
              alt="Video Consultation" 
              class="w-full h-full object-cover object-center group-hover:scale-[1.03] transition-transform duration-[6000ms] ease-out"
            />
            <div class="absolute bottom-10 sm:bottom-12 left-4 sm:left-6 right-4 sm:right-6 z-20 text-white font-serif text-xs sm:text-base tracking-wide bg-black/45 backdrop-blur-[2px] p-2 rounded-lg border border-white/10 text-center">
              <span class="lang-en">Video Consultation</span>
              <span class="lang-ml font-malayalam">വീഡിയോ കൺസൾട്ടേഷൻ</span>
            </div>
          </div>
 
          <!-- Slide 3: WhatsApp Chat -->
          <div id="consult-slide-3" class="absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-0">
            <img 
              src="https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/whatsapp_consult.png" 
              alt="WhatsApp Consultation" 
              class="w-full h-full object-cover object-center group-hover:scale-[1.03] transition-transform duration-[6000ms] ease-out"
            />
            <div class="absolute bottom-10 sm:bottom-12 left-4 sm:left-6 right-4 sm:right-6 z-20 text-white font-serif text-xs sm:text-base tracking-wide bg-black/45 backdrop-blur-[2px] p-2 rounded-lg border border-white/10 text-center">
              <span class="lang-en">WhatsApp Chat</span>
              <span class="lang-ml font-malayalam">വാട്സ്ആപ്പ് ചാറ്റ്</span>
            </div>
          </div>
 
          <!-- Slide 4: Email Advice -->
          <div id="consult-slide-4" class="absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-0">
            <img 
              src="https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/email_consult.png" 
              alt="Email Advice" 
              class="w-full h-full object-cover object-center group-hover:scale-[1.03] transition-transform duration-[6000ms] ease-out"
            />
            <div class="absolute bottom-10 sm:bottom-12 left-4 sm:left-6 right-4 sm:right-6 z-20 text-white font-serif text-xs sm:text-base tracking-wide bg-black/45 backdrop-blur-[2px] p-2 rounded-lg border border-white/10 text-center">
              <span class="lang-en">Email Advice</span>
              <span class="lang-ml font-malayalam">ഇമെയിൽ കൺസൾട്ടേഷൻ</span>
            </div>
          </div>
 
          <!-- Elegant gradient overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-primary-dark/80 via-transparent to-transparent opacity-70 pointer-events-none"></div>
          
          <!-- Four Dots indicators -->
          <div class="absolute bottom-4 left-0 right-0 flex justify-center gap-2.5 z-20">
            <button id="consult-dot-1" class="w-3 h-3 rounded-full bg-accent-gold transition-all duration-300 ring-2 ring-white/50" aria-label="Slide 1"></button>
            <button id="consult-dot-2" class="w-3 h-3 rounded-full bg-white/50 transition-all duration-300 hover:bg-white" aria-label="Slide 2"></button>
            <button id="consult-dot-3" class="w-3 h-3 rounded-full bg-white/50 transition-all duration-300 hover:bg-white" aria-label="Slide 3"></button>
            <button id="consult-dot-4" class="w-3 h-3 rounded-full bg-white/50 transition-all duration-300 hover:bg-white" aria-label="Slide 4"></button>
          </div>
 
          <!-- Decorative gold corners -->
          <div class="absolute top-4 left-4 w-6 h-6 border-t-2 border-l-2 border-accent-gold/60 pointer-events-none"></div>
          <div class="absolute top-4 right-4 w-6 h-6 border-t-2 border-r-2 border-accent-gold/60 pointer-events-none"></div>
          <div class="absolute bottom-4 left-4 w-6 h-6 border-b-2 border-l-2 border-accent-gold/60 pointer-events-none"></div>
          <div class="absolute bottom-4 right-4 w-6 h-6 border-b-2 border-r-2 border-accent-gold/60 pointer-events-none"></div>
        </div>
      </div>
 
      <!-- Bottom Column on Mobile / Right Bottom on Desktop: Consultation Options -->
      <div class="col-span-1 lg:col-span-7 lg:col-start-6 order-3 lg:order-3" data-aos="fade-left" data-aos-duration="1000" data-aos-delay="200">
        <div class="grid grid-cols-2 gap-3 sm:gap-4">
          <!-- Option 1: Personal -->
          <a href="/appointment" class="block bg-white border border-accent-gold/20 p-4 sm:p-5 rounded-xl hover:shadow-[0_8px_20px_rgba(184,134,11,0.12)] hover:border-accent-gold/50 transition-all duration-300 group">
            <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-primary/5 flex items-center justify-center mb-3 sm:mb-4 group-hover:bg-primary group-hover:text-white transition-colors duration-300 text-accent-gold">
              <UserCheck size={20} className="sm:w-6 sm:h-6" />
            </div>
            <h3 class="lang-en font-serif text-lg sm:text-xl font-bold text-primary-dark mb-1">In-Person Visit</h3>
            <h3 class="lang-ml font-malayalam text-base sm:text-lg font-bold text-primary-dark mb-1">നേരിട്ടുള്ള സന്ദർശനം</h3>
            <p class="lang-en text-xs sm:text-sm text-text-muted font-sans">Visit our hospital for a comprehensive pulse diagnosis.</p>
            <p class="lang-ml font-malayalam text-xs sm:text-sm text-text-muted">നേരിട്ടുള്ള പരിശോധനയ്ക്കായി ആശുപത്രി സന്ദർശിക്കുക.</p>
          </a>
 
          <!-- Option 2: Video -->
          <a href="/appointment" class="block bg-white border border-accent-gold/20 p-4 sm:p-5 rounded-xl hover:shadow-[0_8px_20px_rgba(184,134,11,0.12)] hover:border-accent-gold/50 transition-all duration-300 group">
            <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-primary/5 flex items-center justify-center mb-3 sm:mb-4 group-hover:bg-primary group-hover:text-white transition-colors duration-300 text-accent-gold">
              <Video size={20} className="sm:w-6 sm:h-6" />
            </div>
            <h3 class="lang-en font-serif text-lg sm:text-xl font-bold text-primary-dark mb-1">Video Consultation</h3>
            <h3 class="lang-ml font-malayalam text-base sm:text-lg font-bold text-primary-dark mb-1">വീഡിയോ കൺസൾട്ടേഷൻ</h3>
            <p class="lang-en text-xs sm:text-sm text-text-muted font-sans">Face-to-face expert diagnosis from your home.</p>
            <p class="lang-ml font-malayalam text-xs sm:text-sm text-text-muted">വീട്ടിലിരുന്ന് ഡോക്ടർമാരുമായി നേരിട്ട് സംസാരിക്കാം.</p>
          </a>
 
          <!-- Option 3: WhatsApp -->
          <a href="https://wa.me/918593821553" class="block bg-white border border-accent-gold/20 p-4 sm:p-5 rounded-xl hover:shadow-[0_8px_20px_rgba(184,134,11,0.12)] hover:border-accent-gold/50 transition-all duration-300 group">
            <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-primary/5 flex items-center justify-center mb-3 sm:mb-4 group-hover:bg-primary group-hover:text-white transition-colors duration-300 text-accent-gold">
              <MessageCircle size={20} className="sm:w-6 sm:h-6" />
            </div>
            <h3 class="lang-en font-serif text-lg sm:text-xl font-bold text-primary-dark mb-1">WhatsApp Chat</h3>
            <h3 class="lang-ml font-malayalam text-base sm:text-lg font-bold text-primary-dark mb-1">വാട്സ്ആപ്പ്</h3>
            <p class="lang-en text-xs sm:text-sm text-text-muted font-sans">Quick guidance and seamless follow-ups via messaging.</p>
            <p class="lang-ml font-malayalam text-xs sm:text-sm text-text-muted">വാട്സ്ആപ്പ് വഴി വേഗത്തിലുള്ള മാർഗ്ഗനിർദ്ദേശങ്ങൾ.</p>
          </a>
 
          <!-- Option 4: Email -->
          <a href="mailto:consult@vaidyarmandiram.com" class="block bg-white border border-accent-gold/20 p-4 sm:p-5 rounded-xl hover:shadow-[0_8px_20px_rgba(184,134,11,0.12)] hover:border-accent-gold/50 transition-all duration-300 group">
            <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-primary/5 flex items-center justify-center mb-3 sm:mb-4 group-hover:bg-primary group-hover:text-white transition-colors duration-300 text-accent-gold">
              <Mail size={20} className="sm:w-6 sm:h-6" />
            </div>
            <h3 class="lang-en font-serif text-lg sm:text-xl font-bold text-primary-dark mb-1">Email Advise</h3>
            <h3 class="lang-ml font-malayalam text-base sm:text-lg font-bold text-primary-dark mb-1">ഇമെയിൽ ഉപദേശം</h3>
            <p class="lang-en text-xs sm:text-sm text-text-muted font-sans">Share reports and get detailed written advice.</p>
            <p class="lang-ml font-malayalam text-xs sm:text-sm text-text-muted">ഇമെയിൽ വഴി വിശദമായ ഉപദേശങ്ങൾ നേടുക.</p>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initConsultationCarousel() {
    const slide1 = document.getElementById('consult-slide-1');
    const slide2 = document.getElementById('consult-slide-2');
    const slide3 = document.getElementById('consult-slide-3');
    const slide4 = document.getElementById('consult-slide-4');
    const dot1 = document.getElementById('consult-dot-1');
    const dot2 = document.getElementById('consult-dot-2');
    const dot3 = document.getElementById('consult-dot-3');
    const dot4 = document.getElementById('consult-dot-4');

    if (!slide1 || !slide2 || !slide3 || !slide4 || !dot1 || !dot2 || !dot3 || !dot4) return;

    let activeSlide = 1;
    let timer: ReturnType<typeof setInterval>;

    const showSlide = (num: number) => {
      activeSlide = num;
      
      // Hide all slides and reset dot styles
      [slide1, slide2, slide3, slide4].forEach(slide => {
        slide.style.opacity = '0';
      });
      [dot1, dot2, dot3, dot4].forEach(dot => {
        dot.className = "w-3 h-3 rounded-full bg-white/50 transition-all duration-300 hover:bg-white";
      });
      
      // Show selected slide and activate its dot
      const slides = [slide1, slide2, slide3, slide4];
      const dots = [dot1, dot2, dot3, dot4];
      
      slides[num - 1].style.opacity = '1';
      dots[num - 1].className = "w-3 h-3 rounded-full bg-accent-gold transition-all duration-300 ring-2 ring-white/50";
    };

    const autoSlide = () => {
      timer = setInterval(() => {
        showSlide(activeSlide === 4 ? 1 : activeSlide + 1);
      }, 5000);
    };

    const resetTimer = () => {
      clearInterval(timer);
      autoSlide();
    };

    dot1.addEventListener('click', () => {
      showSlide(1);
      resetTimer();
    });

    dot2.addEventListener('click', () => {
      showSlide(2);
      resetTimer();
    });

    dot3.addEventListener('click', () => {
      showSlide(3);
      resetTimer();
    });

    dot4.addEventListener('click', () => {
      showSlide(4);
      resetTimer();
    });

    autoSlide();
  }

  // Run on initial load
  initConsultationCarousel();

  // Re-run safely on View Transitions
  document.addEventListener('astro:page-load', () => {
    initConsultationCarousel();
  });
</script>
