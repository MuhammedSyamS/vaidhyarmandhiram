---
import { Phone, Calendar, Menu } from 'lucide-react';

const navLinks = [
  { name: 'Home',       ml: 'ഹോം',              href: '/' },
  { name: 'About',      ml: 'ഞങ്ങളെ കുറിച്ച്', href: '/about' },
  { name: 'Treatments', ml: 'ചികിത്സകൾ',       href: '/treatments' },
  { name: 'Doctors',    ml: 'ഡോക്ടർമാർ',       href: '/doctors' },
  { name: 'Gallery',    ml: 'ഗ്യാലറി',          href: '/gallery' },
  { name: 'Blog',       ml: 'ബ്ലോഗ്',           href: '/blog' },
  { name: 'Contact',    ml: 'ബന്ധപ്പെടുക',     href: '/contact' },
];
---

<header class="sticky top-0 z-50 bg-background-parchment backdrop-blur-md border-b-2 border-accent-gold/40 shadow-sm">

  <!-- ── Top info bar ── -->
  <div class="bg-primary-dark text-background-parchment py-1.5 px-4 hidden md:block">
    <div class="container mx-auto flex justify-between items-center text-xs">

      <div class="flex items-center gap-5">
        <span class="flex items-center gap-1.5 font-medium font-sans">
          <Phone size={13} />
          +91 000 000 0000
        </span>
        <span class="lang-en font-sans text-accent-gold font-semibold tracking-widest uppercase text-[10px]">
          Vaidyarmandiram Ayurveda Hospital
        </span>
        <span class="lang-ml font-malayalam text-accent-gold font-semibold">
          വൈദ്യർമന്ദിരം ആയുർവേദ ഹോസ്പിറ്റൽ
        </span>
      </div>

      <div class="flex items-center gap-4">
        <!-- Book Appointment -->
        <a href="/appointment" class="flex items-center gap-1.5 text-accent-gold hover:text-white transition-colors font-semibold font-sans">
          <Calendar size={13} />
          <span class="lang-en">Book Appointment</span>
          <span class="lang-ml font-malayalam normal-case tracking-normal">അപ്പോയിന്റ്മെന്റ് ബുക്ക്</span>
        </a>

        <!-- ── Single Language Toggle Button ──
             Shows the OPPOSITE language (what you'll switch TO).
             EN mode → shows "മലയാളം" button
             ML mode → shows "English" button                    -->
        <!-- ── Single Language Toggle Button ──
             Shows the OPPOSITE language (what you'll switch TO).
             EN mode → shows "മാ" button
             ML mode → shows "E" button                    -->
        <button
          id="lang-switch"
          class="px-3 py-1 text-xs font-bold tracking-wide border border-accent-gold rounded-full text-accent-gold hover:bg-accent-gold hover:text-primary-dark transition-all duration-200 font-sans"
          aria-label="Switch language"
        >
          മാ
        </button>
      </div>
    </div>
  </div>

  <!-- ── Main nav ── -->
  <nav class="container mx-auto px-4 py-3 flex justify-between items-center">

    <!-- Brand -->
    <a href="/" class="flex items-center gap-3.5 md:gap-4 shrink-0 group">
      <img
        src="/vmfaviconpng.png"
        alt="Vaidyarmandiram Icon"
        class="h-14 w-14 md:h-18 md:w-18 rounded-full object-cover border-2 border-accent-gold shadow-lg transition-all duration-500 ease-out group-hover:scale-115 group-hover:rotate-[5deg]"
      />
      <div class="flex flex-col">
        <span class="lang-en text-base md:text-2xl font-serif font-bold text-primary-dark tracking-widest uppercase whitespace-nowrap transition-colors duration-300 group-hover:text-accent-gold">Vaidyarmandiram</span>
        <span class="lang-ml font-malayalam text-base md:text-2xl font-bold text-primary-dark whitespace-nowrap transition-colors duration-300 group-hover:text-accent-gold">വൈദ്യർമന്ദിരം</span>
        <span class="lang-en text-[8px] md:text-xs font-sans text-accent-gold tracking-[0.2em] md:tracking-[0.3em] uppercase whitespace-nowrap">Ayurveda Hospital</span>
        <span class="lang-ml font-malayalam text-[10px] md:text-xs text-accent-gold whitespace-nowrap">ആയുർവേദ ഹോസ്പിറ്റൽ</span>
      </div>
    </a>

    <!-- Desktop nav links -->
    <div class="hidden lg:flex items-center gap-4 xl:gap-6">
      {navLinks.map(link => (
        <a href={link.href} class="relative group flex flex-col items-center text-center pb-1.5">
          <span class="lang-en font-serif text-sm xl:text-base font-semibold text-primary-dark group-hover:text-accent-gold transition-colors duration-200 leading-none">
            {link.name}
          </span>
          <span class="lang-ml font-malayalam text-sm xl:text-base font-semibold text-primary-dark group-hover:text-accent-gold transition-colors duration-200 leading-none">
            {link.ml}
          </span>
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-accent-gold transition-all duration-300 group-hover:w-full rounded-full"></span>
        </a>
      ))}
    </div>

    <!-- Right: mobile hamburger / call button + desktop elements -->
    <div class="flex items-center gap-2.5 sm:gap-3.5">
      <!-- Circular Call Button (mobile only) -->
      <a href="tel:+910000000000" class="flex lg:hidden w-10 h-10 rounded-full border border-primary-dark/20 items-center justify-center text-primary-dark hover:bg-primary-dark/5 transition-colors" aria-label="Call Hospital">
        <Phone size={18} />
      </a>

      <!-- Circular Hamburger Button (mobile only) -->
      <button id="menu-toggle" class="flex lg:hidden w-10 h-10 rounded-full border border-primary-dark/20 items-center justify-center text-primary-dark hover:bg-primary-dark/5 transition-colors" aria-label="Toggle Menu">
        <Menu size={20} />
      </button>

      <!-- Book Now (desktop / tablet only) -->
      <a href="/appointment" class="hidden sm:flex flex-col items-center btn-primary scale-90 leading-tight !py-1.5">
        <span class="lang-en font-sans font-semibold tracking-wide">Book Now</span>
        <span class="lang-ml font-malayalam font-semibold normal-case tracking-normal">ഇപ്പോൾ ബുക്ക്</span>
      </a>
    </div>
  </nav>

  <!-- ── Premium Mobile Menu Sidebar ── -->
  <div id="mobile-menu" class="fixed inset-0 z-[60] lg:hidden pointer-events-none">
    
    <!-- Backdrop (The darkened overlay) -->
    <div id="mobile-menu-backdrop" class="absolute inset-0 bg-black/50 opacity-0 transition-opacity duration-300 ease-out"></div>
    
    <!-- Slide-out Panel (Clean white side drawer) -->
    <div id="mobile-menu-panel" class="absolute top-0 right-0 w-[85%] sm:w-[380px] h-full bg-white shadow-[-5px_0_25px_-5px_rgba(0,0,0,0.15)] translate-x-full transition-transform duration-300 ease-out flex flex-col">
      
      <!-- Brand Section at the top (White bg) -->
      <div class="p-6 bg-white border-b border-accent-gold/15 flex flex-col gap-4 relative">
        <div class="flex justify-between items-center">
          <!-- Logo & Brand Info -->
          <div class="flex items-center gap-3">
             <img src="/vmfaviconpng.png" class="w-12 h-12 rounded-full border-2 border-accent-gold shadow-md" alt="Vaidyarmandiram Logo" />
             <div class="flex flex-col">
               <span class="lang-en text-base font-serif font-bold text-primary-dark tracking-wide uppercase">Vaidyarmandiram</span>
               <span class="lang-ml font-malayalam text-base font-bold text-primary-dark">വൈദ്യർമന്ദിരം</span>
               <span class="lang-en text-[9px] font-sans text-accent-gold font-bold uppercase tracking-wider">Ayurvedic Healing Centre</span>
               <span class="lang-ml font-malayalam text-[10px] text-accent-gold font-bold">ആയുർവേദിക് ഹീലിംഗ് സെന്റർ</span>
             </div>
          </div>
          <!-- Close Button -->
          <button id="menu-close" class="w-9 h-9 rounded-full bg-primary/5 flex items-center justify-center text-primary-dark hover:bg-primary-dark hover:text-white transition-colors border border-primary-dark/10" aria-label="Close Menu">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <!-- Language toggle beautifully integrated -->
        <div class="flex justify-end items-center gap-2">
          <span class="lang-en text-[10px] font-sans text-text-muted font-bold tracking-wider uppercase">Language:</span>
          <span class="lang-ml font-malayalam text-xs text-text-muted font-bold">ഭാഷ:</span>
          <button
            id="lang-switch-drawer"
            class="px-2.5 py-1 text-[11px] font-bold border-2 border-primary-dark rounded-full text-primary-dark hover:bg-primary-dark hover:text-white transition-all duration-200 font-sans"
            aria-label="Switch language"
          >മാ</button>
        </div>
      </div>

      <!-- Navigation Links (Large and readable, white background) -->
      <div class="flex-1 overflow-y-auto min-h-0 px-6 py-6 flex flex-col gap-1 bg-white">
        {navLinks.map(link => (
          <a href={link.href} class="flex items-center justify-between group border-b border-accent-gold/5 py-4 last:border-0">
            <div class="flex flex-col gap-0.5">
              <span class="lang-en font-serif text-xl sm:text-2xl text-primary-dark group-hover:text-accent-gold transition-colors duration-200">
                {link.name === 'About' ? 'About Us' : link.name}
              </span>
              <span class="lang-ml font-malayalam text-lg sm:text-xl text-primary-dark/85 group-hover:text-accent-gold transition-colors duration-200">
                {link.ml}
              </span>
            </div>
            <span class="text-primary-dark/30 group-hover:text-accent-gold group-hover:translate-x-1.5 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </span>
          </a>
        ))}
      </div>

      <!-- Contact Info Block (Location + Phone) -->
      <div class="px-6 py-5 border-t border-accent-gold/15 bg-white flex flex-col gap-3">
        <div class="flex items-start gap-2.5 text-xs text-text-muted">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-gold mt-0.5 shrink-0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          <div class="flex flex-col">
            <span class="lang-en font-sans font-bold text-[10px] uppercase tracking-wider text-primary-dark">Location</span>
            <span class="lang-ml font-malayalam font-bold text-xs text-primary-dark">സ്ഥലം</span>
            <span class="lang-en font-sans mt-0.5 text-text-muted">Main Road, Malappuram, Kerala</span>
            <span class="lang-ml font-malayalam mt-0.5 text-text-muted">മെയിൻ റോഡ്, മലപ്പുറം, കേരളം</span>
          </div>
        </div>
        <div class="flex items-center gap-2.5 text-xs text-text-muted">
          <Phone size={14} class="text-accent-gold" />
          <div class="flex flex-col">
            <span class="lang-en font-sans font-bold text-[10px] uppercase tracking-wider text-primary-dark">Phone</span>
            <span class="lang-ml font-malayalam font-bold text-xs text-primary-dark">ഫോൺ</span>
            <a href="tel:+910000000000" class="font-sans text-text-muted hover:underline mt-0.5 font-bold">+91 000 000 0000</a>
          </div>
        </div>
      </div>

      <!-- Sticky Footer CTA (Book Appointment rounded button) -->
      <div class="p-6 border-t border-accent-gold/15 bg-white">
        <a href="/appointment" class="w-full btn-primary !bg-primary-dark !text-background-parchment text-center py-4 flex flex-col items-center justify-center rounded-full shadow-md hover:-translate-y-0.5 hover:shadow-lg transition-all duration-300">
          <span class="lang-en font-sans font-bold text-sm tracking-widest uppercase">Book Appointment</span>
          <span class="lang-ml font-malayalam font-bold text-sm mt-0.5">അപ്പോയിന്റ്മെന്റ് ബുക്ക് ചെയ്യുക</span>
        </a>
      </div>
    </div>
  </div>

</header>

<script>
  // ── Language Toggle ─────────────────────────────────────────────
  function applyLang(lang: string) {
    document.documentElement.setAttribute('data-lang', lang);
    localStorage.setItem('vm-lang', lang);

    const oppositeLabel = lang === 'en' ? 'മാ' : 'E';
    const oppositeTarget = lang === 'en' ? 'ml' : 'en';

    document.querySelectorAll<HTMLButtonElement>('[id^="lang-switch"]').forEach(btn => {
      btn.textContent = oppositeLabel;
      btn.dataset.target = oppositeTarget;
      btn.setAttribute('aria-label', `Switch to ${lang === 'en' ? 'Malayalam' : 'English'}`);
    });
  }

  function setupLang() {
    const saved = localStorage.getItem('vm-lang') || 'en';
    applyLang(saved);

    document.querySelectorAll<HTMLButtonElement>('[id^="lang-switch"]').forEach(btn => {
      const newBtn = btn.cloneNode(true) as HTMLButtonElement;
      btn.parentNode?.replaceChild(newBtn, btn);
      newBtn.addEventListener('click', () => applyLang(newBtn.dataset.target || 'ml'));
    });
  }

  // ── Mobile Menu Sidebar Logic ─────────────────────────────────────
  function setupMenu() {
    const menuToggle = document.getElementById('menu-toggle');
    const menuClose  = document.getElementById('menu-close');
    const mobileMenu = document.getElementById('mobile-menu');
    const backdrop   = document.getElementById('mobile-menu-backdrop');
    const panel      = document.getElementById('mobile-menu-panel');

    if (!menuToggle || !menuClose || !mobileMenu || !backdrop || !panel) return;

    const openMenu = () => { 
      mobileMenu.classList.remove('pointer-events-none');
      backdrop.classList.remove('opacity-0');
      panel.classList.remove('translate-x-full');
      document.body.classList.add('overflow-hidden'); 
    };

    const closeMenu = () => { 
      backdrop.classList.add('opacity-0');
      panel.classList.add('translate-x-full');
      document.body.classList.remove('overflow-hidden'); 
      setTimeout(() => {
        mobileMenu.classList.add('pointer-events-none');
      }, 300); // Wait for 0.3s transition
    };

    menuToggle.onclick = openMenu;
    menuClose.onclick  = closeMenu;
    backdrop.onclick   = closeMenu;
    
    panel.querySelectorAll('a').forEach(link => { 
      link.onclick = closeMenu; 
    });
  }

  // Run on initial page load
  setupLang();
  setupMenu();

  // Re-run after every Astro View Transition
  document.addEventListener('astro:after-swap', () => { 
    setupLang(); 
    setupMenu(); 
  });
</script>
