<script>
  // ── Language Toggle ─────────────────────────────────────────────
  function applyLang(lang: string) {
    document.documentElement.setAttribute('data-lang', lang);
    localStorage.setItem('vm-lang', lang);

    const oppositeLabel = lang === 'en' ? 'മലയാളം' : 'ENGLISH';
    const oppositeTarget = lang === 'en' ? 'ml' : 'en';

    document.querySelectorAll<HTMLButtonElement>('[id^="lang-switch"]').forEach(btn => {
      const labelSpan = btn.querySelector('.lang-label');
      if (labelSpan) {
        labelSpan.textContent = oppositeLabel;
        if (lang === 'en') {
          labelSpan.classList.remove('font-sans');
          labelSpan.classList.add('font-malayalam');
        } else {
          labelSpan.classList.remove('font-malayalam');
          labelSpan.classList.add('font-sans');
        }
      } else {
        btn.textContent = oppositeLabel;
      }
      
      btn.dataset.target = oppositeTarget;
      btn.setAttribute('aria-label', `Switch to ${lang === 'en' ? 'Malayalam' : 'English'}`);
    });
  }

  function setupLang() {
    const saved = localStorage.getItem('vm-lang') || 'en';
    applyLang(saved);

    document.querySelectorAll<HTMLButtonElement>('[id^="lang-switch"]').forEach(btn => {
      const newBtn = btn.cloneNode(true) as HTMLButtonElement;
      btn.parentNode?.replaceChild(newBtn, btn);
      newBtn.addEventListener('click', () => applyLang(newBtn.dataset.target || 'ml'));
    });
  }

  // ── Mobile Menu Sidebar Logic ─────────────────────────────────────
  function setupMenu() {
    const menuToggle = document.getElementById('menu-toggle');
    const menuClose  = document.getElementById('menu-close');
    const mobileMenu = document.getElementById('mobile-menu');
    const backdrop   = document.getElementById('mobile-menu-backdrop');
    const panel      = document.getElementById('mobile-menu-panel');

    if (!menuToggle || !menuClose || !mobileMenu || !backdrop || !panel) return;

    const openMenu = () => { 
      mobileMenu.classList.remove('pointer-events-none');
      backdrop.classList.remove('opacity-0');
      panel.classList.remove('translate-x-full');
      document.body.classList.add('overflow-hidden'); 
    };

    const closeMenu = () => { 
      backdrop.classList.add('opacity-0');
      panel.classList.add('translate-x-full');
      document.body.classList.remove('overflow-hidden'); 
      setTimeout(() => {
        mobileMenu.classList.add('pointer-events-none');
      }, 300); // Wait for 0.3s transition
    };

    menuToggle.onclick = openMenu;
    menuClose.onclick  = closeMenu;
    backdrop.onclick   = closeMenu;
    
    panel.querySelectorAll('a').forEach(link => { 
      link.onclick = closeMenu; 
    });
  }

  // Run on initial page load
  setupLang();
  setupMenu();

  // Re-run after every Astro View Transition
  document.addEventListener('astro:after-swap', () => { 
    setupLang(); 
    setupMenu(); 
  });
</script>

<style>
