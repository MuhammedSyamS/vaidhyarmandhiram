---
---

<div id="splash-intro" class="fixed inset-0 z-[9999] bg-gradient-to-br from-primary-dark via-[#092218] to-primary-dark flex flex-col items-center justify-center overflow-hidden transition-all duration-1000 ease-in-out">
  <!-- Glowing Gold Aura in the background -->
  <div class="absolute w-[450px] h-[450px] rounded-full bg-accent-gold/10 blur-[120px] -z-10 animate-pulse-slow"></div>

  <!-- Ambient Light Particles -->
  <div class="absolute inset-0 pointer-events-none -z-10">
    <div class="absolute top-[15%] left-[20%] w-2 h-2 rounded-full bg-accent-gold/40 blur-[1px] animate-float-slow"></div>
    <div class="absolute bottom-[25%] right-[20%] w-3 h-3 rounded-full bg-accent-gold/30 blur-[2px] animate-float-medium"></div>
    <div class="absolute top-[65%] right-[25%] w-1.5 h-1.5 rounded-full bg-accent-gold/50 blur-[1px] animate-float-fast"></div>
  </div>

  <!-- Premium Frosted Glass Card Container -->
  <div class="relative flex flex-col items-center max-w-sm w-[90%] px-8 py-12 text-center select-none bg-white/[0.03] backdrop-blur-xl border border-white/10 rounded-3xl shadow-[0_25px_60px_rgba(0,0,0,0.4)] animate-card-reveal">
    
    <!-- Thin Gold Decorative Frame Corners -->
    <div class="absolute top-4 left-4 w-4 h-4 border-t border-l border-accent-gold/30 rounded-tl-md"></div>
    <div class="absolute top-4 right-4 w-4 h-4 border-t border-r border-accent-gold/30 rounded-tr-md"></div>
    <div class="absolute bottom-4 left-4 w-4 h-4 border-b border-l border-accent-gold/30 rounded-bl-md"></div>
    <div class="absolute bottom-4 right-4 w-4 h-4 border-b border-r border-accent-gold/30 rounded-br-md"></div>

    <!-- Main Emblem Container -->
    <div class="relative mb-6 animate-logo-reveal flex items-center justify-center">
      <!-- Luxury Rotating Gold Dashed Rings -->
      <div class="absolute -inset-4 rounded-full border border-accent-gold/30 border-dashed animate-spin-slow"></div>
      <div class="absolute -inset-7 rounded-full border border-accent-gold/10 animate-spin-reverse-slow"></div>
      
      <!-- Premium Logo Image -->
      <div class="relative z-10 w-24 h-24 md:w-28 md:h-28 rounded-full overflow-hidden border-2 border-accent-gold shadow-[0_0_40px_rgba(184,134,11,0.25)] bg-[#1B4332]">
        <img 
          src="/vmfaviconpng.png" 
          alt="Vaidyarmandiram Emblem" 
          class="w-full h-full object-cover scale-[1.02]"
        />
      </div>
    </div>

    <!-- Typography Sequence -->
    <div class="space-y-4 relative z-10 w-full">
      <div class="flex flex-col gap-1.5">
        <!-- English Main Title -->
        <h1 class="text-2xl md:text-3xl text-background-parchment tracking-[0.25em] uppercase font-serif font-bold animate-text-reveal leading-none">
          Vaidyarmandiram
        </h1>
        <!-- Malayalam Translation -->
        <span class="text-lg font-malayalam text-background-parchment/90 font-bold opacity-0 animate-ml-text-reveal">
          വൈദ്യർമന്ദിരം
        </span>
      </div>
      
      <!-- Slim golden horizontal divider -->
      <div class="h-[1px] w-0 bg-gradient-to-r from-transparent via-accent-gold to-transparent mx-auto animate-divider-expand"></div>
      
      <!-- Subtitle -->
      <p class="text-[9px] md:text-xs font-sans text-accent-gold tracking-[0.4em] uppercase opacity-0 animate-subtitle-reveal font-semibold">
        Ayurveda Hospital
      </p>
    </div>

    <!-- Thin elegant loading bar progress indicator -->
    <div class="absolute bottom-0 left-[12%] right-[12%] h-[2px] bg-white/10 overflow-hidden rounded-full mb-6">
      <div class="h-full bg-gradient-to-r from-accent-gold/60 to-accent-gold w-0 animate-loading-bar"></div>
    </div>

  </div>
</div>

<script>
  function setupSplash() {
    const splash = document.getElementById('splash-intro');
    if (!splash) return;

    // Check if splash has already been shown in this session
    const hasShown = sessionStorage.getItem('splash-shown');
    if (hasShown) {
      splash.style.display = 'none';
      splash.remove();
      return;
    }

    // Dismiss splash after the premium intro finishes
    setTimeout(() => {
      splash.style.opacity = '0';
      splash.style.visibility = 'hidden';
      splash.style.transform = 'scale(1.05) translateY(-5px)';
      
      sessionStorage.setItem('splash-shown', 'true');
      
      setTimeout(() => {
        splash.remove();
      }, 1000);
    }, 2400); // 2.4 seconds is the sweet spot for elegance and speed
  }

  // Run on first load
  setupSplash();

  // Re-run safely on View Transitions
  document.addEventListener('astro:page-load', setupSplash);
</script>

<style>
  /* Base Reveal Animations */
  @keyframes card-reveal {
    0% { transform: scale(0.96); opacity: 0; filter: blur(5px); }
    100% { transform: scale(1); opacity: 1; filter: blur(0); }
  }

  @keyframes logo-reveal {
    0% { transform: scale(0.8) translateY(15px); opacity: 0; filter: blur(3px); }
    100% { transform: scale(1) translateY(0); opacity: 1; filter: blur(0); }
  }

  @keyframes text-reveal {
    0% { transform: translateY(10px); opacity: 0; letter-spacing: 0.1em; }
    100% { transform: translateY(0); opacity: 1; letter-spacing: 0.25em; }
  }

  @keyframes ml-text-reveal {
    0% { transform: translateY(5px); opacity: 0; }
    100% { transform: translateY(0); opacity: 0.9; }
  }

  @keyframes divider-expand {
    0% { width: 0; }
    100% { width: 60%; }
  }

  @keyframes subtitle-reveal {
    0% { opacity: 0; transform: translateY(5px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes loading-bar {
    0% { width: 0%; }
    100% { width: 100%; }
  }

  /* Rotation animations */
  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes spin-reverse-slow {
    from { transform: rotate(360deg); }
    to { transform: rotate(0deg); }
  }

  /* Floating particle animations */
  @keyframes float-slow {
    0%, 100% { transform: translateY(0) translateX(0); opacity: 0.2; }
    50% { transform: translateY(-15px) translateX(8px); opacity: 0.6; }
  }

  @keyframes float-medium {
    0%, 100% { transform: translateY(0) translateX(0); opacity: 0.3; }
    50% { transform: translateY(-25px) translateX(-10px); opacity: 0.7; }
  }

  @keyframes float-fast {
    0%, 100% { transform: translateY(0) translateX(0); opacity: 0.4; }
    50% { transform: translateY(-12px) translateX(5px); opacity: 0.8; }
  }

  @keyframes pulse-slow {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50% { opacity: 0.7; transform: scale(1.1); }
  }

  /* Class triggers */
  .animate-card-reveal {
    animation: card-reveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .animate-logo-reveal {
    animation: logo-reveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .animate-text-reveal {
    animation: text-reveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards 0.2s;
  }

  .animate-ml-text-reveal {
    animation: ml-text-reveal 1s ease-out forwards 0.5s;
  }

  .animate-divider-expand {
    animation: divider-expand 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards 0.7s;
  }

  .animate-subtitle-reveal {
    animation: subtitle-reveal 1s ease-out forwards 1.2s;
  }

  .animate-loading-bar {
    animation: loading-bar 2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .animate-spin-slow {
    animation: spin-slow 20s linear infinite;
  }

  .animate-spin-reverse-slow {
    animation: spin-reverse-slow 24s linear infinite;
  }

  .animate-float-slow {
    animation: float-slow 6s ease-in-out infinite;
  }

  .animate-float-medium {
    animation: float-medium 5s ease-in-out infinite;
  }

  .animate-float-fast {
    animation: float-fast 4s ease-in-out infinite;
  }

  .animate-pulse-slow {
    animation: pulse-slow 3s ease-in-out infinite;
  }
</style>
