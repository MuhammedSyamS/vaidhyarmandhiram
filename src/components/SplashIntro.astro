---
// SplashIntro Component: Centered portal page that acts as the initial launch screen.
---

<div id="splash-intro" class="fixed inset-0 z-[9999] bg-background-parchment flex flex-col items-center justify-center overflow-hidden transition-all duration-1000 ease-out select-none" style="background-image: url('https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/parchment-texture.svg'); background-repeat: repeat;">
  
  <!-- Centered Content Wrapper with Fade-in Entry -->
  <div class="relative z-10 w-full h-full flex flex-col items-center justify-center text-center animate-page-reveal p-4">
    
    <!-- Golden Rings -->
    <div id="splash-rings" class="absolute w-[95vw] max-w-[460px] aspect-square rounded-full border-[1px] border-accent-gold/30 animate-rings pointer-events-none transition-all duration-1000 z-0"></div>
    <div id="splash-rings-inner" class="absolute w-[90vw] max-w-[440px] aspect-square rounded-full border-[1px] border-dashed border-accent-gold/40 animate-rings-inner pointer-events-none transition-all duration-1000 z-0"></div>

    <!-- Main Image Display (Borderless, premium rounded corners) -->
    <div id="splash-logo-container" class="relative animate-logo-reveal flex items-center justify-center cursor-pointer z-10">
      <img 
        src="https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/vmlaunchingpage.png" 
        alt="Vaidyarmandiram Launching" 
        class="w-[85vw] max-w-[420px] aspect-square object-cover rounded-full shadow-[0_20px_50px_rgba(0,0,0,0.15)] hover:scale-[1.02] transition-transform duration-500"
      />
    </div>



  </div>
</div>


<script>
  function setupSplash() {
    const splash = document.getElementById('splash-intro');
    if (!splash) return;

    // Ensure it only runs once per actual full page load/view transition sequence
    if ((window as any).__SPLASH_SHOWN__) {
      splash.style.display = 'none';
      splash.remove();
      return;
    }
    (window as any).__SPLASH_SHOWN__ = true;

    // Detect reload using modern navigation entries API and legacy fallback
    const navigationEntries = performance.getEntriesByType('navigation');
    let isReload = false;
    if (navigationEntries.length > 0) {
      isReload = (navigationEntries[0] as any).type === 'reload';
    } else if (window.performance && window.performance.navigation) {
      isReload = window.performance.navigation.type === 1;
    }

    // const hasShownInSession = sessionStorage.getItem('splash-shown') === 'true';

    // Show splash if it is a reload OR if it hasn't been shown in this session yet
    // if (!isReload && hasShownInSession) {
    //   splash.style.display = 'none';
    //   splash.remove();
    //   return;
    // }

    let isDismissing = false;
    let autoDismissTimeout: any;

    const dismissSplash = () => {
      if (isDismissing) return;
      isDismissing = true;
      if (autoDismissTimeout) clearTimeout(autoDismissTimeout);

      const logoContainer = document.getElementById('splash-logo-container');
      const navLogo = document.getElementById('nav-logo-img');

      if (logoContainer && navLogo) {
        // Stop breathing animation so transform works natively
        logoContainer.style.animation = 'none';
        
        // Ensure image inside also adapts if needed, though container scaling is enough
        const img = logoContainer.querySelector('img');
        if (img) img.style.borderRadius = '50%';

        const rings = document.getElementById('splash-rings');
        const ringsInner = document.getElementById('splash-rings-inner');
        
        if (rings) {
          rings.style.transform = 'scale(1.5)';
          rings.style.opacity = '0';
        }
        if (ringsInner) {
          ringsInner.style.transform = 'scale(1.3)';
          ringsInner.style.opacity = '0';
        }
        
        const rectSplash = logoContainer.getBoundingClientRect();
        const rectNav = navLogo.getBoundingClientRect();
        
        // Calculate scale and translation based on centers
        const scale = rectNav.width / rectSplash.width;
        
        const splashCenterX = rectSplash.left + rectSplash.width / 2;
        const splashCenterY = rectSplash.top + rectSplash.height / 2;
        const navCenterX = rectNav.left + rectNav.width / 2;
        const navCenterY = rectNav.top + rectNav.height / 2;
        
        const deltaX = navCenterX - splashCenterX;
        const deltaY = navCenterY - splashCenterY;

        // Animate the logo to navbar
        logoContainer.style.transition = 'all 1s cubic-bezier(0.85, 0, 0.15, 1)';
        logoContainer.style.transform = `translate(${deltaX}px, ${deltaY}px) scale(${scale})`;
        
        // Fade out background texture seamlessly
        splash.style.transition = 'background-color 1s ease, opacity 1s ease';
        splash.style.backgroundColor = 'transparent';
        splash.style.backgroundImage = 'none';
        splash.style.pointerEvents = 'none';
      } else {
        // Fallback if nav is missing
        splash.style.opacity = '0';
        splash.style.visibility = 'hidden';
        splash.style.transform = 'translateY(-100%)';
      }
      
      sessionStorage.setItem('splash-shown', 'true');
      
      setTimeout(() => {
        splash.style.opacity = '0';
        setTimeout(() => splash.remove(), 300);
      }, 800);
    };

    // Auto-dismiss after 3 seconds
    autoDismissTimeout = setTimeout(() => {
      dismissSplash();
    }, 3000);

    // Click anywhere to dismiss splash (Disabled to ensure it stays visible)
    // splash.addEventListener('click', dismissSplash);

    // Scroll Indicator trigger
    const scrollInd = document.getElementById('splash-scroll-indicator');
    if (scrollInd) scrollInd.onclick = dismissSplash;

    // Touch gesture triggers
    let startY = 0;
    window.addEventListener('touchstart', (e) => {
      startY = e.touches[0].clientY;
    }, { passive: true });

    window.addEventListener('touchmove', (e) => {
      if (isDismissing) return;
      const currentY = e.touches[0].clientY;
      // Swipe up with higher threshold (80px) to prevent accidental triggers
      if (startY - currentY > 80) {
        dismissSplash();
      }
    }, { passive: true });
  }

  // Run on first load
  setupSplash();

  // Re-run safely on View Transitions
  document.addEventListener('astro:page-load', setupSplash);
</script>

<style>
  /* ── Custom Animations ── */
  
  /* Page Reveal Container */
  @keyframes page-reveal {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }

  /* Logo Reveal Entry */
  @keyframes logo-reveal {
    0% { 
      transform: scale(0.5); 
      opacity: 0; 
      filter: blur(20px) drop-shadow(0 0 0 rgba(0,0,0,0)); 
    }
    100% { 
      transform: scale(1); 
      opacity: 1; 
      filter: blur(0) drop-shadow(0 15px 30px rgba(0,0,0,0.06)); 
    }
  }

  /* Logo Breathe Loop */
  @keyframes logo-breathe {
    0%, 100% { 
      transform: scale(1); 
      filter: drop-shadow(0 15px 30px rgba(0,0,0,0.06));
    }
    50% { 
      transform: scale(1.04); 
      filter: drop-shadow(0 20px 40px rgba(0,0,0,0.09));
    }
  }

  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes spin-reverse-slow {
    from { transform: rotate(360deg); }
    to { transform: rotate(0deg); }
  }

  /* Trigger Classes */
  .animate-page-reveal {
    animation: page-reveal 1s ease-out forwards;
  }
  
  .animate-logo-reveal {
    animation: 
      logo-reveal 1.6s cubic-bezier(0.16, 1, 0.3, 1) forwards,
      logo-breathe 4s ease-in-out infinite 1.6s;
  }

  @keyframes rings-reveal {
    from { opacity: 0; transform: scale(0.8); }
    to { opacity: 1; transform: scale(1); }
  }
  @keyframes text-reveal {
    from { opacity: 0; transform: translateY(20px); filter: blur(10px); }
    to { opacity: 1; transform: translateY(0); filter: blur(0); }
  }

  .animate-rings {
    animation: rings-reveal 1.5s ease-out forwards, spin-slow 30s linear infinite;
  }
  .animate-rings-inner {
    animation: rings-reveal 1.5s ease-out forwards, spin-reverse-slow 25s linear infinite;
  }
  .animate-text-reveal {
    animation: text-reveal 1.2s ease-out forwards;
    animation-delay: 0.8s;
    opacity: 0;
  }

  .animate-spin-slow {
    animation: spin-slow 22s linear infinite;
  }

  .animate-spin-reverse-slow {
    animation: spin-reverse-slow 26s linear infinite;
  }
</style>
