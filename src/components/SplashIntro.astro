---

<div id="splash-intro" class="fixed inset-0 z-[9999] bg-primary-dark flex flex-col items-center justify-center overflow-hidden transition-all duration-1000 ease-in-out">
  <div class="relative flex flex-col items-center">
    <!-- Animated Logo/Text -->
    <div class="text-center space-y-4 animate-reveal">
      <h1 class="text-2xl md:text-6xl font-serif text-background-parchment tracking-[0.2em] uppercase font-bold px-4">
        Vaidyarmandhiram
      </h1>
      <div class="h-[1px] w-0 bg-accent-gold mx-auto animate-line-expand"></div>
      <p class="text-xs md:text-base font-sans text-accent-gold tracking-[0.5em] uppercase opacity-0 animate-fade-in-delayed">
        Ayurveda Hospital
      </p>
    </div>

    <!-- Decorative Elements -->
    <div class="absolute -z-10 opacity-10">
      <svg width="400" height="400" viewBox="0 0 100 100" class="animate-slow-spin">
        <circle cx="50" cy="50" r="45" stroke="currentColor" fill="none" stroke-width="0.5" class="text-accent-gold" />
        <path d="M50 5 L50 95 M5 50 L95 50" stroke="currentColor" stroke-width="0.2" class="text-accent-gold" />
      </svg>
    </div>
  </div>
</div>

<script>
  // Handle splash screen dismissal
  function initSplash() {
    const splash = document.getElementById('splash-intro');
    if (!splash) return;

    // Check if splash has already been shown in this session
    const hasShown = sessionStorage.getItem('splash-shown');
    
    if (hasShown) {
      splash.style.display = 'none';
      splash.remove();
      return;
    }

    // Small delay to ensure animations finish
    setTimeout(() => {
      splash.style.opacity = '0';
      splash.style.visibility = 'hidden';
      splash.style.transform = 'scale(1.1)';
      
      // Mark as shown
      sessionStorage.setItem('splash-shown', 'true');
      
      // Remove from DOM after transition
      setTimeout(() => {
        splash.remove();
      }, 1000);
    }, 2000); // Reduced to 2 seconds for better UX
  }

  // Run on initial load
  initSplash();

  // Handle ViewTransitions (though splash is usually only on first entry)
  document.addEventListener('astro:page-load', initSplash);
</script>

<style>
  @keyframes reveal {
    0% { transform: translateY(20px); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }

  @keyframes line-expand {
    0% { width: 0; }
    100% { width: 100%; }
  }

  @keyframes fade-in-delayed {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }

  @keyframes slow-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .animate-reveal {
    animation: reveal 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .animate-line-expand {
    animation: line-expand 1.5s cubic-bezier(0.22, 1, 0.36, 1) forwards 0.5s;
  }

  .animate-fade-in-delayed {
    animation: fade-in-delayed 1s ease-out forwards 1.2s;
  }

  .animate-slow-spin {
    animation: slow-spin 20s linear infinite;
  }
</style>
