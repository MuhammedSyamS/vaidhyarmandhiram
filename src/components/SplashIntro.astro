---
// SplashIntro Component: Centered portal page that acts as the initial launch screen.
---

<div id="splash-intro" class="fixed inset-0 z-[9999] bg-white flex flex-col items-center justify-center overflow-hidden transition-all duration-1000 ease-out select-none">
  
  <!-- Centered Content Wrapper with Fade-in Entry -->
  <div class="relative z-10 max-w-4xl px-6 flex flex-col items-center text-center animate-page-reveal">
    
    <!-- Main Logo Display -->
    <div class="relative animate-logo-reveal flex items-center justify-center">
      <div class="w-64 h-64 sm:w-80 sm:h-80 flex items-center justify-center">
        <img 
          src="/vmfaviconpng.png" 
          alt="Vaidhyar Mandhiram Logo" 
          class="w-full h-full object-contain animate-pulse-slow"
        />
      </div>
    </div>

  </div>
</div>

<script>
  function setupSplash() {
    const splash = document.getElementById('splash-intro');
    if (!splash) return;

    // Check if splash has already been shown in this session
    const hasShown = sessionStorage.getItem('splash-shown');
    const isReload = performance.getEntriesByType('navigation')[0]?.type === 'reload';
    if (hasShown && !isReload) {
      splash.style.display = 'none';
      splash.remove();
      return;
    }

    let isDismissing = false;
    let autoDismissTimeout;

    const dismissSplash = () => {
      if (isDismissing) return;
      isDismissing = true;
      if (autoDismissTimeout) clearTimeout(autoDismissTimeout);

      splash.style.opacity = '0';
      splash.style.visibility = 'hidden';
      splash.style.transform = 'translateY(-100%)'; // Elegantly slide up
      
      sessionStorage.setItem('splash-shown', 'true');
      
      setTimeout(() => {
        splash.remove();
      }, 1000);
    };

    // Auto-dismiss after 3.8 seconds
    autoDismissTimeout = setTimeout(() => {
      dismissSplash();
    }, 3800);

    // Scroll Indicator trigger
    const scrollInd = document.getElementById('splash-scroll-indicator');
    if (scrollInd) scrollInd.onclick = dismissSplash;

    // Scroll gesture / wheel triggers
    const onScrollOrGesture = (e) => {
      if (isDismissing) return;
      // Scroll down
      if (e.deltaY > 5) {
        dismissSplash();
      }
    };

    window.addEventListener('wheel', onScrollOrGesture, { passive: true });

    // Touch gesture triggers
    let startY = 0;
    window.addEventListener('touchstart', (e) => {
      startY = e.touches[0].clientY;
    }, { passive: true });

    window.addEventListener('touchmove', (e) => {
      if (isDismissing) return;
      const currentY = e.touches[0].clientY;
      // Swipe up
      if (startY - currentY > 30) {
        dismissSplash();
      }
    }, { passive: true });
  }

  // Run on first load
  setupSplash();

  // Re-run safely on View Transitions
  document.addEventListener('astro:page-load', setupSplash);
</script>

<style>
  /* ── Custom Animations ── */
  
  /* Page Reveal Container */
  @keyframes page-reveal {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }

  /* Logo Reveal */
  @keyframes logo-reveal {
    0% { transform: scale(0.85) translateY(20px); opacity: 0; filter: blur(4px); }
    100% { transform: scale(1) translateY(0); opacity: 1; filter: blur(0); }
  }

  /* Name Heading Reveal */
  @keyframes text-reveal {
    0% { transform: translateY(15px); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }

  /* Divider Expand */
  @keyframes divider-expand {
    0% { width: 0; }
    100% { width: 50%; }
  }

  /* Tagline Subtitle Reveal */
  @keyframes subtitle-reveal {
    0% { transform: translateY(10px); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }

  /* Action Buttons Slide and Fade Up */
  @keyframes buttons-reveal {
    0% { transform: translateY(15px); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }

  /* Scroll Arrow Indicator Reveal */
  @keyframes scroll-reveal {
    0% { opacity: 0; transform: translate(-50%, 10px); }
    100% { opacity: 0.65; transform: translate(-50%, 0); }
  }

  /* Floating Animations for leaves */
  @keyframes float-slow {
    0%, 100% { transform: translateY(0) rotate(12deg) scale(0.75); }
    50% { transform: translateY(-12px) rotate(16deg) scale(0.8); }
  }

  @keyframes float-medium {
    0%, 100% { transform: translateY(0) rotate(-45deg) scale(0.9); }
    50% { transform: translateY(-16px) rotate(-40deg) scale(0.95); }
  }

  @keyframes pulse-slow {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50% { opacity: 0.7; transform: scale(1.1); }
  }

  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes spin-reverse-slow {
    from { transform: rotate(360deg); }
    to { transform: rotate(0deg); }
  }

  /* Trigger Classes */
  .animate-page-reveal {
    animation: page-reveal 1s ease-out forwards;
  }
  
  .animate-logo-reveal {
    animation: logo-reveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .animate-text-reveal {
    animation: text-reveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards 0.2s;
  }

  .animate-divider-expand {
    animation: divider-expand 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards 0.6s;
  }

  .animate-subtitle-reveal {
    animation: subtitle-reveal 1.2s ease-out forwards 1s;
  }

  .animate-buttons-reveal {
    animation: buttons-reveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards 1.4s;
  }

  .animate-scroll-reveal {
    animation: scroll-reveal 1s ease-out forwards 2.5s;
  }

  .animate-float-slow {
    animation: float-slow 6s ease-in-out infinite;
  }

  .animate-float-medium {
    animation: float-medium 7s ease-in-out infinite;
  }

  .animate-spin-slow {
    animation: spin-slow 22s linear infinite;
  }

  .animate-spin-reverse-slow {
    animation: spin-reverse-slow 26s linear infinite;
  }
</style>
