---
// SplashIntro Component: Centered portal page that acts as the initial launch screen.
---

<div id="splash-intro" class="fixed inset-0 z-[9999] bg-background-parchment flex flex-col items-center justify-center overflow-hidden transition-all duration-1000 ease-out select-none" style="background-image: url('/images/parchment-texture.svg'); background-repeat: repeat;">
  
  <!-- Centered Content Wrapper with Fade-in Entry -->
  <div class="relative z-10 w-full h-full flex flex-col items-center justify-center text-center animate-page-reveal p-4">
    
    <!-- Main Image Display (Centered, rounded frame displaying the entire logo perfectly) -->
    <div class="relative animate-logo-reveal w-[85vw] max-w-[420px] aspect-square flex items-center justify-center bg-white p-3 rounded-[2.5rem] shadow-[0_20px_50px_rgba(45,106,79,0.15)] border-2 border-accent-gold/25">
      <img 
        src="/images/vmlaunchingpage.jpeg" 
        alt="Vaidyarmandiram Launching" 
        class="w-full h-full object-contain rounded-[2rem]"
      />
    </div>

  </div>
</div>

<script>
  function setupSplash() {
    const splash = document.getElementById('splash-intro');
    if (!splash) return;

    // Ensure it only runs once per actual full page load/view transition sequence
    if (window.__SPLASH_SHOWN__) {
      splash.style.display = 'none';
      splash.remove();
      return;
    }
    window.__SPLASH_SHOWN__ = true;

    const navType = window.performance ? window.performance.navigation.type : 0;
    const isReload = navType === 1; // 1 is TYPE_RELOAD
    
    let isDirectEntry = true;
    if (document.referrer) {
      try {
        isDirectEntry = new URL(document.referrer).hostname !== window.location.hostname;
      } catch(e) {}
    }
    
    // Only show on Reload or Direct Entry (entering the website)
    if (!isReload && !isDirectEntry) {
      splash.style.display = 'none';
      splash.remove();
      return;
    }

    let isDismissing = false;
    let autoDismissTimeout;

    const dismissSplash = () => {
      if (isDismissing) return;
      isDismissing = true;
      if (autoDismissTimeout) clearTimeout(autoDismissTimeout);

      splash.style.opacity = '0';
      splash.style.visibility = 'hidden';
      splash.style.transform = 'translateY(-100%)'; // Elegantly slide up
      
      sessionStorage.setItem('splash-shown', 'true');
      
      setTimeout(() => {
        splash.remove();
      }, 1000);
    };

    // Auto-dismiss after 5.5 seconds
    autoDismissTimeout = setTimeout(() => {
      dismissSplash();
    }, 5500);

    // Scroll Indicator trigger
    const scrollInd = document.getElementById('splash-scroll-indicator');
    if (scrollInd) scrollInd.onclick = dismissSplash;

    // Scroll gesture / wheel triggers
    const onScrollOrGesture = (e) => {
      if (isDismissing) return;
      // Scroll down
      if (e.deltaY > 5) {
        dismissSplash();
      }
    };

    window.addEventListener('wheel', onScrollOrGesture, { passive: true });

    // Touch gesture triggers
    let startY = 0;
    window.addEventListener('touchstart', (e) => {
      startY = e.touches[0].clientY;
    }, { passive: true });

    window.addEventListener('touchmove', (e) => {
      if (isDismissing) return;
      const currentY = e.touches[0].clientY;
      // Swipe up
      if (startY - currentY > 30) {
        dismissSplash();
      }
    }, { passive: true });
  }

  // Run on first load
  setupSplash();

  // Re-run safely on View Transitions
  document.addEventListener('astro:page-load', setupSplash);
</script>

<style>
  /* ── Custom Animations ── */
  
  /* Page Reveal Container */
  @keyframes page-reveal {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }

  /* Logo Reveal Entry */
  @keyframes logo-reveal {
    0% { 
      transform: scale(0.5); 
      opacity: 0; 
      filter: blur(20px) drop-shadow(0 0 0 rgba(0,0,0,0)); 
    }
    100% { 
      transform: scale(1); 
      opacity: 1; 
      filter: blur(0) drop-shadow(0 15px 30px rgba(0,0,0,0.06)); 
    }
  }

  /* Logo Breathe Loop */
  @keyframes logo-breathe {
    0%, 100% { 
      transform: scale(1); 
      filter: drop-shadow(0 15px 30px rgba(0,0,0,0.06));
    }
    50% { 
      transform: scale(1.04); 
      filter: drop-shadow(0 20px 40px rgba(0,0,0,0.09));
    }
  }

  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes spin-reverse-slow {
    from { transform: rotate(360deg); }
    to { transform: rotate(0deg); }
  }

  /* Trigger Classes */
  .animate-page-reveal {
    animation: page-reveal 1s ease-out forwards;
  }
  
  .animate-logo-reveal {
    animation: 
      logo-reveal 1.6s cubic-bezier(0.16, 1, 0.3, 1) forwards,
      logo-breathe 4s ease-in-out infinite 1.6s;
  }

  .animate-spin-slow {
    animation: spin-slow 22s linear infinite;
  }

  .animate-spin-reverse-slow {
    animation: spin-reverse-slow 26s linear infinite;
  }
</style>
