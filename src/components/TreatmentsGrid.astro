---

<div class="relative w-full py-4 carousel-container">
  <!-- Navigation Arrows (Desktop) -->
  <button 
    id="treatments-prev-btn" 
    class="carousel-arrow absolute -left-2 lg:-left-6 top-1/2 -translate-y-1/2 z-30 hidden md:flex w-12 h-12 bg-white rounded-full shadow-lg items-center justify-center text-primary hover:bg-primary hover:text-white transition-all border border-gray-100 opacity-0 translate-x-4 duration-300"
    aria-label="Previous"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
  </button>
  
  <button 
    id="treatments-next-btn" 
    class="carousel-arrow absolute -right-2 lg:-right-6 top-1/2 -translate-y-1/2 z-30 hidden md:flex w-12 h-12 bg-white rounded-full shadow-lg items-center justify-center text-primary hover:bg-primary hover:text-white transition-all border border-gray-100 opacity-0 -translate-x-4 duration-300"
    aria-label="Next"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
    </svg>
  </button>

  <div
    id="treatments-scroll-container"
    class="treatments-carousel flex overflow-x-auto no-scrollbar pb-4" data-aos="fade-up" data-aos-duration="1000"
  >
    {/* Render only once in HTML. JS will clone these for the infinite loop to prevent layout bugs if JS fails */}
    {treatments.map(t => (
      <a
        href={`/treatments/${t.slug}`}
        class="treatment-card group shrink-0 bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.08)] hover:shadow-[0_20px_40px_rgb(0,0,0,0.12)] border border-accent-gold/10 transition-all duration-500 flex flex-col overflow-hidden select-none"
        draggable="false"
      >
        <!-- Card Image (Top) -->
        <div class="w-full aspect-[4/3] overflow-hidden bg-gray-50 relative">
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
          <img
            src={t.image}
            alt={t.nameEn}
            class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700 pointer-events-none"
            draggable="false"
          />
        </div>

        <!-- Card Body (Bottom) -->
        <div class="p-8 flex flex-col flex-grow bg-white z-20 relative -mt-4 rounded-t-2xl">
          <div class="w-12 h-1 bg-accent-gold mb-6 rounded-full"></div>
          
          <h3 class="lang-en text-xl text-primary font-serif font-bold mb-4 group-hover:text-accent-gold transition-colors">{t.nameEn}</h3>
          <h3 class="lang-ml font-malayalam text-xl text-primary font-bold mb-4 group-hover:text-accent-gold transition-colors">{t.nameMl}</h3>
          
          <p class="lang-en text-text-muted text-base leading-relaxed mb-8 flex-grow line-clamp-3 sm:line-clamp-none">
            {t.descriptionEn}
          </p>
          <p class="lang-ml font-malayalam text-text-muted text-base leading-relaxed mb-8 flex-grow line-clamp-3 sm:line-clamp-none font-medium">
            {t.descriptionMl}
          </p>
          
          <div class="mt-auto inline-flex items-center justify-between w-full py-4 px-6 bg-primary/5 text-primary rounded-xl font-bold text-sm group-hover:bg-primary group-hover:text-white transition-all duration-300">
            <span class="lang-en">View Details</span>
            <span class="lang-ml font-malayalam">കൂടുതൽ അറിയുക</span>
            <span class="transform group-hover:translate-x-2 transition-transform">→</span>
          </div>
        </div>
      </a>
    ))}
  </div>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* Carousel layout: CSS-scroll-snapping handles everything */
  .treatments-carousel {
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    /* gap applied via card margin so snap math stays correct */
  }

  /* Each card occupies the full carousel width on mobile */
  .treatment-card {
    /* Mobile: full width, 16px side padding from the container */
    width: calc(100% - 2rem); /* accounts for 1rem gap on each side */
    margin: 0 0.5rem;
    scroll-snap-align: start;
    scroll-snap-stop: always; /* forces 1 card at a time on mobile */
  }

  /* Tablet: fixed width */
  @media (min-width: 640px) {
    .treatment-card {
      width: 350px;
      margin: 0 0.75rem;
    }
  }

  /* Desktop */
  @media (min-width: 768px) {
    .treatment-card {
      width: 400px;
      margin: 0 0.75rem;
    }
  }

  /* Add leading/trailing phantom padding so first/last card snaps flush */
  .treatments-carousel::before,
  .treatments-carousel::after {
    content: '';
    display: block;
    flex-shrink: 0;
    width: 0.5rem;
  }

  /* Custom Hover for Arrows */
  @media (hover: hover) {
    .carousel-container:hover .carousel-arrow {
      opacity: 1;
      transform: translateY(-50%) translateX(0);
    }
  }
</style>

<script>
  function initTreatmentsCarousel() {
    const carousel = document.getElementById('treatments-scroll-container') as HTMLElement;
    if (!carousel || carousel.dataset.initialized) return;
    carousel.dataset.initialized = 'true';

    const originalItems = Array.from(carousel.querySelectorAll('.treatment-card'));
    if (originalItems.length === 0) return;

    // Dynamically clone nodes for infinite loop so HTML source is clean
    const originalCount = originalItems.length;
    
    originalItems.forEach(item => {
      carousel.appendChild(item.cloneNode(true));
    });
    
    [...originalItems].reverse().forEach(item => {
      carousel.insertBefore(item.cloneNode(true), carousel.firstChild);
    });

    const items = Array.from(carousel.querySelectorAll('.treatment-card')) as HTMLElement[];
    let currentIndex = originalCount;
    let autoScrollInterval: any;
    let isUserInteracting = false;
    let isProgrammaticScroll = false;
    let interactionTimeout: any;
    let scrollTimeout: any;

    const scrollToItem = (index: number, instant = false) => {
      const item = items[index];
      if (!item) return;
      const target = item.offsetLeft - carousel.offsetLeft;
      isProgrammaticScroll = true;
      clearTimeout(scrollTimeout);
      if (instant) {
        carousel.style.scrollBehavior = 'auto';
        carousel.scrollLeft = target;
        scrollTimeout = setTimeout(() => {
          carousel.style.scrollBehavior = '';
          isProgrammaticScroll = false;
        }, 50);
      } else {
        carousel.style.scrollBehavior = 'smooth';
        carousel.scrollLeft = target;
        scrollTimeout = setTimeout(() => {
          carousel.style.scrollBehavior = '';
          isProgrammaticScroll = false;
          if (!isDown) resetIfNeeded();
        }, 700);
      }
    };

    const resetIfNeeded = () => {
      if (currentIndex < Math.floor(originalCount / 2) || currentIndex >= originalCount * 2 + Math.ceil(originalCount / 2)) {
        const relativeIndex = ((currentIndex % originalCount) + originalCount) % originalCount;
        currentIndex = originalCount + relativeIndex;
        scrollToItem(currentIndex, true);
      }
    };

    const updateCurrentIndex = () => {
      let closestIndex = 0;
      let minDist = Infinity;
      items.forEach((item, idx) => {
        const dist = Math.abs(item.offsetLeft - carousel.offsetLeft - carousel.scrollLeft);
        if (dist < minDist) {
          minDist = dist;
          closestIndex = idx;
        }
      });
      currentIndex = closestIndex;
    };

    const slideToNext = (force = false) => {
      if (isUserInteracting && !force) return;
      currentIndex++;
      scrollToItem(currentIndex, false);
    };

    const slideToPrev = (force = false) => {
      if (isUserInteracting && !force) return;
      currentIndex--;
      scrollToItem(currentIndex, false);
    };

    const startAutoScroll = () => {
      stopAutoScroll();
      const delay = window.innerWidth < 768 ? 4500 : 3000;
      autoScrollInterval = setInterval(slideToNext, delay);
    };

    const stopAutoScroll = () => {
      if (autoScrollInterval) clearInterval(autoScrollInterval);
    };

    let hoverScrollTimeout: any;
    let hoverScrollInterval: any;

    const startHoverScroll = (direction: 'next' | 'prev') => {
      stopHoverScroll();
      hoverScrollTimeout = setTimeout(() => {
        const slideAction = direction === 'next' ? slideToNext : slideToPrev;
        slideAction(true);
        hoverScrollInterval = setInterval(() => {
          slideAction(true);
        }, 2000);
      }, 5000);
    };

    const stopHoverScroll = () => {
      clearTimeout(hoverScrollTimeout);
      if (hoverScrollInterval) clearInterval(hoverScrollInterval);
    };

    scrollToItem(currentIndex, true);

    carousel.addEventListener('scroll', () => {
      if (isProgrammaticScroll) return;
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        updateCurrentIndex();
        if (!isDown) resetIfNeeded();
      }, 200);
    }, { passive: true });

    const onInteractionStart = () => {
      isUserInteracting = true;
      stopAutoScroll();
      clearTimeout(interactionTimeout);
    };

    const onInteractionEnd = () => {
      clearTimeout(interactionTimeout);
      interactionTimeout = setTimeout(() => {
        isUserInteracting = false;
        startAutoScroll();
      }, 2000);
    };

    carousel.addEventListener('mouseenter', onInteractionStart);
    carousel.addEventListener('mouseleave', onInteractionEnd);
    carousel.addEventListener('touchstart', () => {
      onInteractionStart();
      carousel.classList.remove('scroll-smooth');
      carousel.style.scrollBehavior = 'auto';
    }, { passive: true });
    carousel.addEventListener('touchend', () => {
      onInteractionEnd();
      carousel.classList.add('scroll-smooth');
      carousel.style.scrollBehavior = 'smooth';
      setTimeout(() => {
         updateCurrentIndex();
         if (!isDown) resetIfNeeded();
      }, 500);
    }, { passive: true });

    let isDown = false;
    let startX: number;
    let scrollLeftState: number;

    carousel.addEventListener('mousedown', (e) => {
      isDown = true;
      carousel.style.cursor = 'grabbing';
      
      carousel.classList.remove('scroll-smooth');
      carousel.style.scrollBehavior = 'auto'; 
      
      startX = e.pageX - carousel.offsetLeft;
      scrollLeftState = carousel.scrollLeft;
      onInteractionStart();
    });
    
    window.addEventListener('mouseup', () => {
      if (!isDown) return;
      isDown = false;
      carousel.style.cursor = 'grab';
      
      carousel.classList.add('scroll-smooth');
      carousel.style.scrollBehavior = 'smooth';
      
      onInteractionEnd();
      
      setTimeout(() => {
        updateCurrentIndex();
        if (!isDown) resetIfNeeded();
      }, 500);
    });
    
    carousel.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - carousel.offsetLeft;
      const walk = (x - startX) * 1.5;
      carousel.scrollLeft = scrollLeftState - walk;
    });

    const prevBtn = document.getElementById('treatments-prev-btn');
    const nextBtn = document.getElementById('treatments-next-btn');
    
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        onInteractionStart();
        stopHoverScroll();
        slideToPrev(true);
        onInteractionEnd();
      });
      prevBtn.addEventListener('mouseenter', () => {
        onInteractionStart();
        startHoverScroll('prev');
      });
      prevBtn.addEventListener('mouseleave', () => {
        stopHoverScroll();
        onInteractionEnd();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        onInteractionStart();
        stopHoverScroll();
        slideToNext(true);
        onInteractionEnd();
      });
      nextBtn.addEventListener('mouseenter', () => {
        onInteractionStart();
        startHoverScroll('next');
      });
      nextBtn.addEventListener('mouseleave', () => {
        stopHoverScroll();
        onInteractionEnd();
      });
    }

    startAutoScroll();
  }

  initTreatmentsCarousel();
  document.addEventListener('astro:page-load', initTreatmentsCarousel);
</script>
