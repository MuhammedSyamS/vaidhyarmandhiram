---
const categories = [
  { 
    name: 'Panchakarma', 
    description: 'The five-fold detoxification process for total rejuvenation.',
    image: 'https://images.unsplash.com/photo-1600334089648-b0d9d3028eb2?auto=format&fit=crop&q=80&w=800',
    slug: 'panchakarma'
  },
  { 
    name: 'Spine & Joint Care', 
    description: 'Traditional therapies for back pain, cervical and lumbar issues.',
    image: 'https://images.unsplash.com/photo-1519823551278-64ac92734fb1?auto=format&fit=crop&q=80&w=800',
    slug: 'spine-joint'
  },
  { 
    name: 'Skin Treatments', 
    description: 'Natural herbal remedies for radiant skin and chronic conditions.',
    image: 'https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&q=80&w=800',
    slug: 'skin'
  },
  { 
    name: 'Rejuvenation', 
    description: 'Rasayana therapies to slow aging and boost immunity.',
    image: 'https://images.unsplash.com/photo-1544161515-4ab6ce6db874?auto=format&fit=crop&q=80&w=800',
    slug: 'rejuvenation'
  },
];
---

<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 md:gap-8">
  {categories.map(cat => (
    <a href={`/treatments#${cat.slug}`} class="group relative overflow-hidden bg-white shadow-md hover:shadow-lg border border-accent-gold/10 rounded-xl transition-all duration-300">
      <div class="aspect-[4/3] overflow-hidden">
        <img 
          src={cat.image} 
          alt={cat.name} 
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
        />
      </div>
      <div class="p-3 sm:p-6">
        <h3 class="text-base sm:text-xl font-bold mb-1 sm:mb-2 group-hover:text-accent-gold transition-colors leading-tight">
          {cat.name}
        </h3>
        <p class="text-xs sm:text-sm text-text-muted font-sans leading-normal sm:leading-relaxed line-clamp-2 sm:line-clamp-none">
          {cat.description}
        </p>
        <div class="mt-2 sm:mt-4 flex items-center text-primary font-bold text-xs sm:text-sm uppercase tracking-wider sm:tracking-widest">
          View Details <span class="ml-1.5 sm:ml-2 group-hover:translate-x-1 transition-transform">→</span>
        </div>
      </div>
    </a>
  ))}
</div>


