---
const treatments = [
  { 
    name: 'Anorectal & Digestive', 
    description: 'Comprehensive care for Piles, Fissure, Fistula, and IBS using classical Ayurvedic methods.', 
    image: '/images/digestive_care.png', 
    slug: 'special-treatments' 
  },
  { 
    name: 'Spine, Joint & Ortho', 
    description: 'Traditional therapies for Sciatica, Cervical Spondylosis, Bone Alignment, and Frozen Shoulder.', 
    image: '/images/spine-joint.jpg', 
    slug: 'special-treatments' 
  },
  { 
    name: 'Skin, Hair & Beauty', 
    description: 'Deep-acting protocols for Psoriasis, Allergies, Dandruff, and overall Cosmetology.', 
    image: '/images/skin-treatment.jpg', 
    slug: 'special-treatments' 
  },
  { 
    name: 'Women\'s Health & Fertility', 
    description: 'Hormonal balancing for PCOD/PCOS, Endometriosis, and reproductive wellness.', 
    image: '/images/womens_health.png', 
    slug: 'special-treatments' 
  },
  { 
    name: 'Lifestyle & Metabolic', 
    description: 'Management of Diabetes, Cholesterol, Fatty Liver, BP, and Weight.', 
    image: '/images/metabolic_care.png', 
    slug: 'special-treatments' 
  },
  { 
    name: 'Specialized Care', 
    description: 'Expert treatment for Kidney Stones, Migraine, Eye/Ear care, and Paediatrics.', 
    image: '/images/treatment-room-1.jpg', 
    slug: 'special-treatments' 
  }
];
---

<div class="relative w-full overflow-hidden py-4">
  <div id="treatments-scroll-container" class="flex overflow-x-auto no-scrollbar gap-4 sm:gap-6 pb-4 treatments-carousel scroll-smooth snap-x snap-mandatory">
    {/* Duplicate the treatments array to allow infinite seamless scrolling */}
    {[...treatments, ...treatments, ...treatments].map(t => (
      <a href={`/treatments#${t.slug}`} class="treatment-card group relative overflow-hidden bg-white shadow-md hover:shadow-lg border border-accent-gold/10 rounded-xl shrink-0 w-[85vw] sm:w-[350px] md:w-[400px] snap-center transition-all duration-300 transform hover:-translate-y-1">
      <div class="aspect-[4/3] overflow-hidden">
        <img 
          src={t.image} 
          alt={t.name} 
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
        />
      </div>
      <div class="p-5 sm:p-6">
        <h3 class="text-lg sm:text-xl font-bold mb-2 group-hover:text-accent-gold transition-colors leading-tight">
          {t.name}
        </h3>
        <p class="text-sm text-text-muted font-sans leading-relaxed line-clamp-3 sm:line-clamp-none">
          {t.description}
        </p>
        <div class="mt-4 flex items-center text-primary font-bold text-sm uppercase tracking-widest">
          View Details <span class="ml-2 group-hover:translate-x-1 transition-transform">→</span>
        </div>
      </div>
    </a>
  ))}
  </div>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  function initTreatmentsCarousel() {
    const carousel = document.getElementById('treatments-scroll-container') as HTMLElement;
    if (!carousel) return;
    
    const items = Array.from(carousel.querySelectorAll('.treatment-card')) as HTMLElement[];
    if (items.length === 0) return;
    
    // The original number of items (since we duplicated it 3 times: [original, duplicate, duplicate])
    const originalCount = items.length / 3;
    
    let currentIndex = originalCount; // Start in the middle set to allow scrolling left/right safely
    let autoScrollInterval: ReturnType<typeof setInterval>;
    let isHovered = false;
    let isProgrammaticScroll = false;
    
    // Initially scroll to the middle set without animation
    setTimeout(() => {
      const startItem = items[currentIndex];
      const scrollTarget = startItem.offsetLeft - (carousel.offsetWidth / 2) + (startItem.offsetWidth / 2);
      carousel.style.scrollBehavior = 'auto';
      carousel.scrollLeft = scrollTarget;
      carousel.style.scrollBehavior = 'smooth';
    }, 100);

    const slideToNext = () => {
      if (isHovered) return;
      
      currentIndex++;
      isProgrammaticScroll = true;
      
      const targetItem = items[currentIndex];
      const scrollTarget = targetItem.offsetLeft - (carousel.offsetWidth / 2) + (targetItem.offsetWidth / 2);
      
      carousel.scrollTo({
        left: scrollTarget,
        behavior: 'smooth'
      });
      
      // If we've reached the start of the 3rd set, silently snap back to the start of the 2nd set
      if (currentIndex >= originalCount * 2) {
        setTimeout(() => {
          currentIndex = originalCount;
          const resetItem = items[currentIndex];
          const resetTarget = resetItem.offsetLeft - (carousel.offsetWidth / 2) + (resetItem.offsetWidth / 2);
          
          carousel.style.scrollBehavior = 'auto';
          carousel.scrollLeft = resetTarget;
          carousel.style.scrollBehavior = 'smooth';
          isProgrammaticScroll = false;
        }, 800); // Wait for smooth scroll to finish
      } else {
        setTimeout(() => { isProgrammaticScroll = false; }, 800);
      }
    };

    const startAutoScroll = () => {
      stopAutoScroll(); 
      // Give users plenty of time to read, especially on mobile
      const readingTime = window.innerWidth < 768 ? 6500 : 5000;
      autoScrollInterval = setInterval(slideToNext, readingTime); 
    };

    const stopAutoScroll = () => {
      if (autoScrollInterval) clearInterval(autoScrollInterval);
    };

    // Manual scroll handling to keep index updated and handle infinite boundary snapping
    carousel.addEventListener('scroll', () => {
      if (!isProgrammaticScroll) {
        // Calculate which item is closest to center
        const centerOffset = carousel.offsetWidth / 2;
        const scrollCenter = carousel.scrollLeft + centerOffset;
        
        let closestIndex = 0;
        let minDistance = Infinity;
        
        items.forEach((item, idx) => {
          const itemCenter = item.offsetLeft + item.offsetWidth / 2;
          const distance = Math.abs(scrollCenter - itemCenter);
          if (distance < minDistance) {
            minDistance = distance;
            closestIndex = idx;
          }
        });
        
        currentIndex = closestIndex;
        
        // If user manually scrolled to the extremes, snap them back to the middle set silently
        if (currentIndex < originalCount / 2 || currentIndex >= originalCount * 2.5) {
          // Snap back to the middle equivalent
          const relativeIndex = currentIndex % originalCount;
          currentIndex = originalCount + relativeIndex;
          
          const resetItem = items[currentIndex];
          const resetTarget = resetItem.offsetLeft - (carousel.offsetWidth / 2) + (resetItem.offsetWidth / 2);
          
          carousel.style.scrollBehavior = 'auto';
          carousel.scrollLeft = resetTarget;
          carousel.style.scrollBehavior = 'smooth';
        }
      }
    }, { passive: true });

    carousel.addEventListener('mouseenter', () => isHovered = true);
    carousel.addEventListener('mouseleave', () => isHovered = false);
    carousel.addEventListener('touchstart', () => isHovered = true, { passive: true });
    carousel.addEventListener('touchend', () => isHovered = false);

    startAutoScroll();
  }

  initTreatmentsCarousel();
  document.addEventListener('astro:page-load', initTreatmentsCarousel);
</script>


