---
const treatments = [
  { 
    name: 'Special Treatments', 
    description: 'Advanced Ayurvedic protocols for specific conditions, blending tradition with specialized clinical care.', 
    image: '/images/treatment-room-1.jpg', 
    slug: 'special-treatments',
    group: 'Specialized & Children'
  },
  { 
    name: 'Panchakarma Therapy', 
    description: 'Complete detox through Vamana, Virechana, Basti, Nasya, and Raktamokshana.', 
    image: '/images/vamana_virechana_detox.png', 
    slug: 'panchakarma',
    group: ''
  },
  { 
    name: 'Stress Management', 
    description: 'Rejuvenating therapies to relieve stress, anxiety, and restore mental peace.', 
    image: '/images/yoga-meditation.jpg', 
    slug: 'panchakarma',
    group: ''
  },
  { 
    name: 'Spine & Joint Care', 
    description: 'Traditional therapies for Sciatica, Cervical Spondylosis, Bone Alignment, and Frozen Shoulder.', 
    image: '/images/spine-joint.jpg', 
    slug: 'special-treatments',
    group: 'Spine, Joint & Ortho'
  },
  { 
    name: 'Skin Rejuvenation', 
    description: 'Deep-acting protocols for Psoriasis, Allergies, Dandruff, and overall Cosmetology.', 
    image: '/images/skin-treatment.jpg', 
    slug: 'special-treatments',
    group: 'Skin, Hair & Beauty'
  },
  { 
    name: 'Weight Management', 
    description: 'Effective Ayurvedic management of obesity, cholesterol, and metabolic disorders.', 
    image: '/images/metabolic_care.png', 
    slug: 'special-treatments',
    group: 'Lifestyle & Metabolic'
  }
];
---

<div class="relative w-full py-4 carousel-container">
  <!-- Navigation Arrows (Desktop) -->
  <button 
    id="treatments-prev-btn" 
    class="carousel-arrow absolute -left-2 lg:-left-6 top-1/2 -translate-y-1/2 z-30 hidden md:flex w-12 h-12 bg-white rounded-full shadow-lg items-center justify-center text-primary hover:bg-primary hover:text-white transition-all border border-gray-100 opacity-0 translate-x-4 duration-300"
    aria-label="Previous"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
  </button>
  
  <button 
    id="treatments-next-btn" 
    class="carousel-arrow absolute -right-2 lg:-right-6 top-1/2 -translate-y-1/2 z-30 hidden md:flex w-12 h-12 bg-white rounded-full shadow-lg items-center justify-center text-primary hover:bg-primary hover:text-white transition-all border border-gray-100 opacity-0 -translate-x-4 duration-300"
    aria-label="Next"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
    </svg>
  </button>

  <div
    id="treatments-scroll-container"
    class="treatments-carousel flex overflow-x-auto no-scrollbar pb-4"
  >
    {/* Duplicate 3x for infinite-loop illusion */}
    {[...treatments, ...treatments, ...treatments].map(t => (
      <a
        href={`/treatments?tab=${t.slug}&group=${encodeURIComponent(t.group || '')}`}
        class="treatment-card group relative overflow-hidden bg-white shadow-md hover:shadow-lg border border-accent-gold/10 rounded-xl shrink-0 transition-all duration-300 transform hover:-translate-y-1 select-none"
        draggable="false"
      >
        <div class="aspect-[4/3] overflow-hidden">
          <img
            src={t.image}
            alt={t.name}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110 pointer-events-none"
            draggable="false"
          />
        </div>
        <div class="p-5 sm:p-6">
          <h3 class="text-lg sm:text-xl font-bold mb-2 group-hover:text-accent-gold transition-colors leading-tight">
            {t.name}
          </h3>
          <p class="text-sm text-text-muted font-sans leading-relaxed line-clamp-3 sm:line-clamp-none">
            {t.description}
          </p>
          <div class="mt-4 flex items-center text-primary font-bold text-sm uppercase tracking-widest">
            View Details <span class="ml-2 group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </div>
      </a>
    ))}
  </div>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* Carousel layout: CSS-scroll-snapping handles everything */
  .treatments-carousel {
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    /* gap applied via card margin so snap math stays correct */
  }

  /* Each card occupies the full carousel width on mobile */
  .treatment-card {
    /* Mobile: full width, 16px side padding from the container */
    width: calc(100% - 2rem); /* accounts for 1rem gap on each side */
    margin: 0 0.5rem;
    scroll-snap-align: start;
    scroll-snap-stop: always; /* forces 1 card at a time on mobile */
  }

  /* Tablet: fixed width */
  @media (min-width: 640px) {
    .treatment-card {
      width: 350px;
      margin: 0 0.75rem;
    }
  }

  /* Desktop */
  @media (min-width: 768px) {
    .treatment-card {
      width: 400px;
      margin: 0 0.75rem;
    }
  }

  /* Add leading/trailing phantom padding so first/last card snaps flush */
  .treatments-carousel::before,
  .treatments-carousel::after {
    content: '';
    display: block;
    flex-shrink: 0;
    width: 0.5rem;
  }

  /* Custom Hover for Arrows */
  @media (hover: hover) {
    .carousel-container:hover .carousel-arrow {
      opacity: 1;
      transform: translateY(-50%) translateX(0);
    }
  }
</style>

<script>
  function initTreatmentsCarousel() {
    const carousel = document.getElementById('treatments-scroll-container');
    if (!carousel) return;

    const items = Array.from(carousel.querySelectorAll('.treatment-card'));
    if (items.length === 0) return;

    const originalCount = items.length / 3;
    let currentIndex = originalCount;
    let autoScrollInterval;
    let isUserInteracting = false;
    let isProgrammaticScroll = false;
    let interactionTimeout;
    let scrollTimeout;

    const scrollToItem = (index, instant = false) => {
      const item = items[index];
      if (!item) return;
      const target = item.offsetLeft - carousel.offsetLeft;
      isProgrammaticScroll = true;
      clearTimeout(scrollTimeout);
      if (instant) {
        carousel.style.scrollBehavior = 'auto';
        carousel.scrollLeft = target;
        scrollTimeout = setTimeout(() => {
          carousel.style.scrollBehavior = '';
          isProgrammaticScroll = false;
        }, 50);
      } else {
        carousel.style.scrollBehavior = 'smooth';
        carousel.scrollLeft = target;
        scrollTimeout = setTimeout(() => {
          carousel.style.scrollBehavior = '';
          isProgrammaticScroll = false;
          if (!isDown) resetIfNeeded();
        }, 700);
      }
    };

    const resetIfNeeded = () => {
      if (currentIndex < Math.floor(originalCount / 2) || currentIndex >= originalCount * 2 + Math.ceil(originalCount / 2)) {
        const relativeIndex = ((currentIndex % originalCount) + originalCount) % originalCount;
        currentIndex = originalCount + relativeIndex;
        scrollToItem(currentIndex, true);
      }
    };

    const updateCurrentIndex = () => {
      let closestIndex = 0;
      let minDist = Infinity;
      items.forEach((item, idx) => {
        const dist = Math.abs(item.offsetLeft - carousel.offsetLeft - carousel.scrollLeft);
        if (dist < minDist) {
          minDist = dist;
          closestIndex = idx;
        }
      });
      currentIndex = closestIndex;
    };

    const slideToNext = (force = false) => {
      if (isUserInteracting && !force) return;
      currentIndex++;
      scrollToItem(currentIndex, false);
    };

    const slideToPrev = (force = false) => {
      if (isUserInteracting && !force) return;
      currentIndex--;
      scrollToItem(currentIndex, false);
    };

    const startAutoScroll = () => {
      stopAutoScroll();
      const delay = window.innerWidth < 768 ? 6000 : 4500;
      autoScrollInterval = setInterval(slideToNext, delay);
    };

    const stopAutoScroll = () => {
      if (autoScrollInterval) clearInterval(autoScrollInterval);
    };

    scrollToItem(currentIndex, true);

    carousel.addEventListener('scroll', () => {
      if (isProgrammaticScroll) return;
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        updateCurrentIndex();
        if (!isDown) resetIfNeeded();
      }, 200);
    }, { passive: true });

    const onInteractionStart = () => {
      isUserInteracting = true;
      stopAutoScroll();
      clearTimeout(interactionTimeout);
    };

    const onInteractionEnd = () => {
      clearTimeout(interactionTimeout);
      interactionTimeout = setTimeout(() => {
        isUserInteracting = false;
        startAutoScroll();
      }, 2000);
    };

    carousel.addEventListener('mouseenter', onInteractionStart);
    carousel.addEventListener('mouseleave', onInteractionEnd);
    carousel.addEventListener('touchstart', () => {
      onInteractionStart();
      carousel.classList.remove('scroll-smooth');
      carousel.style.scrollBehavior = 'auto';
    }, { passive: true });
    carousel.addEventListener('touchend', () => {
      onInteractionEnd();
      carousel.classList.add('scroll-smooth');
      carousel.style.scrollBehavior = 'smooth';
      setTimeout(() => {
         updateCurrentIndex();
         if (!isDown) resetIfNeeded();
      }, 500);
    }, { passive: true });

    let isDown = false;
    let startX;
    let scrollLeftState;

    carousel.addEventListener('mousedown', (e) => {
      isDown = true;
      carousel.style.cursor = 'grabbing';
      
      carousel.classList.remove('scroll-smooth');
      carousel.style.scrollBehavior = 'auto'; 
      
      startX = e.pageX - carousel.offsetLeft;
      scrollLeftState = carousel.scrollLeft;
      onInteractionStart();
    });
    
    window.addEventListener('mouseup', () => {
      if (!isDown) return;
      isDown = false;
      carousel.style.cursor = 'grab';
      
      carousel.classList.add('scroll-smooth');
      carousel.style.scrollBehavior = 'smooth';
      
      onInteractionEnd();
      
      setTimeout(() => {
        updateCurrentIndex();
        if (!isDown) resetIfNeeded();
      }, 500);
    });
    
    carousel.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - carousel.offsetLeft;
      const walk = (x - startX) * 1.5;
      carousel.scrollLeft = scrollLeftState - walk;
    });

    const prevBtn = document.getElementById('treatments-prev-btn');
    const nextBtn = document.getElementById('treatments-next-btn');
    
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        onInteractionStart();
        slideToPrev(true);
        onInteractionEnd();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        onInteractionStart();
        slideToNext(true);
        onInteractionEnd();
      });
    }

    startAutoScroll();
  }

  initTreatmentsCarousel();
  document.addEventListener('astro:page-load', initTreatmentsCarousel);
</script>
