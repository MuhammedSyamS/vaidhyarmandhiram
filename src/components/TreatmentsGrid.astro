---
const treatments = [
  { 
    name: 'Anorectal & Digestive', 
    description: 'Comprehensive care for Piles, Fissure, Fistula, and IBS using classical Ayurvedic methods.', 
    image: '/images/digestive_care.png', 
    slug: 'special-treatments' 
  },
  { 
    name: 'Spine, Joint & Ortho', 
    description: 'Traditional therapies for Sciatica, Cervical Spondylosis, Bone Alignment, and Frozen Shoulder.', 
    image: '/images/spine-joint.jpg', 
    slug: 'special-treatments' 
  },
  { 
    name: 'Skin, Hair & Beauty', 
    description: 'Deep-acting protocols for Psoriasis, Allergies, Dandruff, and overall Cosmetology.', 
    image: '/images/skin-treatment.jpg', 
    slug: 'special-treatments' 
  },
  { 
    name: 'Women\'s Health & Fertility', 
    description: 'Hormonal balancing for PCOD/PCOS, Endometriosis, and reproductive wellness.', 
    image: '/images/womens_health.png', 
    slug: 'special-treatments' 
  },
  { 
    name: 'Lifestyle & Metabolic', 
    description: 'Management of Diabetes, Cholesterol, Fatty Liver, BP, and Weight.', 
    image: '/images/metabolic_care.png', 
    slug: 'special-treatments' 
  },
  { 
    name: 'Specialized Care', 
    description: 'Expert treatment for Kidney Stones, Migraine, Eye/Ear care, and Paediatrics.', 
    image: '/images/treatment-room-1.jpg', 
    slug: 'special-treatments' 
  }
];
---

<div class="relative w-full overflow-hidden py-4">
  <div id="treatments-scroll-container" class="flex overflow-x-auto no-scrollbar gap-4 sm:gap-6 pb-4 treatments-carousel">
    {/* Duplicate the treatments array to allow infinite seamless scrolling */}
    {[...treatments, ...treatments].map(t => (
      <a href={`/treatments#${t.slug}`} class="treatment-card group relative overflow-hidden bg-white shadow-md hover:shadow-lg border border-accent-gold/10 rounded-xl shrink-0 w-[85vw] sm:w-[350px] md:w-[400px] transition-all duration-300 transform hover:-translate-y-1">
      <div class="aspect-[4/3] overflow-hidden">
        <img 
          src={t.image} 
          alt={t.name} 
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
        />
      </div>
      <div class="p-5 sm:p-6">
        <h3 class="text-lg sm:text-xl font-bold mb-2 group-hover:text-accent-gold transition-colors leading-tight">
          {t.name}
        </h3>
        <p class="text-sm text-text-muted font-sans leading-relaxed line-clamp-3 sm:line-clamp-none">
          {t.description}
        </p>
        <div class="mt-4 flex items-center text-primary font-bold text-sm uppercase tracking-widest">
          View Details <span class="ml-2 group-hover:translate-x-1 transition-transform">→</span>
        </div>
      </div>
    </a>
  ))}
  </div>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  function initTreatmentsCarousel() {
    const carousel = document.getElementById('treatments-scroll-container') as HTMLElement;
    if (!carousel) return;
    
    let isHovered = false;
    let animationId: number;
    // Speed of scroll (pixels per frame)
    const scrollSpeed = 1; 

    // Hover listeners to pause animation
    carousel.addEventListener('mouseenter', () => isHovered = true);
    carousel.addEventListener('mouseleave', () => isHovered = false);
    carousel.addEventListener('touchstart', () => isHovered = true, { passive: true });
    carousel.addEventListener('touchend', () => isHovered = false);

    const scrollLoop = () => {
      if (!isHovered) {
        carousel.scrollLeft += scrollSpeed;
        
        // Because we duplicated the array exactly once, 
        // the total scroll width is double the original content.
        // Once we scroll past halfway, instantly jump back to 0.
        // (Minus a tiny fraction to ensure it doesn't snap visibly due to gaps)
        if (carousel.scrollLeft >= (carousel.scrollWidth / 2)) {
          carousel.scrollLeft = 0;
        }
      }
      animationId = requestAnimationFrame(scrollLoop);
    };

    // Clean up any existing animation before starting a new one
    if ((window as any)._treatmentsCarouselAnimation) {
      cancelAnimationFrame((window as any)._treatmentsCarouselAnimation);
    }
    
    // Start loop
    animationId = requestAnimationFrame(scrollLoop);
    (window as any)._treatmentsCarouselAnimation = animationId;
  }

  initTreatmentsCarousel();
  document.addEventListener('astro:page-load', initTreatmentsCarousel);
</script>


