---
const categories = [
  { 
    name: 'Panchakarma', 
    description: 'The five-fold detoxification process for total rejuvenation.',
    image: 'https://images.unsplash.com/photo-1600334089648-b0d9d3028eb2?auto=format&fit=crop&q=80&w=800',
    slug: 'panchakarma'
  },
  { 
    name: 'Spine & Joint Care', 
    description: 'Traditional therapies for back pain, cervical and lumbar issues.',
    image: 'https://images.unsplash.com/photo-1519823551278-64ac92734fb1?auto=format&fit=crop&q=80&w=800',
    slug: 'spine-joint'
  },
  { 
    name: 'Skin Treatments', 
    description: 'Natural herbal remedies for radiant skin and chronic conditions.',
    image: 'https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&q=80&w=800',
    slug: 'skin'
  },
  { 
    name: 'Rejuvenation', 
    description: 'Rasayana therapies to slow aging and boost immunity.',
    image: 'https://images.unsplash.com/photo-1544161515-4ab6ce6db874?auto=format&fit=crop&q=80&w=800',
    slug: 'rejuvenation'
  },
];
---

<div class="treatments-carousel flex overflow-x-auto md:overflow-x-visible snap-x snap-mandatory no-scrollbar gap-4 sm:gap-6 md:grid md:grid-cols-2 lg:grid-cols-4 md:gap-8 pb-4 md:pb-0 scroll-smooth">
  {categories.map(cat => (
    <a href={`/treatments#${cat.slug}`} class="group relative overflow-hidden bg-white shadow-md hover:shadow-lg border border-accent-gold/10 rounded-xl shrink-0 w-[82vw] sm:w-[320px] md:w-auto snap-center transition-all duration-300">
      <div class="aspect-[4/3] overflow-hidden">
        <img 
          src={cat.image} 
          alt={cat.name} 
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
        />
      </div>
      <div class="p-5 sm:p-6">
        <h3 class="text-lg sm:text-xl font-bold mb-2 group-hover:text-accent-gold transition-colors leading-tight">
          {cat.name}
        </h3>
        <p class="text-sm text-text-muted font-sans leading-relaxed line-clamp-3 sm:line-clamp-none">
          {cat.description}
        </p>
        <div class="mt-4 flex items-center text-primary font-bold text-sm uppercase tracking-widest">
          View Details <span class="ml-2 group-hover:translate-x-1 transition-transform">→</span>
        </div>
      </div>
    </a>
  ))}
</div>

<script>
  function initTreatmentsCarousel() {
    const carousel = document.querySelector('.treatments-carousel') as HTMLElement;
    if (!carousel) return;
    
    let autoScrollInterval: ReturnType<typeof setInterval>;
    const items = Array.from(carousel.children) as HTMLElement[];
    let currentIndex = 0;
    let isProgrammaticScroll = false;
    
    // Mathematically track manual scrolls using the exact center offset of each item
    const updateIndex = () => {
      if (items.length === 0) return;
      const scrollLeft = carousel.scrollLeft;
      const centerOffset = carousel.offsetWidth / 2;
      const scrollCenter = scrollLeft + centerOffset;
      
      let closestIndex = 0;
      let minDistance = Infinity;
      
      items.forEach((item, idx) => {
        const itemCenter = item.offsetLeft + item.offsetWidth / 2;
        const distance = Math.abs(scrollCenter - itemCenter);
        if (distance < minDistance) {
          minDistance = distance;
          closestIndex = idx;
        }
      });
      
      currentIndex = closestIndex;
    };

    // Track scroll events on mobile devices to align manual swipes with the index
    carousel.addEventListener('scroll', () => {
      if (!isProgrammaticScroll) {
        updateIndex();
      }
    }, { passive: true });

    const startAutoScroll = () => {
      stopAutoScroll(); 
      
      autoScrollInterval = setInterval(() => {
        if (window.innerWidth >= 768) return;
        
        // strictly increment by 1
        currentIndex++;
        if (currentIndex >= items.length) {
          currentIndex = 0;
        }
        
        isProgrammaticScroll = true;
        
        // Container-only smooth scroll to prevent page jumping down
        const targetItem = items[currentIndex];
        const scrollTarget = targetItem.offsetLeft - (carousel.offsetWidth / 2) + (targetItem.offsetWidth / 2);
        
        carousel.scrollTo({
          left: scrollTarget,
          behavior: 'smooth'
        });
        
        // Unlock index tracking after smooth animation settles
        setTimeout(() => {
          isProgrammaticScroll = false;
        }, 1000);
        
      }, 4500); // 4.5 seconds per card
    };

    const stopAutoScroll = () => {
      if (autoScrollInterval) clearInterval(autoScrollInterval);
    };

    carousel.addEventListener('touchstart', stopAutoScroll, { passive: true });
    carousel.addEventListener('touchend', startAutoScroll);
    
    startAutoScroll();
  }

  initTreatmentsCarousel();
  document.addEventListener('astro:page-load', initTreatmentsCarousel);
</script>


