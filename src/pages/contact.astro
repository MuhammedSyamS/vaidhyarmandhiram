---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import { Phone, Mail, MapPin, Clock, MessageSquare } from 'lucide-react';

export const prerender = true;
---

<BaseLayout title="Contact Us" description="Get in touch with Vaidyarmandiram Ayurveda Hospital. Find our locations in Trivandrum, Kollam, and Alappuzha, or book a consultation.">
  <Fragment slot="json-ld">
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "How can I book an appointment?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "You can book an appointment online through our website, or by calling us at +918593821553."
            }
          },
          {
            "@type": "Question",
            "name": "Where is Vaidyarmandiram located?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Our main branch is located in Pangode, Trivandrum. We also have branches in Kollam and Alappuzha."
            }
          }
        ]
      }
    </script>
  </Fragment>
  <Header slot="header" />

  <!-- Page Header -->
  <div class="bg-primary-dark py-24 text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <img src="https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/spine-joint.jpg" alt="" class="w-full h-full object-cover" />
    </div>
    <div class="container mx-auto px-4 relative z-10">
      <span class="lang-en text-accent-gold font-sans uppercase tracking-[0.3em] text-sm font-bold mb-2 block">Get in Touch</span>
      <span class="lang-ml font-malayalam text-accent-gold text-base font-semibold mb-2 block">ബന്ധപ്പെടുക</span>
      <h1 class="lang-en text-4xl md:text-7xl text-background-parchment leading-tight">We are here to <span class="text-accent-gold ">Listen</span></h1>
      <h1 class="lang-ml font-malayalam text-4xl md:text-6xl text-background-parchment leading-tight mt-2">ഞങ്ങൾ ശ്രദ്ധിക്കാൻ <span class="text-accent-gold">ഇവിടെ ഉണ്ട്</span></h1>
    </div>
  </div>

  <Section background="parchment">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-16">
      <div class="bg-background-parchment p-6 lg:p-8 shadow-lg border-l-4 lg:border-l-0 lg:border-t-4 border-primary-dark flex flex-row lg:flex-col items-center lg:justify-center gap-5 lg:gap-3 text-left lg:text-center hover:-translate-y-1 transition-transform">
        <div class="w-14 h-14 lg:w-12 lg:h-12 shrink-0 bg-primary-dark/10 rounded-full flex items-center justify-center text-primary-dark lg:mx-auto">
          <Phone size={24} />
        </div>
        <div>
          <h3 class="lang-en text-lg lg:text-xl font-bold text-primary-dark uppercase tracking-widest">Call Us</h3>
          <h3 class="lang-ml font-malayalam text-lg lg:text-xl font-bold text-primary-dark">ഫോൺ ചെയ്യൂ</h3>
          <div class="text-primary-dark font-sans text-sm lg:text-base mt-1 lg:mt-0">
            <a href="tel:+918593821553" class="hover:text-accent-gold transition-colors block lg:inline">+91 85938 21553</a>
            <span class="hidden lg:inline"><br/></span>
            <a href="tel:+919495556497" class="hover:text-accent-gold transition-colors block lg:inline">+91 94955 56497</a>
          </div>
        </div>
      </div>

      <div class="bg-background-parchment p-6 lg:p-8 shadow-lg border-l-4 lg:border-l-0 lg:border-t-4 border-accent-gold flex flex-row lg:flex-col items-center lg:justify-center gap-5 lg:gap-3 text-left lg:text-center hover:-translate-y-1 transition-transform">
        <div class="w-14 h-14 lg:w-12 lg:h-12 shrink-0 bg-accent-gold/10 rounded-full flex items-center justify-center text-accent-gold lg:mx-auto">
          <MapPin size={24} />
        </div>
        <div>
          <h3 class="lang-en text-lg lg:text-xl font-bold text-primary-dark uppercase tracking-widest mb-2">Our Locations</h3>
          <h3 class="lang-ml font-malayalam text-lg lg:text-xl font-bold text-primary-dark mb-2">ഞങ്ങളുടെ ശാഖകൾ</h3>
          
          <div class="space-y-2 mt-2">
            <div>
              <p class="font-bold text-primary-dark text-sm">Trivandrum (HQ)</p>
              <p class="text-text-muted font-sans text-xs lg:text-sm">Pangode, Kallara P.O, 695609</p>
            </div>
            <div>
              <p class="font-bold text-primary-dark text-sm">Kollam</p>
              <p class="text-text-muted font-sans text-xs lg:text-sm">Bus Stand Road, Kadakkal, 691536</p>
            </div>
            <div>
              <p class="font-bold text-primary-dark text-sm">Alappuzha</p>
              <p class="text-text-muted font-sans text-xs lg:text-sm">Alappuzha, Kerala</p>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-background-parchment p-6 lg:p-8 shadow-lg border-l-4 lg:border-l-0 lg:border-t-4 border-primary-dark flex flex-row lg:flex-col items-center lg:justify-center gap-5 lg:gap-3 text-left lg:text-center hover:-translate-y-1 transition-transform">
        <div class="w-14 h-14 lg:w-12 lg:h-12 shrink-0 bg-primary-dark/10 rounded-full flex items-center justify-center text-primary-dark lg:mx-auto">
          <Mail size={24} />
        </div>
        <div>
          <h3 class="lang-en text-lg lg:text-xl font-bold text-primary-dark uppercase tracking-widest">Email Us</h3>
          <h3 class="lang-ml font-malayalam text-lg lg:text-xl font-bold text-primary-dark">ഇമെയിൽ ചെയ്യൂ</h3>
          <p class="text-primary-dark font-sans text-sm lg:text-base mt-1 lg:mt-0 break-all">vmayurveda1983@gmail.com</p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <!-- Inquiry Form -->
      <div class="space-y-6">
        <div>
          <h2 class="lang-en text-3xl font-bold text-primary-dark">Send a Message</h2>
          <h2 class="lang-ml font-malayalam text-3xl font-bold text-primary-dark">ഒരു സന്ദേശം അയക്കൂ</h2>
          <p class="lang-en text-primary-dark font-sans mt-2">Have a question? Fill out the form below and we'll get back to you within 24 hours.</p>
          <p class="lang-ml font-malayalam text-primary-dark mt-2">ഒരു ചോദ്യമുണ്ടോ? താഴെയുള്ള ഫോർം പൂര്ണമാക്കുക, 24 മണിക്കൂരിനുള്ളിൽ ഞങ്ങൾ മറുപടി നൽകും.</p>
        </div>
        <form class="space-y-6" action="#" method="POST" id="contact-form">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="name" class="sr-only">Your Name</label>
              <input type="text" id="name" name="name" placeholder="Your Name" class="w-full px-4 py-3 border border-accent-gold/20 focus:border-primary outline-none font-sans" required />
            </div>
            <div>
              <label for="email" class="sr-only">Email Address</label>
              <input type="email" id="email" name="email" placeholder="Email Address" class="w-full px-4 py-3 border border-accent-gold/20 focus:border-primary outline-none font-sans" required />
            </div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="phone" class="sr-only">Phone Number</label>
              <input type="tel" id="phone" name="phone" placeholder="Phone Number" class="w-full px-4 py-3 border border-accent-gold/20 focus:border-primary outline-none font-sans" required />
            </div>
            <div>
              <label for="subject" class="sr-only">Subject</label>
              <input type="text" id="subject" name="subject" placeholder="Subject" class="w-full px-4 py-3 border border-accent-gold/20 focus:border-primary outline-none font-sans" required />
            </div>
          </div>
          <div>
            <label for="message" class="sr-only">Message</label>
            <textarea id="message" name="message" placeholder="How can we help you?" rows="5" class="w-full px-4 py-3 border border-accent-gold/20 focus:border-primary outline-none font-sans resize-none" required></textarea>
          </div>
          <button type="submit" class="btn-primary w-full">Send Inquiry</button>
        </form>
      </div>

      <!-- Opening Hours & Map -->
      <div class="space-y-8">
        <div class="bg-background-cream p-8 shadow-lg border-l-4 border-accent-gold space-y-6">
          <h3 class="text-2xl font-bold text-primary-dark flex items-center gap-2">
            <Clock size={24} className="text-accent-gold" />
            Opening Hours
          </h3>
          <div class="space-y-3 font-sans">
            <div class="flex justify-between border-b border-accent-gold/10 pb-2">
              <span class="text-earth font-bold">All Days</span>
              <span class="text-text-muted font-bold text-primary">8:00 AM - 8:00 PM</span>
            </div>
          </div>
          <p class="text-sm text-text-muted ">
            * Therapy sessions are scheduled based on prior appointments.
          </p>
        </div>

        <!-- WhatsApp CTA -->
        <a 
          href="https://wa.me/918593821553" 
          target="_blank"
          class="flex items-center justify-between p-6 bg-[#25D366] text-white rounded-lg shadow-lg hover:shadow-xl transition-all group"
        >
          <div class="flex items-center gap-4">
            <MessageSquare size={32} />
            <div>
              <p class="font-sans font-bold uppercase tracking-widest text-xs opacity-80">Instant Support</p>
              <p class="text-xl font-bold">Chat on WhatsApp</p>
            </div>
          </div>
          <span class="text-2xl group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    </div>
  </Section>

  <!-- Interactive Branch Maps -->
  <div class="bg-background-cream py-16 border-t border-accent-gold/20">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="text-center mb-10">
        <h2 class="lang-en text-3xl font-serif text-primary-dark">Our Locations</h2>
        <h2 class="lang-ml font-malayalam text-3xl text-primary-dark">ഞങ്ങളുടെ ശാഖകൾ</h2>
        <p class="lang-en text-sm text-text-muted mt-2">Select a branch to view its location and get directions</p>
        <p class="lang-ml font-malayalam text-sm text-text-muted mt-2">ലൊക്കേഷൻ കാണാനും വഴി അറിയാനും ഒരു ശാഖ തിരഞ്ഞെടുക്കുക</p>
      </div>

      <!-- Tab Buttons -->
      <div class="flex flex-wrap justify-center gap-4 mb-8">
        <button
          class="map-tab-btn px-6 py-3 border-2 border-accent-gold text-primary-dark font-sans font-bold bg-accent-gold/15 hover:bg-accent-gold/10 transition-all rounded-lg"
          data-map-url="https://maps.google.com/maps?q=VAIDHYARMANDHIRAM+HOSPITAL+Pangode+Kallara&t=m&z=14&output=embed&iwloc=Near"
          data-dir-url="https://maps.app.goo.gl/NynzVNVwV4XEYYpJ7"
        >
          <span class="lang-en">Trivandrum (Pangode)</span>
          <span class="lang-ml font-malayalam">തിരുവനന്തപുരം (പാങ്ങോട്)</span>
        </button>
        <button
          class="map-tab-btn px-6 py-3 border-2 border-accent-gold/40 text-primary-dark/70 font-sans font-semibold hover:border-accent-gold hover:text-primary-dark hover:bg-accent-gold/5 transition-all rounded-lg"
          data-map-url="https://maps.google.com/maps?q=VAIDHYARMANDHIRAM+HOSPITAL+Kadakkal+Kollam&t=m&z=14&output=embed&iwloc=Near"
          data-dir-url="https://maps.app.goo.gl/A3vvy8Xnpr1P6w3J7"
        >
          <span class="lang-en">Kollam (Kadakkal)</span>
          <span class="lang-ml font-malayalam">കൊല്ലം (കടയ്ക്കൽ)</span>
        </button>
        <button
          class="map-tab-btn px-6 py-3 border-2 border-accent-gold/40 text-primary-dark/70 font-sans font-semibold hover:border-accent-gold hover:text-primary-dark hover:bg-accent-gold/5 transition-all rounded-lg"
          data-map-url="https://maps.google.com/maps?q=Alappuzha,+Kerala,+India&t=m&z=12&output=embed&iwloc=Near"
          data-dir-url="https://maps.google.com/?q=Alappuzha,+Kerala,+India"
        >
          <span class="lang-en">Alappuzha</span>
          <span class="lang-ml font-malayalam">ആലപ്പുഴ</span>
        </button>
      </div>

      <!-- Map Wrapper -->
      <div class="bg-white p-4 rounded-xl shadow-xl border border-accent-gold/20 relative overflow-hidden">
        <div class="h-[450px] w-full relative">
          <iframe 
            id="branch-map-iframe"
            src="https://maps.google.com/maps?q=VAIDHYARMANDHIRAM+HOSPITAL+Pangode+Kallara&t=m&z=14&output=embed&iwloc=Near" 
            width="100%" 
            height="100%" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
        
        <!-- Get Directions Link -->
        <div class="mt-4 flex flex-col sm:flex-row gap-2 justify-between items-center px-2">
          <span class="text-xs font-sans text-text-muted">* Interactive view. Click below for complete Google Maps directions.</span>
          <a
            id="get-directions-btn"
            href="https://maps.app.goo.gl/NynzVNVwV4XEYYpJ7"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary py-2 px-6 text-sm flex items-center gap-2"
          >
            <span class="lang-en">Get Directions</span>
            <span class="lang-ml font-malayalam font-semibold">വഴി കാണിക്കുക</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    function initMapTabs() {
      const buttons = document.querySelectorAll('.map-tab-btn');
      const iframe = document.getElementById('branch-map-iframe') as HTMLIFrameElement;
      const dirBtn = document.getElementById('get-directions-btn') as HTMLAnchorElement;

      if (!iframe || !dirBtn) return;

      buttons.forEach(button => {
        button.addEventListener('click', () => {
          // Remove active styles from all buttons
          buttons.forEach(btn => {
            btn.classList.remove('border-accent-gold', 'text-primary-dark', 'font-bold', 'bg-accent-gold/15');
            btn.classList.add('border-accent-gold/40', 'text-primary-dark/70', 'font-semibold');
          });

          // Add active styles to clicked button
          button.classList.add('border-accent-gold', 'text-primary-dark', 'font-bold', 'bg-accent-gold/15');
          button.classList.remove('border-accent-gold/40', 'text-primary-dark/70', 'font-semibold');

          // Update Map Source and Directions Link
          const mapUrl = button.getAttribute('data-map-url');
          const dirUrl = button.getAttribute('data-dir-url');

          if (mapUrl) iframe.src = mapUrl;
          if (dirUrl) dirBtn.href = dirUrl;
        });
      });
    }

    // Initialize
    initMapTabs();

    // Re-run on View Transitions
    document.addEventListener('astro:page-load', initMapTabs);
  </script>

  <Footer slot="footer" />
</BaseLayout>
