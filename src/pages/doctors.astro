---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import { Award, BookOpen, Clock } from 'lucide-react';

export const prerender = true;

const otherDoctors = [
  {
    nameEn: 'P. Jafar Khan Gurukkal', nameMl: 'പി. ജാഫർ ഖാൻ ഗുരുക്കൾ',
    titleEn: 'Varma Therapist', titleMl: 'വർമ്മ തെറാപ്പിസ്റ്റ്',
    qualifications: 'Managing Director',
    experienceEn: 'Experienced', experienceMl: 'പരിചയസമ്പന്നർ',
    specialisationsEn: ['Varma Therapy', 'Traditional Healing'],
    specialisationsMl: ['വർമ്മ തെറാപ്പി', 'പരമ്പരാഗത ചികിത്സ'],
    image: 'https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto:best,e_upscale,e_improve,e_sharpen:150/v1/vaidhyarmandhiram/images/Jafarkhan.jpg'
  },
  {
    nameEn: 'Dr. Rabiya Jafarkhan', nameMl: 'ഡോ. റാബിയ ജാഫർഖാൻ',
    titleEn: 'Consultant Physician', titleMl: 'കൺസൾട്ടന്റ് ഫിസിഷ്യൻ',
    qualifications: 'BSMS',
    experienceEn: 'Experienced', experienceMl: 'പരിചയസമ്പന്നർ',
    specialisationsEn: ['Siddha Medicine', 'General Wellness'],
    specialisationsMl: ['സിദ്ധ വൈദ്യം', 'പൊതുവായ ആരോഗ്യം'],
    image: 'https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto:best,e_upscale,e_improve,e_sharpen:150/v1/vaidhyarmandhiram/images/Dr.Rabiya Jafarkhan (BSMS).jpeg'
  },
  {
    nameEn: 'Dr. Hansha Parveen', nameMl: 'ഡോ. ഹൻഷ പർവീൻ',
    titleEn: 'Consultant Physician', titleMl: 'കൺസൾട്ടന്റ് ഫിസിഷ്യൻ',
    qualifications: 'BSMS',
    experienceEn: 'Experienced', experienceMl: 'പരിചയസമ്പന്നർ',
    specialisationsEn: ['Siddha Medicine', 'General Wellness'],
    specialisationsMl: ['സിദ്ധ വൈദ്യം', 'പൊതുവായ ആരോഗ്യം'],
    image: 'https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto:best,e_upscale,e_improve,e_sharpen:150/v1/vaidhyarmandhiram/images/Dr.Hansha Parveen(BSMS).jpeg'
  }
];
---

<BaseLayout title="Our Doctors" description="Meet our team of highly qualified Ayurvedic physicians led by Dr. P. Abdul Sathar Gurukkal. Expert care in Nadi Pariksha and holistic healing.">
  <Fragment slot="json-ld">
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Physician",
            "name": "Dr. P. Abdul Sathar Gurukkal",
            "medicalSpecialty": "Ayurvedic Medicine",
            "image": "https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/vmfounder.jpg"
          },
          {
            "@type": "Physician",
            "name": "P. Jafar Khan Gurukkal",
            "medicalSpecialty": "Varma Therapy",
            "image": "https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/Jafarkhan.jpg"
          },
          {
            "@type": "Physician",
            "name": "Dr. Rabiya Jafarkhan",
            "medicalSpecialty": "Siddha Medicine",
            "image": "https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/Dr.Rabiya Jafarkhan (BSMS).jpeg"
          },
          {
            "@type": "Physician",
            "name": "Dr. Hansha Parveen",
            "medicalSpecialty": "Siddha Medicine",
            "image": "https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/Dr.Hansha Parveen(BSMS).jpeg"
          }
        ]
      }
    </script>
  </Fragment>
  <Header slot="header" />

  <!-- Page Header -->
  <div class="bg-primary-dark py-24 text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <img src="https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/hero-bg.jpg" alt="" class="w-full h-full object-cover" />
    </div>
    <div class="container mx-auto px-4 relative z-10">
      <span class="lang-en text-accent-gold font-sans uppercase tracking-[0.3em] text-sm font-bold mb-2 block">Medical Team</span>
      <span class="lang-ml font-malayalam text-accent-gold text-base font-semibold mb-2 block">വൈദ്യ സംഘം</span>
      <h1 class="lang-en text-4xl md:text-7xl text-background-parchment leading-tight">Expert <span class="text-accent-gold ">Physicians</span></h1>
      <h1 class="lang-ml font-malayalam text-4xl md:text-6xl text-background-parchment leading-tight mt-2">വിദഗ്ധ <span class="text-accent-gold">വൈദ്യൻമാർ</span></h1>
    </div>
  </div>


  <!-- Founder Featured Card (In Memoriam) -->
  <Section background="parchment">
    <div class="bg-white shadow-2xl overflow-hidden border border-accent-gold/10">
      <div class="grid grid-cols-1 lg:grid-cols-5 items-stretch">
        <div class="lg:col-span-2 relative">
          <img 
            src="https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/vmfounder.jpg" 
            alt="Dr. P. Abdul Sathar Gurukkal" 
            class="w-full h-full object-cover min-h-[500px]"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-primary/90 text-background-parchment p-6 lg:hidden">
            <h2 class="text-2xl font-bold">Dr. P. Abdul Sathar Gurukkal</h2>
            <p class="text-accent-gold uppercase tracking-widest text-sm">Founder</p>
          </div>
        </div>
        <div class="lg:col-span-3 p-8 md:p-12 space-y-8 flex flex-col justify-center">
          <div class="hidden lg:block space-y-2">
            <span class="lang-en text-accent-gold font-sans uppercase tracking-[0.3em] text-sm font-bold">Our Founder</span>
            <span class="lang-ml font-malayalam text-accent-gold text-sm font-semibold block">ഞങ്ങളുടെ സ്ഥാപകൻ</span>
            <h2 class="lang-en text-4xl font-bold text-primary-dark">Dr. P. Abdul Sathar Gurukkal</h2>
            <h2 class="lang-ml font-malayalam text-3xl font-bold text-primary-dark">ഡോ. പി. അബ്ദുൾ സതാർ ഗുരുക്കൾ</h2>
            <p class="lang-en text-earth uppercase tracking-widest font-bold text-sm">Founder</p>
            <p class="lang-ml font-malayalam text-earth font-semibold text-sm">സ്ഥാപകൻ</p>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="flex gap-4">
              <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center text-primary shrink-0">
                <Award size={20} />
              </div>
              <div>
                <p class="text-xs text-text-muted uppercase font-bold tracking-wider font-sans">
                  <span class="lang-en">Qualifications</span>
                  <span class="lang-ml font-malayalam tracking-normal">യോഗ്യതകൾ</span>
                </p>
                <p class="text-lg font-bold text-primary-dark">BAMS, MD (Ayurveda)</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center text-primary shrink-0">
                <Clock size={20} />
              </div>
              <div>
                <p class="text-xs text-text-muted uppercase font-bold tracking-wider font-sans">
                  <span class="lang-en">Legacy</span>
                  <span class="lang-ml font-malayalam tracking-normal">പാരമ്പര്യം</span>
                </p>
                <p class="text-lg font-bold text-primary-dark">
                  <span class="lang-en">35+ Years of Service</span>
                  <span class="lang-ml font-malayalam">35+ വർഷത്തെ സേവനം</span>
                </p>
              </div>
            </div>
          </div>

          <div class="space-y-4">
            <h3 class="lang-en text-xl font-bold text-primary-dark flex items-center gap-2">
              <BookOpen size={20} className="text-accent-gold" />
              Philosophy & Expertise
            </h3>
            <h3 class="lang-ml font-malayalam text-xl font-bold text-primary-dark flex items-center gap-2">
              <BookOpen size={20} className="text-accent-gold" />
              തത്വചിന്തയും വൈദഗ്ധ്യവും
            </h3>
            <p class="lang-en text-text-muted leading-relaxed font-sans">
              Dr. P. Abdul Sathar Gurukkal was a pioneer in traditional Kerala Ayurveda. His clinical expertise spanned over three decades, specializing in Panchakarma and chronic disease management. He believed in treating the root cause of illness by restoring the balance of Tridoshas (Vata, Pitta, Kapha).
            </p>
            <p class="lang-ml font-malayalam text-text-muted leading-relaxed font-medium">
              പരമ്പരാഗത കേരള ആയുർവേദത്തിലെ ഒരു പ്രഗത്ഭനായിരുന്നു ഡോ. പി. അബ്ദുൾ സതാർ ഗുരുക്കൾ. പഞ്ചകർമ്മയിലും വിട്ടുമാറാത്ത രോഗചികിത്സയിലും വൈദഗ്ദ്ധ്യം നേടിയ അദ്ദേഹത്തിന് മൂന്ന് പതിറ്റാണ്ടിലേറെ ക്ലിനിക്കൽ അനുഭവസമ്പത്തുണ്ടായിരുന്നു. ത്രിദോഷങ്ങളുടെ (വാതം, പിത്തം, കഫം) സന്തുലിതാവസ്ഥ പുനഃസ്ഥാപിച്ച് രോഗത്തിന്റെ മൂലകാരണത്തെ ചികിത്സിക്കുന്നതിലായിരുന്നു അദ്ദേഹം വിശ്വസിച്ചിരുന്നത്.
            </p>
            <p class="lang-en text-text-muted leading-relaxed font-sans">
              As a traditional Gurukkal, he carried forward the ancient wisdom of Marma Chikitsa and specialized herbal formulations passed down through generations.
            </p>
            <p class="lang-ml font-malayalam text-text-muted leading-relaxed font-medium">
              ഒരു പരമ്പരാഗത ഗുരുക്കൾ എന്ന നിലയിൽ, തലമുറകളായി കൈമാറ്റം ചെയ്യപ്പെട്ട മർമ്മ ചികിത്സയുടെ പുരാതന ജ്ഞാനവും പ്രത്യേക ഔഷധക്കൂട്ടുകളും അദ്ദേഹം മുന്നോട്ട് കൊണ്ടുപോയി.
            </p>
          </div>

          <div class="flex flex-wrap gap-2">
            {['Panchakarma', 'Chronic Management', 'Marma Chikitsa', 'Clinical Research'].map((tag, idx) => {
              const tagsMl = ['പഞ്ചകർമ്മ', 'വിട്ടുമാറാത്ത രോഗചികിത്സ', 'മർമ്മ ചികിത്സ', 'ക്ലിനിക്കൽ ഗവേഷണം'];
              return (
              <span class="px-3 py-1 bg-background-parchment text-primary text-xs font-bold uppercase tracking-wider rounded border border-primary/20">
                <span class="lang-en">{tag}</span>
                <span class="lang-ml font-malayalam tracking-normal">{tagsMl[idx]}</span>
              </span>
            )})}
          </div>

          <div class="pt-6 border-t border-accent-gold/25">
            <p class="lang-en text-sm text-primary font-medium italic font-serif leading-relaxed">
              "Today, Dr. P. Abdul Sathar Gurukkal continues to guide the institution, entrusting the complete knowledge of their ancestral Siddhis and healing traditions to the next generations, ensuring the purity of this sacred lineage will continue for years to come."
            </p>
            <p class="lang-ml font-malayalam text-sm text-primary font-medium italic leading-relaxed">
              "ഇന്നും ഡോ. പി. അബ്ദുൾ സതാർ ഗുരുക്കൾ ഈ സ്ഥാപനത്തിന് മാർഗ്ഗനിർദ്ദേശം നൽകുന്നു. അവരുടെ പൂർവ്വിക സിദ്ധികളുടെയും ചികിത്സാ രീതികളുടെയും പൂർണ്ണമായ അറിവ് അടുത്ത തലമുറകളെ വിശ്വസിപ്പിച്ചേൽപ്പിക്കുകയും, ഈ പവിത്രമായ പാരമ്പര്യത്തിന്റെ പരിശുദ്ധി വരും വർഷങ്ങളിലും തുടരുമെന്ന് ഉറപ്പാക്കുകയും ചെയ്യുന്നു."
            </p>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- Other Doctors Grid -->
  <Section background="cream">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="lang-en text-3xl md:text-5xl text-primary-dark">Our Medical <span class="text-accent-gold">Panel</span></h2>
      <h2 class="lang-ml font-malayalam text-3xl md:text-5xl text-primary-dark">ഞങ്ങളുടെ ചികിത്സാ <span class="text-accent-gold">വിദഗ്ധർ</span></h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-5xl mx-auto">
      {otherDoctors.map(doctor => (
        <div class="bg-white group shadow-lg hover:shadow-xl transition-all border border-accent-gold/10 overflow-hidden flex flex-col sm:flex-row">
          <div class="sm:w-1/3 aspect-[3/4] sm:aspect-auto overflow-hidden">
            <img src={doctor.image} alt={doctor.nameEn} class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-110" style="image-rendering: -webkit-optimize-contrast; image-rendering: crisp-edges;" />
          </div>
          <div class="sm:w-2/3 p-8 space-y-4">
            <div>
              <h3 class="lang-en text-2xl font-bold text-primary-dark group-hover:text-accent-gold transition-colors">{doctor.nameEn}</h3>
              <h3 class="lang-ml font-malayalam text-2xl font-bold text-primary-dark group-hover:text-accent-gold transition-colors">{doctor.nameMl}</h3>
              <p class="lang-en text-earth text-sm font-bold uppercase tracking-widest">{doctor.titleEn}</p>
              <p class="lang-ml font-malayalam text-earth text-sm font-bold tracking-widest">{doctor.titleMl}</p>
            </div>
            <p class="text-sm text-text-muted font-sans ">{doctor.qualifications}</p>
            <div class="flex items-center gap-2 text-xs text-text-muted font-sans uppercase font-bold tracking-wider">
              <Clock size={14} className="text-accent-gold" />
              <span class="lang-en">{doctor.experienceEn} Experience</span>
              <span class="lang-ml font-malayalam tracking-normal">{doctor.experienceMl}</span>
            </div>
            <div class="flex flex-wrap gap-2 pt-2">
              {doctor.specialisationsEn.map((spec, idx) => (
                <span class="text-[10px] px-2 py-0.5 bg-background-parchment text-primary font-bold uppercase border border-primary/20 rounded">
                  <span class="lang-en">{spec}</span>
                  <span class="lang-ml font-malayalam tracking-normal">{doctor.specialisationsMl[idx]}</span>
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <Footer slot="footer" />
</BaseLayout>
