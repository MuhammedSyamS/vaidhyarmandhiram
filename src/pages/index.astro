---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import FounderSpotlight from '../components/FounderSpotlight.astro';
import TreatmentsGrid from '../components/TreatmentsGrid.astro';
import ConsultationOptions from '../components/ConsultationOptions.astro';
import SheCarePackage from '../components/SheCarePackage.astro';
import FAQ from '../components/FAQ.astro';
import { CheckCircle2, Star, Quote, Award, Shield, FileCheck } from 'lucide-react';

interface Testimonial {
  type: "youtube" | "video" | "image";
  name: string;
  city: string;
  rating: number;
  videoId?: string;
  videoSrc?: string;
  image?: string | null;
  text?: string;
  isSheCare?: boolean;
}

const testimonials: Testimonial[] = [
  {
    type: "text" as any,
    name: "Sunil Kumar",
    city: "Google Review",
    text: "Excellent service and authentic Ayurvedic treatments. The doctors are highly experienced and the staff is very caring. The Panchakarma treatment helped me immensely with my back pain.",
    rating: 5,
  },
  {
    type: "text" as any,
    name: "Anjali Menon",
    city: "Google Review",
    text: "Vaidyarmandiram provides a very calm and healing environment. I underwent stress management therapy here and the results were incredible. Truly the best Ayurveda hospital in Trivandrum.",
    rating: 5,
  },
  {
    type: "text" as any,
    name: "Ramesh Nair",
    city: "Google Review",
    text: "I was suffering from severe joint pain for years. The personalized care and specific treatments prescribed by the doctors gave me great relief. Highly recommended.",
    rating: 5,
  },
  {
    type: "youtube",
    name: "Mrs. Lateesha",
    city: "Patient Testimonial",
    videoId: "UTZ7tBpqD9s",
    image: null,
    rating: 5,
  },
  {
    type: "youtube",
    name: "Nikhi",
    city: "Patient Testimonial",
    videoId: "OKdHB708p6I",
    image: null,
    rating: 5,
  },
  {
    type: "youtube",
    name: "Mrs. Bismi",
    city: "Patient Testimonial",
    videoId: "s-ehW3aamw0",
    image: null,
    rating: 5,
  },
  {
    type: "youtube",
    name: "Ms. Reshmi",
    city: "Patient Testimonial",
    videoId: "tpC90rfXm4I",
    image: null,
    rating: 5,
  },
  {
    type: "youtube",
    name: "Mrs. Jyothi",
    city: "Patient Testimonial",
    videoId: "AJtjtI7SkQA",
    image: null,
    rating: 5,
  },
  {
    type: "youtube",
    name: "Al Sila",
    city: "Patient Testimonial",
    videoId: "s0l83M4YfiU",
    image: null,
    rating: 5,
  },
  {
    type: "youtube",
    name: "Simi",
    city: "Patient Testimonial",
    videoId: "obJ0o76Clm0",
    image: null,
    rating: 5,
  },
  {
    type: "youtube",
    name: "Miss Athira",
    city: "Patient Testimonial",
    videoId: "hFZLc__xZRM",
    image: null,
    rating: 5,
  },
  {
    type: "youtube",
    name: "Husna Safeer",
    city: "Patient Testimonial",
    videoId: "SkjO74mjr1A",
    image: null,
    rating: 5,
  },
  {
    type: "image",
    name: "Mrs. Abhinu Sreejith",
    city: "Postpartum Care",
    image: "https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/abhinu_sreejith.jpeg",
    rating: 5,
    isSheCare: true
  }
];
---

<BaseLayout title="Best Ayurveda Clinic in Trivandrum | Traditional Ayurvedic Hospital" description="Recognized as the best Ayurveda clinic in Trivandrum, Vaidyarmandiram Hospital offers authentic Panchakarma treatments, spine care, and holistic healing.">
  <Header slot="header" />

  <Hero />

  <!-- Treatments Preview -->
  <Section id="treatments" background="white">
    <div class="text-center max-w-3xl mx-auto mb-16" data-aos="fade-up">
      <span class="lang-en text-accent-gold font-sans uppercase tracking-[0.3em] text-sm font-bold">Our Expertise</span>
      <span class="lang-ml font-malayalam text-accent-gold text-base font-semibold block">ഞങ്ങളുടെ വൈദഗ്ദ്ധ്യം</span>
      <h2 class="lang-en text-4xl md:text-5xl text-primary-dark mt-3 mb-6 font-serif">Healing Through Tradition</h2>
      <div class="lang-ml font-malayalam block text-4xl md:text-5xl text-primary-dark mt-3 mb-6 font-bold">പൈതൃകത്തിലൂടെ സൗഖ്യം</div>
      <p class="lang-en text-primary-dark font-sans text-lg">
        We offer a comprehensive range of traditional Ayurvedic treatments, each personalized to your unique body constitution (Prakriti).
      </p>
      <p class="lang-ml font-malayalam text-primary-dark text-lg">
        ഓരോ വ്യക്തിയുടെയും ശരീരഘടനയ്ക്ക് (പ്രകൃതി) അനുസൃതമായ വൈവിധ്യമാർന്ന ആയുർവേദ ചികിത്സകൾ ഞങ്ങൾ നൽകുന്നു.
      </p>
    </div>
    <TreatmentsGrid />
    <div class="text-center mt-12">
      <a href="/treatments" class="btn-outline">
        <span class="lang-en">View All Treatments</span>
        <span class="lang-ml font-malayalam normal-case tracking-normal">എല്ലാ ചികിത്സകളും കാണൂ</span>
      </a>
    </div>
  </Section>

  <!-- Premium Trust Accreditation Strip -->
  <div class="relative bg-cover bg-center py-6 md:py-10 border-b border-accent-gold/20 overflow-hidden" style="background-image: url('https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/herbal-garden-2.jpg');" data-aos="fade-up">
    <div class="absolute inset-0 bg-white/60 backdrop-blur-[1px] z-0"></div>
    <div class="container mx-auto px-2 sm:px-4 relative z-10">
      <div class="grid grid-cols-3 gap-2 sm:gap-4 md:gap-6 max-w-5xl mx-auto">
        {[
          { 
            en: 'Accredited Hospital', 
            ml: 'അക്രഡിറ്റഡ് ഹോസ്പിറ്റൽ', 
            badge: 'NABH APPROVED', 
            badgeML: 'NABH അംഗീകൃത',
            icon: Shield
          },
          { 
            en: 'Government Certified', 
            ml: 'ഗവൺമെന്റ് സർട്ടിഫൈഡ്', 
            badge: 'MINISTRY OF AYUSH', 
            badgeML: 'മിനിസ്ട്രി ഓഫ് ആയുഷ്',
            icon: Award
          },
          { 
            en: 'Quality Management', 
            ml: 'ഗുണനിലവാര മാനേജ്മെൻ്റ്', 
            badge: 'ISO 9001:2015', 
            badgeML: 'ISO 9001:2015',
            icon: FileCheck
          },
        ].map((item, index) => {
          const IconComponent = item.icon;
          return (
            <div class="flex flex-col md:flex-row items-center gap-1.5 sm:gap-3 md:gap-4 bg-white p-2.5 sm:p-4 md:p-5 rounded-lg md:rounded-xl border border-accent-gold/15 shadow-sm hover:shadow-md md:hover:-translate-y-0.5 transition-all duration-300 group text-center md:text-left" data-aos="zoom-in" data-aos-delay={index * 100}>
              <div class="w-8 h-8 md:w-12 md:h-12 rounded-full bg-primary/5 flex items-center justify-center border border-accent-gold/10 group-hover:bg-accent-gold/10 transition-colors duration-300 shrink-0">
                <IconComponent className="text-accent-gold w-4 h-4 md:w-6 md:h-6" />
              </div>
              <div class="flex flex-col">
                <span class="lang-en text-[7px] sm:text-[9px] md:text-[10px] font-sans tracking-wider md:tracking-[0.15em] text-text-muted uppercase font-bold">{item.en}</span>
                <span class="lang-ml font-malayalam text-[8px] sm:text-[10px] md:text-xs text-text-muted font-bold leading-tight">{item.ml}</span>
                <span class="lang-en text-[9px] sm:text-xs md:text-sm font-serif font-bold text-primary-dark tracking-wide mt-0.5 leading-tight">{item.badge}</span>
                <span class="lang-ml font-malayalam text-[9px] sm:text-xs md:text-sm font-bold text-primary-dark mt-0.5 leading-tight">{item.badgeML}</span>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <!-- Founder Spotlight -->
  <Section id="founder" background="white" withDivider={true} className="hidden md:block">
    <FounderSpotlight />
  </Section>

  <!-- She Care Package -->
  <SheCarePackage />

  <!-- Consultation Options -->
  <ConsultationOptions />

  <!-- Testimonials -->
  <Section background="white" withDivider={true}>
    <div class="text-center max-w-3xl mx-auto mb-12" data-aos="fade-up">
      <span class="lang-en text-accent-gold font-sans uppercase tracking-[0.3em] text-sm font-bold">Patient Stories</span>
      <span class="lang-ml font-malayalam text-accent-gold text-base font-semibold block">രോഗി അനുഭവങ്ങൾ</span>
      <h2 class="lang-en text-3xl md:text-5xl text-primary-dark mt-3 font-serif">Healing Journeys</h2>
      <h2 class="lang-ml font-malayalam text-3xl md:text-5xl text-primary-dark mt-3 font-bold">സൗഖ്യ യാത്രകൾ</h2>
      
      <!-- Google Reviews Badge -->
      <a href="https://maps.app.goo.gl/NynzVNVwV4XEYYpJ7" target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex items-center gap-4 bg-white px-6 py-3 rounded-full border border-gray-200 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all cursor-pointer group">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="w-6 h-6 group-hover:scale-110 transition-transform shrink-0">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
          <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
        </svg>
        <div class="flex flex-col items-start">
          <div class="flex items-center gap-1.5">
            <span class="font-bold text-gray-900 text-sm">4.9</span>
            <div class="flex gap-0.5">
              {[...Array(5)].map(() => <Star className="text-[#fbbc05] fill-[#fbbc05]" size={14} />)}
            </div>
          </div>
          <span class="text-[10px] text-gray-500 font-sans tracking-wide">Based on 350+ reviews</span>
        </div>
      </a>
    </div>

    <div class="relative max-w-[1400px] mx-auto px-6 md:px-12 group/carousel">
      <div 
        id="testimonials-scroll-container"
        class="flex overflow-x-auto snap-x snap-mandatory gap-6 md:gap-8 pb-6 md:pb-0 scrollbar-none items-stretch"
      >
        {testimonials.map(t => (
          <div class="bg-white shadow-[0_4px_20px_rgba(0,0,0,0.06)] border border-gray-100 rounded-2xl relative hover:shadow-xl transition-all duration-300 w-[75vw] sm:w-[260px] md:w-[280px] snap-center shrink-0 testimonial-card flex flex-col group overflow-hidden">
            
            {t.type === 'video' ? (
              <div class="relative w-full aspect-[9/16] overflow-hidden bg-black flex-grow cursor-pointer video-wrapper group">
                <video 
                  data-src={t.videoSrc} 
                  poster={t.image || undefined}
                  loop muted playsinline preload="none"
                  class="absolute inset-0 w-full h-full object-cover opacity-95 testimonial-video"
                ></video>
                <div class="absolute inset-0 bg-black/30 flex items-center justify-center transition-opacity duration-300 video-overlay group-hover:bg-black/40">
                  <button aria-label="Toggle Video" class="w-16 h-16 rounded-full bg-white/25 backdrop-blur-sm border border-white/50 text-white flex items-center justify-center transition-all duration-300 video-toggle-btn shadow-xl scale-95 group-hover:scale-105 group-hover:bg-accent-gold group-hover:border-accent-gold">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor" stroke="none" class="play-icon ml-1.5"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor" stroke="none" class="pause-icon hidden"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
                  </button>
                </div>
              </div>
            ) : t.type === 'youtube' ? (
              <div class="relative w-full aspect-[9/16] overflow-hidden bg-black flex-grow">
                <iframe 
                  src={`https://www.youtube.com/embed/${t.videoId}?rel=0&modestbranding=1&controls=1&playsinline=1`} 
                  class="absolute inset-0 w-full h-full border-0"
                  title={t.name}
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                  allowfullscreen
                ></iframe>
              </div>
            ) : t.type === 'image' && t.image ? (
              <div class="relative w-full aspect-[9/16] overflow-hidden bg-gray-100 flex-grow border-b border-gray-50">
                <img src={t.image} alt="Patient photo" class="w-full h-full object-cover" />
              </div>
            ) : (
              <div class="p-6 flex-grow flex items-center justify-center text-center">
                <p class="text-gray-600 leading-relaxed font-sans text-sm italic">"{t.text}"</p>
              </div>
            )}

            <div class="p-4 sm:p-5 flex flex-col items-center justify-center text-center bg-white border-t border-gray-50 z-10 relative">
              <p class="font-bold text-primary-dark font-sans text-base leading-tight">{t.name}</p>
              <p class="text-[11px] text-accent-gold font-sans mt-1 uppercase tracking-[0.1em] font-semibold">{t.city}</p>
            </div>

          </div>
        ))}
      </div>

      <!-- Navigation Arrows (Absolute positioning on sides) -->
      <button id="testimonial-prev" aria-label="Previous Testimonial" class="absolute top-1/2 -left-2 md:-left-4 -translate-y-1/2 w-12 h-12 bg-white/90 backdrop-blur shadow-[0_4px_20px_rgba(0,0,0,0.12)] rounded-full border border-accent-gold/20 items-center justify-center text-accent-gold hover:bg-accent-gold hover:text-white hover:scale-105 transition-all duration-300 z-10 hidden sm:flex group">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-0.5 transition-transform"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button id="testimonial-next" aria-label="Next Testimonial" class="absolute top-1/2 -right-2 md:-right-4 -translate-y-1/2 w-12 h-12 bg-white/90 backdrop-blur shadow-[0_4px_20px_rgba(0,0,0,0.12)] rounded-full border border-accent-gold/20 items-center justify-center text-accent-gold hover:bg-accent-gold hover:text-white hover:scale-105 transition-all duration-300 z-10 hidden sm:flex group">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-0.5 transition-transform"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>

    <style>
      .scrollbar-none::-webkit-scrollbar {
        display: none;
      }
      .scrollbar-none {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>

    <script>
      function setupTestimonialScroll() {
        const container = document.getElementById('testimonials-scroll-container') as HTMLElement;
        if (!container || container.dataset.initialized) return;
        container.dataset.initialized = 'true';

        const prevBtn = document.getElementById('testimonial-prev');
        const nextBtn = document.getElementById('testimonial-next');

        // Clone nodes for infinite scroll effect
        const originalItems = Array.from(container.querySelectorAll('.testimonial-card')) as HTMLElement[];
        if (originalItems.length === 0) return;

        const originalCount = originalItems.length;
        
        originalItems.forEach(item => {
          container.appendChild(item.cloneNode(true));
        });
        
        [...originalItems].reverse().forEach(item => {
          container.insertBefore(item.cloneNode(true), container.firstChild);
        });

        const allItems = Array.from(container.querySelectorAll('.testimonial-card')) as HTMLElement[];
        let currentIndex = originalCount;
        let autoScrollInterval: ReturnType<typeof setInterval>;
        let isUserInteracting = false;
        let isProgrammaticScroll = false;
        let scrollTimeout: ReturnType<typeof setTimeout>;
        let interactionTimeout: ReturnType<typeof setTimeout>;

        // Lazy pause videos when they leave viewport (no autoplay)
        const videoObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            const vid = entry.target as HTMLVideoElement;
            if (!entry.isIntersecting) {
              vid.pause();
              const wrapper = vid.closest('.video-wrapper');
              if (wrapper && wrapper.classList.contains('playing')) {
                const btn = wrapper.querySelector('.video-toggle-btn');
                btn?.querySelector('.play-icon')?.classList.remove('hidden');
                btn?.querySelector('.pause-icon')?.classList.add('hidden');
                wrapper.classList.remove('playing');
              }
            }
          });
        }, {
          root: container,
          threshold: 0.1
        });

        allItems.forEach(item => {
          const vid = item.querySelector('video');
          if (vid) {
            videoObserver.observe(vid);
          }
        });

        const scrollToItem = (index: number, instant = false) => {
          const item = allItems[index];
          if (!item) return;
          const target = item.offsetLeft - container.offsetLeft - (container.offsetWidth / 2) + (item.offsetWidth / 2);
          
          isProgrammaticScroll = true;
          clearTimeout(scrollTimeout);
          
          container.style.scrollSnapType = 'none';
          
          if (instant) {
            container.style.scrollBehavior = 'auto';
            container.scrollLeft = target;
            scrollTimeout = setTimeout(() => {
              container.style.scrollBehavior = '';
              container.style.scrollSnapType = '';
              isProgrammaticScroll = false;
            }, 50);
          } else {
            container.style.scrollBehavior = 'smooth';
            container.scrollLeft = target;
            scrollTimeout = setTimeout(() => {
              container.style.scrollBehavior = '';
              container.style.scrollSnapType = '';
              isProgrammaticScroll = false;
            }, 700);
          }
        };

        const resetIfNeeded = () => {
          if (currentIndex < Math.floor(originalCount / 2) || currentIndex >= originalCount * 2 + Math.ceil(originalCount / 2)) {
            const relativeIndex = ((currentIndex % originalCount) + originalCount) % originalCount;
            currentIndex = originalCount + relativeIndex;
            scrollToItem(currentIndex, true);
          }
        };

        const slideToNext = (force = false) => {
          if (isUserInteracting && !force) return;
          currentIndex++;
          scrollToItem(currentIndex, false);
          setTimeout(resetIfNeeded, 750);
        };

        const slideToPrev = (force = false) => {
          if (isUserInteracting && !force) return;
          currentIndex--;
          scrollToItem(currentIndex, false);
          setTimeout(resetIfNeeded, 750);
        };

        const startAutoScroll = () => {
          stopAutoScroll();
          autoScrollInterval = setInterval(slideToNext, 4500);
        };

        const stopAutoScroll = () => {
          if (autoScrollInterval) clearInterval(autoScrollInterval);
        };

        // Event Listeners for arrows
        if (prevBtn) {
          prevBtn.addEventListener('click', () => {
            onInteractionStart();
            slideToPrev(true);
            onInteractionEnd();
          });
        }
        if (nextBtn) {
          nextBtn.addEventListener('click', () => {
            onInteractionStart();
            slideToNext(true);
            onInteractionEnd();
          });
        }

        const onInteractionStart = () => {
          isUserInteracting = true;
          stopAutoScroll();
          clearTimeout(interactionTimeout);
        };

        const onInteractionEnd = () => {
          clearTimeout(interactionTimeout);
          interactionTimeout = setTimeout(() => {
            isUserInteracting = false;
            startAutoScroll();
          }, 4000);
        };

        container.addEventListener('mouseenter', onInteractionStart);
        container.addEventListener('mouseleave', onInteractionEnd);
        container.addEventListener('touchstart', onInteractionStart, { passive: true });
        container.addEventListener('touchend', onInteractionEnd, { passive: true });

        // Video Play/Pause Logic
        const allWrappers = Array.from(container.querySelectorAll('.video-wrapper')) as HTMLElement[];

        allWrappers.forEach((wrapper) => {
          wrapper.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            
            const vid = wrapper.querySelector('.testimonial-video') as HTMLVideoElement;
            const playIcon = wrapper.querySelector('.play-icon');
            const pauseIcon = wrapper.querySelector('.pause-icon');
            const overlay = wrapper.querySelector('.video-overlay');

            if (vid.paused) {
              // Pause any other currently playing videos
              container.querySelectorAll('.testimonial-video').forEach((v: any) => {
                if (v !== vid && !v.paused) {
                  v.pause();
                  v.muted = true;
                  const otherWrapper = v.closest('.video-wrapper');
                  if (otherWrapper) {
                    otherWrapper.querySelector('.play-icon')?.classList.remove('hidden');
                    otherWrapper.querySelector('.pause-icon')?.classList.add('hidden');
                    otherWrapper.querySelector('.video-overlay')?.classList.remove('opacity-0');
                    otherWrapper.classList.remove('playing');
                  }
                }
              });

              if (!vid.getAttribute('src')) {
                const dataSrc = vid.getAttribute('data-src');
                if (dataSrc) {
                  vid.setAttribute('src', dataSrc);
                }
              }

              const playPromise = vid.play();
              if (playPromise !== undefined) {
                playPromise.then(() => {
                  vid.muted = false;
                  playIcon?.classList.add('hidden');
                  pauseIcon?.classList.remove('hidden');
                  overlay?.classList.add('opacity-0'); // Hide overlay to watch video clearly
                  wrapper.classList.add('playing');
                }).catch((err) => {
                  console.error('Video playback failed:', err);
                });
              } else {
                vid.muted = false;
                playIcon?.classList.add('hidden');
                pauseIcon?.classList.remove('hidden');
                overlay?.classList.add('opacity-0');
                wrapper.classList.add('playing');
              }
              
              // Permanent pause of carousel while watching
              isUserInteracting = true;
              stopAutoScroll();
              clearTimeout(interactionTimeout);
            } else {
              vid.pause();
              vid.muted = true;
              
              playIcon?.classList.remove('hidden');
              pauseIcon?.classList.add('hidden');
              overlay?.classList.remove('opacity-0'); // Show play button again
              wrapper.classList.remove('playing');
              
              // Resume carousel
              isUserInteracting = false;
              startAutoScroll();
            }
          });
        });

        // Initial setup
        scrollToItem(currentIndex, true);
        startAutoScroll();
      }

      setupTestimonialScroll();
      document.addEventListener('astro:page-load', setupTestimonialScroll);
    </script>
