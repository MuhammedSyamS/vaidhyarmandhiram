---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import Section from '../components/Section.astro';
import FounderSpotlight from '../components/FounderSpotlight.astro';
import TreatmentsGrid from '../components/TreatmentsGrid.astro';
import ConsultationOptions from '../components/ConsultationOptions.astro';
import SheCarePackage from '../components/SheCarePackage.astro';
import { CheckCircle2, Star, Quote, Award, Shield, FileCheck } from 'lucide-react';

export const prerender = true;

const testimonials = [
  {
    name: "Rajesh Kumar",
    city: "Kochi",
    text: "The Panchakarma treatment here was life-changing. I feel like a new person. The staff is professional and the environment is so peaceful.",
    rating: 5
  },
  {
    name: "Anjali Menon",
    city: "Trivandrum",
    text: "I had chronic back pain for years. After 14 days of Kativasti and Pizhichil, I am finally pain-free. Dr. Sathar is a true healer.",
    rating: 5
  },
  {
    name: "Sarah Johnson",
    city: "London",
    text: "Authentic Ayurveda at its best. No commercial gimmicks, just pure tradition and effective healing. Highly recommended.",
    rating: 5
  }
];
---

<BaseLayout title="Home">
  <Header slot="header" />

  <Hero />

  <!-- Treatments Preview -->
  <Section id="treatments" background="white">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="lang-en text-accent-gold font-sans uppercase tracking-[0.3em] text-sm font-bold">Our Expertise</span>
      <span class="lang-ml font-malayalam text-accent-gold text-base font-semibold block">ഞങ്ങളുടെ വൈദഗ്ദ്ധ്യം</span>
      <h2 class="lang-en text-4xl md:text-5xl text-primary-dark mt-3 mb-6 font-serif">Healing Through Tradition</h2>
      <h2 class="lang-ml font-malayalam text-4xl md:text-5xl text-primary-dark mt-3 mb-6 font-bold">പൈതൃകത്തിലൂടെ സൗഖ്യം</h2>
      <p class="lang-en text-primary-dark font-sans text-lg">
        We offer a comprehensive range of traditional Ayurvedic treatments, each personalized to your unique body constitution (Prakriti).
      </p>
      <p class="lang-ml font-malayalam text-primary-dark text-lg">
        ഓരോ വ്യക്തിയുടെയും ശരീരഘടനയ്ക്ക് (പ്രകൃതി) അനുസൃതമായ വൈവിധ്യമാർന്ന ആയുർവേദ ചികിത്സകൾ ഞങ്ങൾ നൽകുന്നു.
      </p>
    </div>
    <TreatmentsGrid />
    <div class="text-center mt-12">
      <a href="/treatments" class="btn-outline">
        <span class="lang-en">View All Treatments</span>
        <span class="lang-ml font-malayalam normal-case tracking-normal">എല്ലാ ചികിത്സകളും കാണൂ</span>
      </a>
    </div>
  </Section>

  <!-- Premium Trust Accreditation Strip -->
  <div class="bg-white py-6 md:py-10 border-b border-accent-gold/20">
    <div class="container mx-auto px-2 sm:px-4">
      <div class="grid grid-cols-3 gap-2 sm:gap-4 md:gap-6 max-w-5xl mx-auto">
        {[
          { 
            en: 'Accredited Hospital', 
            ml: 'അക്രഡിറ്റഡ് ഹോസ്പിറ്റൽ', 
            badge: 'NABH APPROVED', 
            badgeML: 'NABH അംഗീകൃത',
            icon: Shield
          },
          { 
            en: 'Government Certified', 
            ml: 'ഗവൺമെന്റ് സർട്ടിഫൈഡ്', 
            badge: 'MINISTRY OF AYUSH', 
            badgeML: 'മിനിസ്ട്രി ഓഫ് ആയുഷ്',
            icon: Award
          },
          { 
            en: 'Quality Management', 
            ml: 'ഗുണനിലവാര മാനേജ്മെൻ്റ്', 
            badge: 'ISO 9001:2015', 
            badgeML: 'ISO 9001:2015',
            icon: FileCheck
          },
        ].map(item => {
          const IconComponent = item.icon;
          return (
            <div class="flex flex-col md:flex-row items-center gap-1.5 sm:gap-3 md:gap-4 bg-white p-2.5 sm:p-4 md:p-5 rounded-lg md:rounded-xl border border-accent-gold/15 shadow-sm hover:shadow-md md:hover:-translate-y-0.5 transition-all duration-300 group text-center md:text-left">
              <div class="w-8 h-8 md:w-12 md:h-12 rounded-full bg-primary/5 flex items-center justify-center border border-accent-gold/10 group-hover:bg-accent-gold/10 transition-colors duration-300 shrink-0">
                <IconComponent class="text-accent-gold w-4 h-4 md:w-6 md:h-6" />
              </div>
              <div class="flex flex-col">
                <span class="lang-en text-[7px] sm:text-[9px] md:text-[10px] font-sans tracking-wider md:tracking-[0.15em] text-text-muted uppercase font-bold">{item.en}</span>
                <span class="lang-ml font-malayalam text-[8px] sm:text-[10px] md:text-xs text-text-muted font-bold leading-tight">{item.ml}</span>
                <span class="lang-en text-[9px] sm:text-xs md:text-sm font-serif font-bold text-primary-dark tracking-wide mt-0.5 leading-tight">{item.badge}</span>
                <span class="lang-ml font-malayalam text-[9px] sm:text-xs md:text-sm font-bold text-primary-dark mt-0.5 leading-tight">{item.badgeML}</span>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <Stats />

  <!-- Founder Spotlight -->
  <Section id="founder" background="white" withDivider={true} className="hidden md:block">
    <FounderSpotlight />
  </Section>

  <!-- She Care Package -->
  <SheCarePackage />

  <!-- Consultation Options -->
  <ConsultationOptions />

  <!-- Testimonials -->
  <Section background="white" withDivider={true}>
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="lang-en text-accent-gold font-sans uppercase tracking-[0.3em] text-sm font-bold">Patient Stories</span>
      <span class="lang-ml font-malayalam text-accent-gold text-base font-semibold block">രോഗി അനുഭവങ്ങൾ</span>
      <h2 class="lang-en text-3xl md:text-5xl text-primary-dark mt-3 font-serif">Healing Journeys</h2>
      <h2 class="lang-ml font-malayalam text-3xl md:text-5xl text-primary-dark mt-3 font-bold">സൗഖ്യ യാത്രകൾ</h2>
    </div>
    <div 
      id="testimonials-scroll-container"
      class="flex md:grid overflow-x-auto md:overflow-x-visible snap-x snap-mandatory md:grid-cols-3 gap-6 md:gap-8 pb-6 md:pb-0 scrollbar-none"
    >
      {testimonials.map(t => (
        <div class="bg-white p-6 sm:p-8 shadow-md border border-accent-gold/15 rounded-2xl relative hover:shadow-lg transition-shadow duration-300 w-[75vw] sm:w-[350px] md:w-auto snap-center shrink-0 testimonial-card">
          <Quote class="absolute top-4 right-4 text-accent-gold/10" size={48} />
          <div class="flex gap-1 mb-4">
            {[...Array(t.rating)].map(() => <Star class="text-accent-gold fill-accent-gold" size={16} />)}
          </div>
          <p class="text-primary-dark mb-6 leading-relaxed font-sans">"{t.text}"</p>
          <div class="border-t border-accent-gold/10 pt-4">
            <p class="font-bold text-primary-dark font-serif text-lg">{t.name}</p>
            <p class="text-xs text-text-muted uppercase tracking-widest font-bold font-sans mt-0.5">{t.city}</p>
          </div>
        </div>
      ))}
    </div>

    <style>
      .scrollbar-none::-webkit-scrollbar {
        display: none;
      }
      .scrollbar-none {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>

    <script>
      function setupAutoScroll() {
        const container = document.getElementById('testimonials-scroll-container') as HTMLElement;
        if (!container) return;

        let autoScrollInterval: ReturnType<typeof setInterval>;
        const items = Array.from(container.querySelectorAll('.testimonial-card')) as HTMLElement[];
        let currentIndex = 0;
        let isProgrammaticScroll = false;

        const updateIndex = () => {
          if (items.length === 0) return;
          const scrollLeft = container.scrollLeft;
          const centerOffset = container.offsetWidth / 2;
          const scrollCenter = scrollLeft + centerOffset;
          
          let closestIndex = 0;
          let minDistance = Infinity;
          
          items.forEach((item, idx) => {
            const itemCenter = item.offsetLeft + item.offsetWidth / 2;
            const distance = Math.abs(scrollCenter - itemCenter);
            if (distance < minDistance) {
              minDistance = distance;
              closestIndex = idx;
            }
          });
          
          currentIndex = closestIndex;
        };

        container.addEventListener('scroll', () => {
          if (!isProgrammaticScroll) {
            updateIndex();
          }
        }, { passive: true });

        const startAutoScroll = () => {
          stopAutoScroll();

          // Only auto-scroll on mobile/tablet (below 768px screen width)
          if (window.innerWidth >= 768) return;

          autoScrollInterval = setInterval(() => {
            if (items.length === 0) return;

            currentIndex++;
            if (currentIndex >= items.length) {
              currentIndex = 0;
            }

            isProgrammaticScroll = true;

            const targetItem = items[currentIndex];
            const scrollTarget = targetItem.offsetLeft - (container.offsetWidth / 2) + (targetItem.offsetWidth / 2);

            container.scrollTo({
              left: scrollTarget,
              behavior: 'smooth'
            });

            setTimeout(() => {
              isProgrammaticScroll = false;
            }, 1000);
          }, 4500);
        };

        const stopAutoScroll = () => {
          if (autoScrollInterval) clearInterval(autoScrollInterval);
        };

        container.addEventListener('touchstart', stopAutoScroll, { passive: true });
        container.addEventListener('touchend', startAutoScroll);

        startAutoScroll();
        window.addEventListener('resize', startAutoScroll);
      }

      // Initialize auto-scroll
      setupAutoScroll();

      // Re-run safely on Astro page transitions
      document.addEventListener('astro:page-load', setupAutoScroll);
    </script>
  </Section>

  <!-- CTA Banner -->
  <div class="bg-primary-dark py-24 relative overflow-hidden">
    <!-- Smooth Top Wave Transition -->
    <div class="absolute top-0 left-0 w-full overflow-hidden leading-none z-10 transform rotate-180">
      <svg viewBox="0 0 1200 120" preserveAspectRatio="none" class="relative block w-full h-[40px] text-background-parchment fill-current">
        <path d="M985.66,92.83C906.67,72,823.78,31,743.84,14.19c-82.26-17.34-168.06-16.33-250.45.39-57.84,11.73-114,31.07-172,41.86A600.21,600.21,0,0,1,0,27.35V120H1200V95.8C1132.19,118.92,1055.71,111.31,985.66,92.83Z"></path>
      </svg>
    </div>

    <div class="absolute inset-0 opacity-10 pointer-events-none">
      <div class="absolute top-0 left-0 w-64 h-64 bg-accent-gold rounded-full blur-[100px]"></div>
      <div class="absolute bottom-0 right-0 w-96 h-96 bg-background-parchment rounded-full blur-[120px]"></div>
    </div>
    
    <div class="container mx-auto px-4 text-center relative z-10 mt-6">
      <h2 class="lang-en text-3xl md:text-6xl text-background-parchment mb-6 font-serif leading-tight">
        Ready to Begin Your <br/><span class="text-accent-gold">Path to Wellness?</span>
      </h2>
      <h2 class="lang-ml font-malayalam text-3xl md:text-5xl text-background-parchment mb-6 font-bold">
        <span class="text-accent-gold">ആരോഗ്യ</span>ത്തിലേക്കുള്ള യാത്ര ആരംഭിക്കാൻ തയ്യാറാണോ?
      </h2>
      <p class="lang-en text-background-parchment/80 text-lg md:text-xl mb-10 max-w-2xl mx-auto font-sans">
        Schedule your consultation with our experienced physicians and experience authentic traditional healing.
      </p>
      <p class="lang-ml font-malayalam text-background-parchment/80 text-lg mb-10 max-w-2xl mx-auto">
        ഞങ്ങളുടെ വിദഗ്ദ്ധ ഡോക്ടർമാരുമായി ഒരു കൺസൾട്ടേഷൻ ഷെഡ്യൂൾ ചെയ്ത് ആധികാരിക ചികിത്സ അനുഭവിക്കൂ.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-6">
        <a href="/appointment" class="btn-primary !bg-accent-gold !text-primary-dark text-xl px-12 py-4 shadow-xl hover:shadow-accent-gold/25 hover:-translate-y-0.5 transition-all">
          <span class="lang-en">Book Your Appointment</span>
          <span class="lang-ml font-malayalam normal-case tracking-normal">അപ്പോയിന്റ്മെന്റ് ബുക്ക് ചെയ്യൂ</span>
        </a>
        <a href="https://wa.me/918593821553" class="btn-outline !border-background-parchment !text-background-parchment hover:!bg-background-parchment hover:!text-primary-dark text-xl px-12 py-4 flex items-center justify-center hover:-translate-y-0.5 transition-all">
          <span class="lang-en">WhatsApp Us</span>
          <span class="lang-ml font-malayalam normal-case tracking-normal">വാട്സ്ആപ്പ് ചെയ്യൂ</span>
        </a>
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>
