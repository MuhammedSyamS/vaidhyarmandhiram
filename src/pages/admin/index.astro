    <!-- ================================= MODAL: NEW BLOG ARTICLE ================================= -->
    <div id="modal-blog" class="fixed inset-0 bg-black/75 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
      <div class="bg-brand-card border border-brand-border rounded-2xl w-full max-w-2xl max-h-[90vh] flex flex-col shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
        <div class="p-5 border-b border-brand-border flex items-center justify-between bg-brand-deep">
          <h3 class="font-bold text-white text-base">Write New Blog Article</h3>
          <button onclick="closeModal('modal-blog')" class="text-slate-400 hover:text-white text-lg">✕</button>
        </div>

        <form method="POST" class="p-6 overflow-y-auto custom-scrollbar space-y-4 text-xs">
          <input type="hidden" name="_action" value="create_blog" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block font-semibold text-slate-300 mb-1">Title (English) *</label>
              <input type="text" name="title" required placeholder="e.g. Natural Healing for Sciatica" class="w-full px-3 py-2 rounded-lg bg-brand-deep border border-brand-border text-white outline-none focus:border-brand-gold" />
            </div>
            <div>
              <label class="block font-semibold text-slate-300 mb-1">Title (Malayalam)</label>
              <input type="text" name="titleMl" placeholder="e.g. സയാറ്റിക്കയ്ക്കുള്ള ആയുർവേദ പരിഹാരം" class="w-full px-3 py-2 rounded-lg bg-brand-deep border border-brand-border text-white outline-none focus:border-brand-gold font-malayalam" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block font-semibold text-slate-300 mb-1">Category</label>
              <select name="category" class="w-full px-3 py-2 rounded-lg bg-brand-deep border border-brand-border text-white outline-none focus:border-brand-gold">
                <option value="General">General</option>
                <option value="Panchakarma">Panchakarma</option>
                <option value="Spine Care">Spine Care</option>
                <option value="Women's Health">Women's Health</option>
                <option value="Lifestyle">Lifestyle</option>
              </select>
            </div>
            <div>
              <label class="block font-semibold text-slate-300 mb-1">Cover Image URL</label>
              <input type="text" name="image" value="https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/joint-care.jpg" class="w-full px-3 py-2 rounded-lg bg-brand-deep border border-brand-border text-white outline-none focus:border-brand-gold" />
            </div>
          </div>

          <div>
            <label class="block font-semibold text-slate-300 mb-1">Short Description (English)</label>
            <textarea name="description" rows="2" placeholder="Brief summary of the article..." class="w-full px-3 py-2 rounded-lg bg-brand-deep border border-brand-border text-white outline-none focus:border-brand-gold"></textarea>
          </div>

          <div>
            <label class="block font-semibold text-slate-300 mb-1">Article Body (Markdown)</label>
            <textarea name="content" rows="8" required placeholder="Write your full article content here in Markdown..." class="w-full px-3 py-2 rounded-lg bg-brand-deep border border-brand-border text-white outline-none focus:border-brand-gold font-mono text-xs"></textarea>
          </div>

          <div class="pt-3 border-t border-brand-border flex items-center justify-end gap-3">
            <button type="button" onclick="closeModal('modal-blog')" class="px-4 py-2 rounded-lg font-semibold text-slate-400 hover:text-white">Cancel</button>
            <button type="submit" class="px-5 py-2 rounded-lg font-bold bg-emerald-600 hover:bg-emerald-500 text-white shadow-lg shadow-emerald-950 cursor-pointer">
              Publish Article
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- ================================= MODAL: NEW PATIENT REVIEW ================================= -->
    <div id="modal-review" class="fixed inset-0 bg-black/75 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
      <div class="bg-brand-card border border-brand-border rounded-2xl w-full max-w-lg max-h-[90vh] flex flex-col shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
        <div class="p-5 border-b border-brand-border flex items-center justify-between bg-brand-deep">
          <h3 class="font-bold text-white text-base">Add Patient Review</h3>
          <button onclick="closeModal('modal-review')" class="text-slate-400 hover:text-white text-lg">✕</button>
        </div>

        <form method="POST" class="p-6 overflow-y-auto custom-scrollbar space-y-4 text-xs">
          <input type="hidden" name="_action" value="create_review" />

          <div>
            <label class="block font-semibold text-slate-300 mb-1">Patient Name *</label>
            <input type="text" name="reviewerName" required placeholder="e.g. Aleena or Rahul" class="w-full px-3 py-2 rounded-lg bg-brand-deep border border-brand-border text-white outline-none focus:border-brand-gold" />
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block font-semibold text-slate-300 mb-1">Review Type</label>
              <select name="type" class="w-full px-3 py-2 rounded-lg bg-brand-deep border border-brand-border text-white outline-none focus:border-brand-gold">
                <option value="youtube">YouTube Video</option>
                <option value="text">Written Review</option>
                <option value="image">Photo Review</option>
              </select>
            </div>
            <div>
              <label class="block font-semibold text-slate-300 mb-1">Rating</label>
              <select name="rating" class="w-full px-3 py-2 rounded-lg bg-brand-deep border border-brand-border text-white outline-none focus:border-brand-gold">
                <option value="5">5 Stars (★★★★★)</option>
                <option value="4">4 Stars (★★★★)</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block font-semibold text-slate-300 mb-1">City / Label</label>
              <input type="text" name="city" placeholder="e.g. Patient Testimonial" value="Patient Testimonial" class="w-full px-3 py-2 rounded-lg bg-brand-deep border border-brand-border text-white outline-none focus:border-brand-gold" />
            </div>
            <div>
              <label class="block font-semibold text-slate-300 mb-1">YouTube Video ID (Optional)</label>
              <input type="text" name="videoId" placeholder="e.g. jaHb_aVKSE8" class="w-full px-3 py-2 rounded-lg bg-brand-deep border border-brand-border text-white outline-none focus:border-brand-gold" />
            </div>
          </div>

          <div>
            <label class="block font-semibold text-slate-300 mb-1">Patient Feedback / Story (Optional)</label>
            <textarea name="text" rows="3" placeholder="Enter patient words or quote..." class="w-full px-3 py-2 rounded-lg bg-brand-deep border border-brand-border text-white outline-none focus:border-brand-gold"></textarea>
          </div>

          <div class="flex items-center gap-2 pt-1">
            <input type="checkbox" id="isSheCare" name="isSheCare" class="w-4 h-4 rounded bg-brand-deep border-brand-border text-brand-gold focus:ring-0" />
            <label for="isSheCare" class="text-slate-300">Tag as She Care (Women's Health / Postpartum)</label>
          </div>

          <div class="pt-3 border-t border-brand-border flex items-center justify-end gap-3">
            <button type="button" onclick="closeModal('modal-review')" class="px-4 py-2 rounded-lg font-semibold text-slate-400 hover:text-white">Cancel</button>
            <button type="submit" class="px-5 py-2 rounded-lg font-bold bg-brand-gold hover:bg-brand-goldHover text-brand-dark shadow-lg shadow-amber-950 cursor-pointer">
              Save Review
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Interactive Client Script for Tab Navigation & Modals -->
    <script is:inline>
      function switchTab(tabName) {
        // Hide all tab panes
        document.querySelectorAll('.tab-pane').forEach(el => {
          el.classList.add('hidden');
        });

        // Show selected tab pane
        const target = document.getElementById('tab-' + tabName);
        if (target) {
          target.classList.remove('hidden');
        }

        // Update nav button styling
        document.querySelectorAll('.nav-tab-btn').forEach(btn => {
          btn.classList.remove('bg-brand-card', 'text-white', 'border-l-4', 'border-brand-gold');
          btn.classList.add('text-slate-300');
        });

        const activeBtn = document.getElementById('nav-' + tabName);
        if (activeBtn) {
          activeBtn.classList.add('bg-brand-card', 'text-white', 'border-l-4', 'border-brand-gold');
          activeBtn.classList.remove('text-slate-300');
        }

        // Update header title
        const titleMap = {
          overview: 'Dashboard Overview',
          blog: 'Blog Articles Management',
          reviews: 'Patient Reviews & Feedback',
          doctors: 'Physicians & Medical Team',
          treatments: 'Specialized Ayurvedic Treatments',
          branches: 'Hospital Branches & Maps',
          settings: 'Hospital Platform Settings'
        };
        const titleEl = document.getElementById('top-title');
        if (titleEl && titleMap[tabName]) {
          titleEl.textContent = titleMap[tabName];
        }

        // Save active tab preference
        try {
          localStorage.setItem('vm_admin_tab', tabName);
        } catch (e) {}
      }

      function openModal(id) {
        const el = document.getElementById(id);
        if (el) el.classList.remove('hidden');
      }

      function closeModal(id) {
        const el = document.getElementById(id);
        if (el) el.classList.add('hidden');
      }

      // Restore active tab on load
      window.addEventListener('DOMContentLoaded', () => {
        const savedTab = localStorage.getItem('vm_admin_tab') || 'overview';
        switchTab(savedTab);
      });
    </script>
  </body>
</html>
