---
export const prerender = false;

import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';

// 1. Session check
const session = Astro.cookies.get('vaidhyar_admin_session')?.value;
if (session !== 'authenticated') {
  return Astro.redirect('/admin/login');
}

// 2. Handle Server Actions (POST)
let notification = '';
let notificationType: 'success' | 'error' = 'success';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action');

    if (action === 'create_blog') {
      const title = String(formData.get('title') || '').trim();
      const titleMl = String(formData.get('titleMl') || title).trim();
      const description = String(formData.get('description') || '').trim();
      const descriptionMl = String(formData.get('descriptionMl') || description).trim();
      const category = String(formData.get('category') || 'General').trim();
      const image = String(formData.get('image') || 'https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/joint-care.jpg').trim();
      const content = String(formData.get('content') || '').trim();

      if (!title) throw new Error('Title is required');

      const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      const blogDir = path.join(process.cwd(), 'src', 'content', 'blog');
      if (!fs.existsSync(blogDir)) fs.mkdirSync(blogDir, { recursive: true });
      const filePath = path.join(blogDir, `${slug}.md`);

      const fileContent = `---
title: "${title.replace(/"/g, '\\"')}"
titleMl: "${titleMl.replace(/"/g, '\\"')}"
description: "${description.replace(/"/g, '\\"')}"
descriptionMl: "${descriptionMl.replace(/"/g, '\\"')}"
category: "${category}"
date: ${new Date().toISOString().split('T')[0]}
image: "${image}"
---

${content}
`;
      fs.writeFileSync(filePath, fileContent, 'utf8');
      notification = `Article "${title}" published successfully!`;
    } else if (action === 'delete_blog') {
      const slug = String(formData.get('slug') || '').trim();
      const filePath = path.join(process.cwd(), 'src', 'content', 'blog', `${slug}.md`);
      if (fs.existsSync(filePath)) {
        fs.unlinkSync(filePath);
        notification = `Article "${slug}" was removed.`;
      }
    } else if (action === 'create_review') {
      const reviewerName = String(formData.get('reviewerName') || '').trim();
      const type = String(formData.get('type') || 'youtube').trim();
      const city = String(formData.get('city') || 'Patient Testimonial').trim();
      const rating = Number(formData.get('rating') || 5);
      const videoId = String(formData.get('videoId') || '').trim();
      const isSheCare = formData.get('isSheCare') === 'on';
      const text = String(formData.get('text') || '').trim();

      if (!reviewerName) throw new Error('Reviewer name is required');

      const slug = reviewerName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || `review-${Date.now()}`;
      const reviewsDir = path.join(process.cwd(), 'src', 'content', 'reviews');
      if (!fs.existsSync(reviewsDir)) fs.mkdirSync(reviewsDir, { recursive: true });
      const filePath = path.join(reviewsDir, `${slug}.md`);

      const fileContent = `---
reviewerName: "${reviewerName.replace(/"/g, '\\"')}"
type: "${type}"
city: "${city.replace(/"/g, '\\"')}"
rating: ${rating}
date: ${new Date().toISOString().split('T')[0]}
videoId: "${videoId}"
isSheCare: ${isSheCare}
---

${text}
`;
      fs.writeFileSync(filePath, fileContent, 'utf8');
      notification = `Review from "${reviewerName}" saved successfully!`;
    } else if (action === 'delete_review') {
      const slug = String(formData.get('slug') || '').trim();
      const filePath = path.join(process.cwd(), 'src', 'content', 'reviews', `${slug}.md`);
      if (fs.existsSync(filePath)) {
        fs.unlinkSync(filePath);
        notification = `Review "${slug}" removed.`;
      }
    }
  } catch (err: any) {
    notification = err.message || 'Action failed.';
    notificationType = 'error';
  }
}

// 3. Load Live Data
const blogPostsRaw = await getCollection('blog').catch(() => []);
const blogPosts = blogPostsRaw.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

