---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import { Shield, Award, Users, Sprout, CheckCircle2 } from 'lucide-react';

export const prerender = true;

const milestones = [
  { year: '1983', 
    titleEn: 'Founding', titleMl: 'സ്ഥാപനം', 
    descEn: 'Dr. P. Abdul Sathar Gurukkal established the first Vaidyarmandiram clinic.',
    descMl: 'ഡോ. പി. അബ്ദുൾ സതാർ ഗുരുക്കൾ ആദ്യത്തെ വൈദ്യർമന്ദിരം ക്ലിനിക്ക് സ്ഥാപിച്ചു.' },
  { year: '1995', 
    titleEn: 'Hospital Expansion', titleMl: 'ആശുപത്രി വികസനം', 
    descEn: 'Transformed into a full-fledged Ayurvedic hospital with inpatient facilities.',
    descMl: 'കിടത്തിച്ചികിത്സാ സൗകര്യങ്ങളോടുകൂടിയ ഒരു പൂർണ്ണ ആയുർവേദ ആശുപത്രിയായി മാറി.' },
  { year: '2005', 
    titleEn: 'Research Center', titleMl: 'ഗവേഷണ കേന്ദ്രം', 
    descEn: 'Established a dedicated research wing for herbal formulations.',
    descMl: 'ഹെർബൽ മരുന്നുകൾക്കായി ഒരു പ്രത്യേക ഗവേഷണ വിഭാഗം സ്ഥാപിച്ചു.' },
  { year: '2015', 
    titleEn: 'Global Recognition', titleMl: 'ആഗോള അംഗീകാരം', 
    descEn: 'Received national accreditation for quality and authentic practices.',
    descMl: 'ഗുണനിലവാരത്തിനും ആധികാരികതയ്ക്കും ദേശീയ അംഗീകാരം ലഭിച്ചു.' },
  { year: '2023', 
    titleEn: 'Digital Transformation', titleMl: 'ഡിജിറ്റൽ മാറ്റം', 
    descEn: 'Launched online consultations and heritage awareness programs.',
    descMl: 'ഓൺലൈൻ കൺസൾട്ടേഷനുകളും പൈതൃക ബോധവൽക്കരണ പരിപാടികളും ആരംഭിച്ചു.' },
  { year: '2025', 
    titleEn: 'Branch Expansion', titleMl: 'ബ്രാഞ്ച് വികസനം', 
    descEn: 'Expanded our healing presence with new branches to serve a wider community.',
    descMl: 'കൂടുതൽ ആളുകൾക്ക് സേവനം നൽകുന്നതിനായി പുതിയ ശാഖകളുമായി വിപുലീകരിച്ചു.' },
];
---

<BaseLayout title="Our Story" description="Learn about Vaidyarmandiram's legacy, our authentic Ayurvedic practices, and the vision of our founder Dr. P. Abdul Sathar Gurukkal.">
  <Header slot="header" />

  <!-- Page Header -->
  <div class="bg-primary-dark py-24 text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <img src="https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/yoga-meditation.jpg" alt="" class="w-full h-full object-cover" />
    </div>
    <div class="container mx-auto px-4 relative z-10">
      <span class="lang-en text-accent-gold font-sans uppercase tracking-[0.3em] text-sm font-bold mb-2 block">Our Heritage</span>
      <span class="lang-ml font-malayalam text-accent-gold text-base font-semibold mb-2 block">ഞങ്ങളുടെ പൈതൃകം</span>
      <h1 class="lang-en text-4xl md:text-7xl text-background-parchment leading-tight">A Legacy of <span class="text-accent-gold ">Pure Healing</span></h1>
      <h1 class="lang-ml font-malayalam text-4xl md:text-6xl text-background-parchment leading-tight mt-2">ശുദ്ധ <span class="text-accent-gold">സൗഖ്യ</span>ത്തിന്റെ പൈതൃക പാരമ്പര്യം</h1>
    </div>
  </div>

  <!-- Founding Story -->
  <Section background="parchment" withDivider={true}>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="relative">
        <img src="https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/vmfounder.jpg" alt="Dr. P. Abdul Sathar Gurukkal" class="rounded-lg shadow-2xl relative z-10 w-full aspect-[4/5] object-cover" />
        <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-accent-gold/20 -z-0"></div>
      </div>
      <div class="space-y-6">
        <h2 class="lang-en text-4xl md:text-5xl text-primary-dark">A Sacred Legacy Of <span class="text-accent-gold">Healing</span></h2>
        <h2 class="lang-ml font-malayalam text-4xl md:text-5xl text-primary-dark">ഒരു വൈദ്യന്റെ ദർശനം</h2>
        
        <div class="space-y-6 text-lg leading-relaxed mt-6">
          <p class="lang-en text-primary-dark first-letter:text-6xl first-letter:font-bold first-letter:text-accent-gold first-letter:mr-2 first-letter:float-left">
            Founded in 1983 in Pangode, Trivandrum, by the late Dr. P. Abdul Sathar Gurukkal, our institution was created with a single vision — to preserve and share the sacred wisdom of traditional healing. More than a clinic, it became a sanctuary where ancient Siddhis and holistic healing practices were brought together to restore peace to both body and soul.
          </p>
          <p class="lang-ml font-malayalam text-primary-dark first-letter:text-5xl first-letter:font-bold first-letter:text-accent-gold first-letter:mr-2 first-letter:float-left">
            1983-ൽ തിരുവനന്തപുരത്തെ പാങ്ങോട് പരേതനായ ഡോ. പി. അബ്ദുൾ സതാർ ഗുരുക്കൾ സ്ഥാപിച്ച വൈദ്യർമന്ദിരം, പാരമ്പര്യ ചികിത്സയുടെ പവിത്രമായ അറിവ് സംരക്ഷിക്കാനും പങ്കുവെക്കാനുമുള്ള ഒരൊറ്റ ലക്ഷ്യത്തോടെയാണ് ആരംഭിച്ചത്. വെറുമൊരു ക്ലിനിക്ക് എന്നതിലുപരി, ശരീരത്തിനും മനസ്സിനും സമാധാനം നൽകുന്ന പുരാതന സിദ്ധികളും സമഗ്രമായ ചികിത്സാ രീതികളും സമന്വയിപ്പിച്ച ഒരു സങ്കേതമായി ഇത് മാറി.
          </p>
          
          <p class="lang-en text-primary-dark">
            This legacy was continued with dedication by his son, P. Jafar Khan Gurukkal, who expanded the mission of healing by establishing hospitals across Kollam and Alappuzha, reaching and serving countless families with compassion and care.
          </p>
          <p class="lang-ml font-malayalam text-primary-dark">
            ഈ പാരമ്പര്യം അദ്ദേഹത്തിന്റെ മകൻ പി. ജാഫർ ഖാൻ ഗുരുക്കൾ തികഞ്ഞ അർപ്പണബോധത്തോടെ തുടർന്നു. കൊല്ലം, ആലപ്പുഴ ജില്ലകളിൽ ആശുപത്രികൾ സ്ഥാപിച്ച് അദ്ദേഹം ഈ ചികിത്സാ ദൗത്യം വിപുലീകരിക്കുകയും, എണ്ണമറ്റ കുടുംബങ്ങൾക്ക് സ്നേഹത്തോടെ സേവനം നൽകുകയും ചെയ്തു.
          </p>
          
          <div class="p-6 bg-accent-gold/10 border-l-4 border-accent-gold my-8 italic">
            <p class="lang-en text-primary-dark font-medium">
              Though our beloved founder, the late Dr. P. Abdul Sathar Gurukkal, has passed away, his spirit and vision continue to guide the institution. The complete knowledge of their ancestral Siddhis and healing traditions has been entrusted to the next generations, ensuring the purity of this sacred lineage will continue for years to come.
            </p>
            <p class="lang-ml font-malayalam text-primary-dark font-medium">
              ഞങ്ങളുടെ പ്രിയപ്പെട്ട സ്ഥാപകൻ, പരേതനായ ഡോ. പി. അബ്ദുൾ സതാർ ഗുരുക്കൾ വിടവാങ്ങിയെങ്കിലും, അദ്ദേഹത്തിന്റെ ദർശനങ്ങളും ആത്മീയ സാന്നിധ്യവും ഈ സ്ഥാപനത്തെ തുടർന്നും നയിക്കുന്നു. അവരുടെ പൂർവ്വിക സിദ്ധികളുടെയും ചികിത്സാ രീതികളുടെയും പൂർണ്ണമായ അറിവ് അടുത്ത തലമുറകളെ വിശ്വസിപ്പിച്ചേൽപ്പിക്കുകയും, ഈ പവിത്രമായ പാരമ്പര്യത്തിന്റെ പരിശുദ്ധി വരും വർഷങ്ങളിലും തുടരുമെന്ന് ഉറപ്പാക്കുകയും ചെയ്യുന്നു.
            </p>
          </div>
          
          <p class="lang-en text-primary-dark">
            Today, the third generation proudly carries forward this timeless heritage, blending ancient wisdom with modern understanding while preserving its true essence.
          </p>
          <p class="lang-ml font-malayalam text-primary-dark">
            ഇന്ന്, മൂന്നാം തലമുറ ഈ കാലാതീതമായ പൈതൃകം അഭിമാനത്തോടെ മുന്നോട്ട് കൊണ്ടുപോകുന്നു. ആയുർവേദത്തിന്റെ തനതായ സത്ത നിലനിർത്തിക്കൊണ്ടുതന്നെ പുരാതന അറിവുകളെ ആധുനിക രീതികളുമായി സമന്വയിപ്പിക്കുന്നു.
          </p>
          
          <p class="lang-en text-primary-dark mt-8 font-medium">
            Every oil, powder, and other medicines is traditionally prepared in-house using authentic formulations passed down through generations. We do not rely on mass-produced commercial medicines, ensuring purity and trust in every treatment.
          </p>
          <p class="lang-ml font-malayalam text-primary-dark mt-8 font-medium">
            ഓരോ എണ്ണയും പൊടിയും മറ്റ് മരുന്നുകളും പരമ്പരാഗതമായി കൈമാറ്റം ചെയ്യപ്പെട്ട ആധികാരിക കൂട്ടുകൾ ഉപയോഗിച്ച് സ്വന്തമായി തയ്യാറാക്കുന്നവയാണ്. വിപണിയിൽ ലഭിക്കുന്ന വാണിജ്യ മരുന്നുകളെ ഞങ്ങൾ ആശ്രയിക്കുന്നില്ല, ഓരോ ചികിത്സയിലും പരിശുദ്ധിയും വിശ്വാസവും ഉറപ്പാക്കുന്നു.
          </p>
          
          <p class="lang-en text-primary-dark text-xl text-center italic mt-6 pb-4 border-b border-accent-gold/30">
            "At our institution, you are not treated as just a patient — you become part of a healing tradition built on faith, compassion, and the unbroken wisdom of the generations."
          </p>
          <p class="lang-ml font-malayalam text-primary-dark text-xl text-center italic mt-6 pb-4 border-b border-accent-gold/30">
            "ഞങ്ങളുടെ സ്ഥാപനത്തിൽ നിങ്ങളെ വെറുമൊരു രോഗിയായിട്ടല്ല കാണുന്നത് — വിശ്വാസം, അനുകമ്പ, തലമുറകളുടെ മുറിയാത്ത ജ്ഞാനം എന്നിവയിൽ പടുത്തുയർത്തിയ ഒരു ചികിത്സാ പാരമ്പര്യത്തിന്റെ ഭാഗമായാണ്."
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Vision & Mission -->
  <Section background="cream">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div class="bg-background-parchment p-12 shadow-lg border-t-4 border-primary-dark space-y-4">
        <div class="w-16 h-16 bg-primary-dark/10 rounded-full flex items-center justify-center text-primary-dark mb-4">
          <Shield size={32} />
        </div>
        <h3 class="lang-en text-3xl font-bold text-primary-dark">Our Vision</h3>
        <h3 class="lang-ml font-malayalam text-3xl font-bold text-primary-dark">ഞങ്ങളുടെ ദർശനം</h3>
        <p class="lang-en text-primary-dark text-lg leading-relaxed">To be the global benchmark for authentic Ayurvedic healing, preserving the ancient traditions of Kerala while making them accessible and relevant to the modern world.</p>
        <p class="lang-ml font-malayalam text-primary-dark text-lg leading-relaxed">കേരളത്തിന്റെ പുരാതന ആയുർവേദ പാരമ്പര്യം സംരക്ഷിച്ചുകൊണ്ട് ആധികാരിക ആരോഗ്യ ചികിത്സയുടെ ആഗോള മാനദണ്ഡമാകുക.</p>
      </div>
      <div class="bg-background-parchment p-12 shadow-lg border-t-4 border-accent-gold space-y-4">
        <div class="w-16 h-16 bg-accent-gold/10 rounded-full flex items-center justify-center text-accent-gold mb-4">
          <Sprout size={32} />
        </div>
        <h3 class="lang-en text-3xl font-bold text-primary-dark">Our Mission</h3>
        <h3 class="lang-ml font-malayalam text-3xl font-bold text-primary-dark">ഞങ്ങളുടെ ദൗത്യം</h3>
        <p class="lang-en text-primary-dark text-lg leading-relaxed">To provide compassionate, personalized care that restores balance and vitality through classical Ayurvedic therapies, ethically sourced herbal remedies, and lifestyle guidance.</p>
        <p class="lang-ml font-malayalam text-primary-dark text-lg leading-relaxed">ക്ലാസിക്കൽ ആയുർവേദ ചികിത്സകളിലൂടെ സന്തുലിതാവസ്ഥയും ജീവനശക്തിയും പുനഃസ്ഥാപിക്കുന്ന, അനുകമ്പയോടെയുള്ള, വ്യക്തിഗത ചികിത്സ നൽകുക.</p>
      </div>
    </div>
  </Section>

  <!-- Timeline -->
  <Section background="parchment">
    <div class="text-center max-w-3xl mx-auto mb-20">
      <h2 class="lang-en text-4xl md:text-5xl text-primary-dark">Our Journey Through <span class="text-accent-gold">Time</span></h2>
      <h2 class="lang-ml font-malayalam text-4xl md:text-5xl text-primary-dark">കാലത്തിലൂടെ <span class="text-accent-gold">ഞങ്ങളുടെ യാത്ര</span></h2>
    </div>
    
    <div class="relative max-w-4xl mx-auto">
      <!-- Vertical Line -->
      <div class="absolute left-1/2 -translate-x-1/2 w-0.5 h-full bg-accent-gold/20 hidden md:block"></div>
      
      <div class="space-y-12">
        {milestones.map((m, index) => (
          <div class={`flex flex-col md:flex-row gap-8 items-center ${index % 2 === 0 ? '' : 'md:flex-row-reverse'}`}>
            <!-- Content Column -->
            <div class={`md:w-1/2 text-center ${index % 2 === 0 ? 'md:text-right' : 'md:text-left'} px-4 space-y-2`}>
              <span class="text-3xl font-bold text-accent-gold">{m.year}</span>
              <h4 class="lang-en text-xl font-bold text-primary-dark">{m.titleEn}</h4>
              <h4 class="lang-ml font-malayalam text-xl font-bold text-primary-dark">{m.titleMl}</h4>
              <p class="lang-en text-text-muted">{m.descEn}</p>
              <p class="lang-ml font-malayalam text-text-muted font-medium">{m.descMl}</p>
            </div>
            
            <!-- Center Icon -->
            <div class="relative z-10 w-12 h-12 rounded-full bg-primary flex items-center justify-center text-background-parchment font-bold shadow-lg shrink-0">
              <div class="w-8 h-8 rounded-full border border-accent-gold/50 flex items-center justify-center">
                <CheckCircle2 size={16} />
              </div>
            </div>
            
            <!-- Spacer for Desktop -->
            <div class="hidden md:block md:w-1/2"></div>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <!-- Facilities Grid -->
  <Section background="cream">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="lang-en text-4xl md:text-5xl text-primary-dark">World-Class <span class="text-accent-gold">Facilities</span></h2>
      <h2 class="lang-ml font-malayalam text-4xl md:text-5xl text-primary-dark">മികച്ച <span class="text-accent-gold">സൗകര്യങ്ങൾ</span></h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {[
        { icon: Shield, titleEn: 'Hygienic Therapy Rooms', titleMl: 'ശുദ്ധമായ ചികിത്സാ മുറികൾ', descEn: 'Private, serene rooms designed according to Vaastu Shastra.', descMl: 'വാസ്തു പ്രകാരം രൂപകൽപ്പന ചെയ്ത ശാന്തമായ മുറികൾ.' },
        { icon: Sprout, titleEn: 'In-house Herbal Garden', titleMl: 'സ്വന്തം ഔഷധത്തോട്ടം', descEn: 'Fresh herbs grown for traditional preparations.', descMl: 'പാരമ്പര്യ മരുന്നുകൾക്കായി വളർത്തുന്ന പച്ചമരുന്നുകൾ.' },
        { icon: Award, titleEn: 'In-patient Care', titleMl: 'കിടത്തി ചികിത്സ', descEn: 'Comfortable accommodation for intensive treatments.', descMl: 'തീവ്ര ചികിത്സകൾക്കായി സുഖപ്രദമായ താമസ സൗകര്യം.' },
        { icon: Users, titleEn: 'Expert Therapists', titleMl: 'വിദഗ്ദ്ധരായ തെറാപ്പിസ്റ്റുകൾ', descEn: 'Highly trained professionals with years of experience.', descMl: 'വർഷങ്ങളുടെ പരിചയസമ്പത്തുള്ള വിദഗ്ദ്ധർ.' },
      ].map(f => (
