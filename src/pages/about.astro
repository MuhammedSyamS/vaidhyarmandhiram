---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import { Shield, Award, Users, Sprout, CheckCircle2 } from 'lucide-react';

export const prerender = true;

const milestones = [
  { year: '1985', title: 'Founding', description: 'Dr. P. Abdul Sathar Gurukkal established the first Vaidyarmandiram clinic.' },
  { year: '1995', title: 'Hospital Expansion', description: 'Transformed into a full-fledged Ayurvedic hospital with inpatient facilities.' },
  { year: '2005', title: 'Research Center', description: 'Established a dedicated research wing for herbal formulations.' },
  { year: '2015', title: 'Global Recognition', description: 'Received national accreditation for quality and authentic practices.' },
  { year: '2023', title: 'Digital Transformation', description: 'Launched online consultations and heritage awareness programs.' },
];
---

<BaseLayout title="Our Story">
  <Header slot="header" />

  <!-- Page Header -->
  <div class="bg-primary-dark py-24 text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <img src="https://images.unsplash.com/photo-1544161515-4ab6ce6db874?auto=format&fit=crop&q=80&w=2070" alt="" class="w-full h-full object-cover" />
    </div>
    <div class="container mx-auto px-4 relative z-10">
      <span class="lang-en text-accent-gold font-sans uppercase tracking-[0.3em] text-sm font-bold mb-2 block">Our Heritage</span>
      <span class="lang-ml font-malayalam text-accent-gold text-base font-semibold mb-2 block">ഞങ്ങളുടെ പൈതൃകം</span>
      <h1 class="lang-en text-4xl md:text-7xl text-background-parchment leading-tight">A Legacy of <span class="text-accent-gold ">Pure Healing</span></h1>
      <h1 class="lang-ml font-malayalam text-4xl md:text-6xl text-background-parchment leading-tight mt-2">ശുദ്ധ <span class="text-accent-gold">സൗഖ്യ</span>ത്തിന്റെ പൈതൃക പാരമ്പര്യം</h1>
    </div>
  </div>

  <!-- Founding Story -->
  <Section background="parchment" withDivider={true}>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="relative">
        <img src="/images/vmfounder.jpg" alt="Dr. P. Abdul Sathar Gurukkal" class="rounded-lg shadow-2xl relative z-10 w-full aspect-[4/5] object-cover" />
        <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-accent-gold/20 -z-0"></div>
      </div>
      <div class="space-y-6">
        <h2 class="lang-en text-4xl md:text-5xl text-primary-dark">A Sacred Legacy Of <span class="text-accent-gold">Healing</span></h2>
        <h2 class="lang-ml font-malayalam text-4xl md:text-5xl text-primary-dark">ഒരു വൈദ്യന്റെ ദർശനം</h2>
        
        <div class="space-y-6 text-lg leading-relaxed mt-6">
          <p class="lang-en text-primary-dark first-letter:text-6xl first-letter:font-bold first-letter:text-accent-gold first-letter:mr-2 first-letter:float-left">
            Founded in 1983 in Pangode, Trivandrum, by Dr. P. Abdul Sathar Gurukkal, our institution was created with a single vision — to preserve and share the sacred wisdom of traditional healing. More than a clinic, it became a sanctuary where ancient Siddhis and holistic healing practices were brought together to restore peace to both body and soul.
          </p>
          
          <p class="lang-en text-primary-dark">
            This legacy was continued with dedication by his son, P. Jafar Khan Gurukkal, who expanded the mission of healing by establishing hospitals across Kollam and Alappuzha, reaching and serving countless families with compassion and care.
          </p>
          
          <div class="p-6 bg-accent-gold/10 border-l-4 border-accent-gold my-8 italic">
            <p class="lang-en text-primary-dark font-medium">
              Before attaining eternal peace in 2024, Dr. P. Abdul Sathar Gurukkal entrusted the complete knowledge of their ancestral Siddhis and healing traditions to the third generation, ensuring the purity of this sacred lineage would continue for years to come.
            </p>
          </div>
          
          <p class="lang-en text-primary-dark">
            Today, the third generation proudly carries forward this timeless heritage, blending ancient wisdom with modern understanding while preserving its true essence.
          </p>

          <div class="mt-12 bg-white rounded-xl p-8 shadow-sm border border-accent-gold/20">
            <h3 class="lang-en text-xl text-primary-dark font-bold mb-6 text-center">Our hospitals practice five powerful traditional systems of medicine:</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lang-en text-primary-dark">
              <div class="flex items-start gap-4">
                <div class="w-8 h-8 rounded-full bg-accent-gold/20 flex items-center justify-center shrink-0 mt-1"><span class="text-accent-gold font-bold">1</span></div>
                <div><strong class="text-xl">Ayurveda</strong><br/><span class="text-text-muted">Restoring balance and harmony</span></div>
              </div>
              <div class="flex items-start gap-4">
                <div class="w-8 h-8 rounded-full bg-accent-gold/20 flex items-center justify-center shrink-0 mt-1"><span class="text-accent-gold font-bold">2</span></div>
                <div><strong class="text-xl">Siddha</strong><br/><span class="text-text-muted">Purifying body and mind</span></div>
              </div>
              <div class="flex items-start gap-4">
                <div class="w-8 h-8 rounded-full bg-accent-gold/20 flex items-center justify-center shrink-0 mt-1"><span class="text-accent-gold font-bold">3</span></div>
                <div><strong class="text-xl">Unani</strong><br/><span class="text-text-muted">Revitalizing life-force energy</span></div>
              </div>
              <div class="flex items-start gap-4">
                <div class="w-8 h-8 rounded-full bg-accent-gold/20 flex items-center justify-center shrink-0 mt-1"><span class="text-accent-gold font-bold">4</span></div>
                <div><strong class="text-xl">Kalari Marma</strong><br/><span class="text-text-muted">Healing through traditional marma therapy</span></div>
              </div>
              <div class="flex items-start gap-4 md:col-span-2 md:w-1/2 md:mx-auto">
                <div class="w-8 h-8 rounded-full bg-accent-gold/20 flex items-center justify-center shrink-0 mt-1"><span class="text-accent-gold font-bold">5</span></div>
                <div><strong class="text-xl">Folk Medicine</strong><br/><span class="text-text-muted">Rooted in nature’s wisdom</span></div>
              </div>
            </div>
          </div>
          
          <p class="lang-en text-primary-dark mt-8 font-medium">
            Every oil, powder, and other medicines is traditionally prepared in-house using authentic formulations passed down through generations. We do not rely on mass-produced commercial medicines, ensuring purity and trust in every treatment.
          </p>
          
          <p class="lang-en text-primary-dark text-xl text-center italic mt-6 pb-4 border-b border-accent-gold/30">
            "At our institution, you are not treated as just a patient — you become part of a healing tradition built on faith, compassion, and the unbroken wisdom of the generations."
          </p>

          <p class="lang-ml font-malayalam text-primary-dark pt-4">ഒരൊറ്റ ലക്ഷ്യത്തോടെ വൈദ്യർമന്ദിരം സ്ഥാപിതമായി — കേരളത്തിന്റെ ആധികാരിക ആയുർവേദ ജ്ഞാനം ആവശ്യക്കാരിലേക്ക് എത്തിക്കാൻ. ഡോ. പി. അബ്ദുൾ സതാർ ഗുരുക്കൾ ചികിത്സയെ ഒരു ആത്മീയ ഗൃഹപ്രവേശനമായി കണ്ടു.</p>
          <p class="lang-ml font-malayalam text-primary-dark">മൂന്ന് പതിറ്റാണ്ടിലേറെ ആയുർവേദ ശാസ്ത്രഗ്രന്ഥങ്ങളോട് വിശ്വസ്തരായി, സ്വയം തയ്യാറാക്കുന്ന ഔഷധങ്ങളോടെ ഞങ്ങൾ സേവനം തുടരുന്നു.</p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Vision & Mission -->
  <Section background="cream">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div class="bg-background-parchment p-12 shadow-lg border-t-4 border-primary-dark space-y-4">
        <div class="w-16 h-16 bg-primary-dark/10 rounded-full flex items-center justify-center text-primary-dark mb-4">
          <Shield size={32} />
        </div>
        <h3 class="lang-en text-3xl font-bold text-primary-dark">Our Vision</h3>
        <h3 class="lang-ml font-malayalam text-3xl font-bold text-primary-dark">ഞങ്ങളുടെ ദർശനം</h3>
        <p class="lang-en text-primary-dark text-lg leading-relaxed">To be the global benchmark for authentic Ayurvedic healing, preserving the ancient traditions of Kerala while making them accessible and relevant to the modern world.</p>
        <p class="lang-ml font-malayalam text-primary-dark text-lg leading-relaxed">കേരളത്തിന്റെ പുരാതന ആയുർവേദ പാരമ്പര്യം സംരക്ഷിച്ചുകൊണ്ട് ആധികാരിക ആരോഗ്യ ചികിത്സയുടെ ആഗോള മാനദണ്ഡമാകുക.</p>
      </div>
      <div class="bg-background-parchment p-12 shadow-lg border-t-4 border-accent-gold space-y-4">
        <div class="w-16 h-16 bg-accent-gold/10 rounded-full flex items-center justify-center text-accent-gold mb-4">
          <Sprout size={32} />
        </div>
        <h3 class="lang-en text-3xl font-bold text-primary-dark">Our Mission</h3>
        <h3 class="lang-ml font-malayalam text-3xl font-bold text-primary-dark">ഞങ്ങളുടെ ദൗത്യം</h3>
        <p class="lang-en text-primary-dark text-lg leading-relaxed">To provide compassionate, personalized care that restores balance and vitality through classical Ayurvedic therapies, ethically sourced herbal remedies, and lifestyle guidance.</p>
        <p class="lang-ml font-malayalam text-primary-dark text-lg leading-relaxed">ക്ലാസിക്കൽ ആയുർവേദ ചികിത്സകളിലൂടെ സന്തുലിതാവസ്ഥയും ജീവനശക്തിയും പുനഃസ്ഥാപിക്കുന്ന, അനുകമ്പയോടെയുള്ള, വ്യക്തിഗത ചികിത്സ നൽകുക.</p>
      </div>
    </div>
  </Section>

  <!-- Timeline -->
  <Section background="parchment">
    <div class="text-center max-w-3xl mx-auto mb-20">
      <h2 class="lang-en text-4xl md:text-5xl text-primary-dark">Our Journey Through <span class="text-accent-gold">Time</span></h2>
      <h2 class="lang-ml font-malayalam text-4xl md:text-5xl text-primary-dark">കാലത്തിലൂടെ <span class="text-accent-gold">ഞങ്ങളുടെ യാത്ര</span></h2>
    </div>
    
    <div class="relative max-w-4xl mx-auto">
      <!-- Vertical Line -->
      <div class="absolute left-1/2 -translate-x-1/2 w-0.5 h-full bg-accent-gold/20 hidden md:block"></div>
      
      <div class="space-y-12">
        {milestones.map((m, index) => (
          <div class={`flex flex-col md:flex-row gap-8 items-center ${index % 2 === 0 ? '' : 'md:flex-row-reverse'}`}>
            <!-- Content Column -->
            <div class={`md:w-1/2 text-center ${index % 2 === 0 ? 'md:text-right' : 'md:text-left'} px-4 space-y-2`}>
              <span class="text-3xl font-bold text-accent-gold">{m.year}</span>
              <h4 class="text-xl font-bold text-primary-dark">{m.title}</h4>
              <p class="text-text-muted">{m.description}</p>
            </div>
            
            <!-- Center Icon -->
            <div class="relative z-10 w-12 h-12 rounded-full bg-primary flex items-center justify-center text-background-parchment font-bold shadow-lg shrink-0">
              <div class="w-8 h-8 rounded-full border border-accent-gold/50 flex items-center justify-center">
                <CheckCircle2 size={16} />
              </div>
            </div>
            
            <!-- Spacer for Desktop -->
            <div class="hidden md:block md:w-1/2"></div>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <!-- Facilities Grid -->
  <Section background="cream">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-4xl md:text-5xl text-primary-dark">World-Class <span class="text-accent-gold">Facilities</span></h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {[
        { icon: Shield, title: 'Hygienic Therapy Rooms', desc: 'Private, serene rooms designed according to Vaastu Shastra.' },
        { icon: Sprout, title: 'In-house Herbal Garden', desc: 'Fresh herbs grown for traditional preparations.' },
        { icon: Award, title: 'In-patient Care', desc: 'Comfortable accommodation for intensive treatments.' },
        { icon: Users, title: 'Expert Therapists', desc: 'Highly trained professionals with years of experience.' },
      ].map(f => (
        <div class="bg-white p-8 rounded-lg shadow-md hover:shadow-xl transition-shadow text-center space-y-4">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center text-primary mx-auto">
            <f.icon size={24} />
          </div>
          <h4 class="text-xl font-bold text-primary-dark">{f.title}</h4>
          <p class="text-sm text-text-muted">{f.desc}</p>
        </div>
      ))}
    </div>
  </Section>

  <Footer slot="footer" />
</BaseLayout>
