---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import GalleryComponent from '../components/Gallery';

export const prerender = true;
---

<BaseLayout title="Photo Gallery">
  <Header slot="header" />

  <!-- Page Header -->
  <div class="bg-primary-dark py-24 text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <img src="https://images.unsplash.com/photo-1544161515-4ab6ce6db874?auto=format&fit=crop&q=80&w=2070" alt="" class="w-full h-full object-cover" />
    </div>
    <div class="container mx-auto px-4 relative z-10">
      <span class="text-accent-gold font-sans uppercase tracking-[0.3em] text-sm font-bold mb-4 block">Visual Tour</span>
      <h1 class="text-4xl md:text-7xl font-serif text-background-parchment leading-tight">Glimpses of <span class="text-accent-gold italic">Healing</span></h1>
    </div>
  </div>

  <Section background="parchment">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <p class="text-xl text-text-muted font-sans leading-relaxed">
        Step into the serene world of Vaidyarmandiram. From our tranquil therapy rooms to our lush herbal garden, every corner is designed to foster peace and recovery.
      </p>
    </div>
    <GalleryComponent client:visible />
  </Section>

  <!-- CTA Section -->
  <Section background="cream" className="text-center">
    <div class="max-w-4xl mx-auto border-4 border-accent-gold/20 p-12 space-y-8">
      <h2 class="text-4xl font-serif text-primary-dark">Visit Us in <span class="text-accent-gold">Person</span></h2>
      <p class="text-text-muted text-lg">
        Photos can only capture a glimpse. Experience the authentic atmosphere and therapeutic energy of our hospital firsthand.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-6">
        <a href="/contact" class="btn-outline">Find Us on Map</a>
        <a href="/appointment" class="btn-primary">Book a Visit</a>
      </div>
    </div>
  </Section>

  <Footer slot="footer" />
</BaseLayout>
