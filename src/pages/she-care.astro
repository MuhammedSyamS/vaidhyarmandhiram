---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CalendarHeart, PhoneCall, CheckCircle2, Flower2, Heart, Leaf, Sparkles } from 'lucide-react';
---

<BaseLayout title="She Care Package - Detailed Treatments">
  <Header slot="header" />

  <!-- Page Header -->
  <div class="bg-primary-dark py-24 text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <img src="https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/womens_health.png" alt="" class="w-full h-full object-cover" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-primary-dark via-primary-dark/80 to-transparent"></div>
    <div class="container mx-auto px-4 relative z-10 mt-12">
      <span class="lang-en text-accent-gold font-sans uppercase tracking-[0.3em] text-sm font-bold mb-2 block">Women's Wellness Journey</span>
      <span class="lang-ml font-malayalam text-accent-gold text-base font-semibold mb-2 block">വനിതാ വെൽനസ്</span>
      <h1 class="lang-en text-4xl md:text-6xl lg:text-7xl text-background-parchment font-serif leading-tight mb-6">She Care <span class="text-accent-gold italic">Package</span></h1>
      <h1 class="lang-ml font-malayalam text-4xl md:text-6xl text-background-parchment leading-tight mb-6">ഷീ കെയർ <span class="text-accent-gold">പാക്കേജ്</span></h1>
      <p class="text-white/80 max-w-2xl mx-auto text-lg md:text-xl font-sans">
        A sanctuary of healing tailored exclusively for women, blending ancient Ayurvedic wisdom with compassionate care through every stage of womanhood.
      </p>
    </div>
  </div>

  <!-- Detailed Treatments Section -->
  <section class="py-20 md:py-32 relative bg-background-parchment">
    <div class="container mx-auto px-4 sm:px-6 max-w-6xl">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-serif text-primary-dark font-bold mb-6">Comprehensive Care Phases</h2>
        <div class="w-24 h-1 bg-accent-gold mx-auto rounded-full"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8 lg:gap-12">
        
        {
          [
            {
              title: "Menarche Care",
              tag: "Puberty & Menstrual Health",
              img: "https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/menarche_care.png",
              desc: "Guiding young women through their first hormonal transitions with natural balance, nurturing dietary guidance, and emotional support to establish a healthy foundation for womanhood.",
              bullets: ["Hormonal balancing therapies", "Nutritional counseling for teenagers", "Pain management for dysmenorrhea", "Stress reduction techniques"]
            },
            {
              title: "Prenatal Care",
              tag: "Pregnancy Wellness",
              img: "https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/prenatal_care.png",
              desc: "Nurturing both mother and baby with specialized Ayurvedic diets, gentle strengthening therapies, and emotional wellness support for a safe and beautiful pregnancy journey.",
              bullets: ["Garbhini Paricharya (Ayurvedic antenatal care)", "Gentle herbal oil massages", "Customized trimester-specific diet", "Yoga and meditation for mothers"]
            },
            {
              title: "Postnatal Care",
              tag: "Recovery & Rejuvenation",
              img: "https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/postnatal_care.png",
              desc: "Aiding recovery with traditional strengthening treatments, restorative care, and postpartum mental health focus. We help mothers regain vitality and balance after childbirth.",
              bullets: ["Sutika Paricharya (Postpartum care)", "Abhyanga and traditional binding", "Lactation support through herbs", "Mental health & depression prevention"]
            },
            {
              title: "Menopause Care",
              tag: "Graceful Aging",
              img: "https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/menopause_care.png",
              desc: "Easing the transition into menopause with cooling therapies, bone health support, and natural emotional balance treatments to ensure vitality in the golden years.",
              bullets: ["Relief for hot flashes & mood swings", "Bone and joint strengthening", "Metabolism and weight management", "Sleep restoration and anxiety relief"]
            }
          ].map(card => (
            <div class="bg-white p-0 shadow-md border-t-2 border-primary-dark/10 hover:border-accent-gold transition-all duration-300 group flex flex-col justify-between hover:shadow-xl hover:-translate-y-1 rounded-lg overflow-hidden">
              <div class="aspect-[16/10] w-full overflow-hidden relative">
                <img src={card.img} alt={card.title} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-80"></div>
                <div class="absolute bottom-4 left-4">
                  <span class="text-[10px] font-sans uppercase tracking-widest bg-accent-gold text-primary-dark font-bold px-3 py-1.5 rounded-full shadow-md">
                    {card.tag}
                  </span>
                </div>
              </div>
              
              <div class="p-6 md:p-8 space-y-4 flex-1 flex flex-col">
                <h3 class="text-2xl text-primary-dark group-hover:text-accent-gold transition-colors duration-300 font-bold font-serif">{card.title}</h3>
                <p class="text-text-muted font-sans text-base leading-relaxed mb-4">{card.desc}</p>
                
                <ul class="space-y-3 mb-6 flex-1">
                  {card.bullets.map(item => (
                    <li class="flex items-start gap-2 text-sm text-primary-dark/80 font-sans">
                      <CheckCircle2 class="text-accent-gold shrink-0 mt-0.5 w-4 h-4" /> 
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>

                <div class="mt-auto pt-5 border-t border-accent-gold/10 flex justify-between items-center">
                  <span class="text-[10px] font-sans uppercase tracking-widest text-earth">Women's Care Protocol</span>
                  <a href={`/appointment?treatment=${encodeURIComponent(card.title)}`} class="text-primary font-bold text-sm hover:text-accent-gold transition-colors duration-300 flex items-center gap-1">
                    Book Now ➔
                  </a>
                </div>
              </div>
            </div>
          ))
        }

      </div>
    </div>
  </section>

  <!-- Holistic Approach Section -->
  <section class="py-20 relative bg-primary overflow-hidden">
    <div class="absolute inset-0 opacity-10 mix-blend-overlay">
      <img src="https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/herbal-garden-2.jpg" alt="" class="w-full h-full object-cover" />
    </div>
    <div class="container mx-auto px-4 relative z-10 max-w-6xl">
      <h3 class="text-3xl md:text-5xl text-white font-serif text-center mb-16">The Holistic She Care Approach</h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {
          [
            { title: "Authentic Ayurveda", desc: "Traditional Siddha & Ayurvedic therapies crafted for female physiology." },
            { title: "Personalized Diet", desc: "Nutrition plans tailored to your dosha and specific life stage." },
            { title: "Yoga & Wellness", desc: "Guided exercises for physical balance, pelvic floor strength, and flexibility." },
            { title: "Mental Health", desc: "Counseling and emotional support integrated into every treatment plan." }
          ].map(benefit => (
            <div class="bg-white/10 backdrop-blur-md border border-white/20 p-8 rounded-2xl hover:bg-white/15 transition-all">
              <CheckCircle2 class="text-accent-gold w-10 h-10 mb-6" />
              <h4 class="text-xl text-white font-bold mb-3">{benefit.title}</h4>
              <p class="text-white/80 leading-relaxed">{benefit.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Book Slot / CTA Section -->
  <section class="py-24 bg-white relative">
    <div class="container mx-auto px-4 max-w-4xl relative z-10">
      <div class="bg-background-cream rounded-[3rem] p-10 md:p-16 text-center border border-accent-gold/20 shadow-2xl">
        <h4 class="text-3xl md:text-5xl font-serif text-primary-dark font-bold mb-6">Book Your Consultation</h4>
        <p class="text-text-muted text-lg mb-10 max-w-2xl mx-auto leading-relaxed">
          Take the first step towards profound wellness. Consult with our specialized female practitioners to create a care plan that perfectly matches your body's needs.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
          <a href="/appointment" class="w-full sm:w-auto inline-flex items-center justify-center px-10 py-5 bg-primary text-white rounded-xl font-bold text-lg hover:bg-primary-dark shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-1">
            <CalendarHeart class="w-6 h-6 mr-3" />
            Book a Slot Online
          </a>
          <a href="tel:+918593821553" class="w-full sm:w-auto inline-flex items-center justify-center px-10 py-5 bg-white border-2 border-primary text-primary rounded-xl font-bold text-lg hover:bg-primary/5 transition-colors">
            <PhoneCall class="w-6 h-6 mr-3" />
            Call Our Specialists
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
