---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CalendarHeart, PhoneCall, CheckCircle2, Flower2, Heart, Leaf, Sparkles } from 'lucide-react';
---

<BaseLayout title="She Care Package - Detailed Treatments" description="Discover the She Care wellness package, exclusively designed for women's holistic health, from menarche to menopause.">
  <Header slot="header" />

  <!-- Page Header -->
  <div class="bg-primary-dark py-24 text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <img src="https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/womens_health.png" alt="" class="w-full h-full object-cover" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-primary-dark via-primary-dark/80 to-transparent"></div>
    <div class="container mx-auto px-4 relative z-10 mt-12">
      <span class="lang-en text-accent-gold font-sans uppercase tracking-[0.3em] text-sm font-bold mb-2 block">Women's Wellness Journey</span>
      <span class="lang-ml font-malayalam text-accent-gold text-base font-semibold mb-2 block">വനിതാ വെൽനസ്</span>
      <h1 class="lang-en text-4xl md:text-6xl lg:text-7xl text-background-parchment font-serif leading-tight mb-6">She Care <span class="text-accent-gold italic">Package</span></h1>
      <h1 class="lang-ml font-malayalam text-4xl md:text-6xl text-background-parchment leading-tight mb-6">ഷീ കെയർ <span class="text-accent-gold">പാക്കേജ്</span></h1>
      <p class="lang-en text-white/80 max-w-2xl mx-auto text-lg md:text-xl font-sans">
        A sanctuary of healing tailored exclusively for women, blending ancient Ayurvedic wisdom with compassionate care through every stage of womanhood.
      </p>
      <p class="lang-ml font-malayalam text-white/80 max-w-2xl mx-auto text-lg md:text-xl font-medium">
        സ്ത്രീകൾക്ക് മാത്രമായി തയ്യാറാക്കിയ ഒരു ചികിത്സാ കേന്ദ്രം. പുരാതന ആയുർവേദ അറിവുകളും സ്നേഹപൂർവ്വമായ പരിചരണവും സമന്വയിപ്പിച്ച് സ്ത്രീത്വത്തിന്റെ ഓരോ ഘട്ടത്തിലും ഞങ്ങൾ നിങ്ങളെ പിന്തുണയ്ക്കുന്നു.
      </p>
    </div>
  </div>

  <!-- Detailed Treatments Section -->
  <section class="py-20 md:py-32 relative bg-background-parchment">
    <div class="container mx-auto px-4 sm:px-6 max-w-6xl">
      <div class="text-center mb-16">
        <h2 class="lang-en text-3xl md:text-5xl font-serif text-primary-dark font-bold mb-6">Comprehensive Care Phases</h2>
        <h2 class="lang-ml font-malayalam text-3xl md:text-5xl text-primary-dark font-bold mb-6">സമഗ്ര പരിചരണ ഘട്ടങ്ങൾ</h2>
        <div class="w-24 h-1 bg-accent-gold mx-auto rounded-full"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8 lg:gap-12">
        
        {
          [
            {
              titleEn: "Menarche Care", titleMl: "ആർത്തവാരംഭ പരിചരണം",
              tagEn: "Puberty & Menstrual Health", tagMl: "ആർത്തവ ആരോഗ്യം",
              img: "https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/menarche_care.png",
              descEn: "Guiding young women through their first hormonal transitions with natural balance, nurturing dietary guidance, and emotional support to establish a healthy foundation for womanhood.",
              descMl: "സ്വാഭാവിക ഹോർമോൺ സന്തുലിതാവസ്ഥയിലൂടെയും പോഷകാഹാര നിർദ്ദേശങ്ങളിലൂടെയും വൈകാരിക പിന്തുണയിലൂടെയും യുവതികളെ അവരുടെ ആദ്യ മാറ്റത്തിലൂടെ നയിക്കുന്നു.",
              bulletsEn: ["Hormonal balancing therapies", "Nutritional counseling for teenagers", "Pain management for dysmenorrhea", "Stress reduction techniques"],
              bulletsMl: ["ഹോർമോൺ സന്തുലിതാവസ്ഥാ ചികിത്സകൾ", "കൗമാരക്കാർക്കുള്ള പോഷകാഹാര കൗൺസിലിംഗ്", "ആർത്തവ വേദനയ്ക്കുള്ള പ്രതിവിധികൾ", "സമ്മർദ്ദം കുറയ്ക്കാനുള്ള വിദ്യകൾ"]
            },
            {
              titleEn: "Prenatal Care", titleMl: "ഗർഭകാല പരിചരണം",
              tagEn: "Pregnancy Wellness", tagMl: "ഗർഭകാല ആരോഗ്യം",
              img: "https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/prenatal_care.png",
              descEn: "Nurturing both mother and baby with specialized Ayurvedic diets, gentle strengthening therapies, and emotional wellness support for a safe and beautiful pregnancy journey.",
              descMl: "പ്രത്യേക ആയുർവേദ ഭക്ഷണക്രമം, മൃദുവായ ശാക്തീകരണ ചികിത്സകൾ, വൈകാരിക ക്ഷേമ പിന്തുണ എന്നിവ ഉപയോഗിച്ച് അമ്മയെയും കുഞ്ഞിനെയും സുരക്ഷിതമായ ഗർഭകാലത്തിനായി പോറ്റുന്നു.",
              bulletsEn: ["Garbhini Paricharya (Ayurvedic antenatal care)", "Gentle herbal oil massages", "Customized trimester-specific diet", "Yoga and meditation for mothers"],
              bulletsMl: ["ഗർഭിണീ പരിചരണ ചികിത്സകൾ", "മൃദുവായ ഹെർബൽ ഓയിൽ മസാജുകൾ", "ഓരോ ഘട്ടത്തിനും അനുയോജ്യമായ ഭക്ഷണക്രമം", "അമ്മമാർക്കുള്ള യോഗയും ധ്യാനവും"]
            },
            {
              titleEn: "Postnatal Care", titleMl: "പ്രസവാനന്തര പരിചരണം",
              tagEn: "Recovery & Rejuvenation", tagMl: "വീണ്ടെടുക്കൽ & പുനരുജ്ജീവനം",
              img: "https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/postnatal_care.png",
              descEn: "Aiding recovery with traditional strengthening treatments, restorative care, and postpartum mental health focus. We help mothers regain vitality and balance after childbirth.",
              descMl: "പരമ്പരാഗത ശാക്തീകരണ ചികിത്സകളും, പുനരുജ്ജീവന പരിചരണവും, പ്രസവാനന്തര മാനസികാരോഗ്യ ശ്രദ്ധയും നൽകി വീണ്ടെടുക്കലിനെ സഹായിക്കുന്നു.",
              bulletsEn: ["Sutika Paricharya (Postpartum care)", "Abhyanga and traditional binding", "Lactation support through herbs", "Mental health & depression prevention"],
              bulletsMl: ["സൂതികാ പരിചരണം (പ്രസവാനന്തര പരിചരണം)", "അഭ്യംഗവും പരമ്പരാഗത ഉഴിച്ചിലും", "മുലപ്പാൽ വർദ്ധിപ്പിക്കാനുള്ള ചികിത്സകൾ", "മാനസികാരോഗ്യ പിന്തുണ"]
            },
            {
              titleEn: "Menopause Care", titleMl: "ആർത്തവവിരാമ പരിചരണം",
              tagEn: "Graceful Aging", tagMl: "ആരോഗ്യകരമായ വാർദ്ധക്യം",
              img: "https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/menopause_care.png",
              descEn: "Easing the transition into menopause with cooling therapies, bone health support, and natural emotional balance treatments to ensure vitality in the golden years.",
              descMl: "ശരീരം തണുപ്പിക്കുന്ന ചികിത്സകൾ, അസ്ഥികളുടെ ആരോഗ്യ പിന്തുണ, സ്വാഭാവിക വൈകാരിക സന്തുലിതാവസ്ഥകൾ എന്നിവ ഉപയോഗിച്ച് ഈ മാറ്റം എളുപ്പമാക്കുന്നു.",
              bulletsEn: ["Relief for hot flashes & mood swings", "Bone and joint strengthening", "Metabolism and weight management", "Sleep restoration and anxiety relief"],
              bulletsMl: ["ചൂടും മാനസിക മാറ്റങ്ങൾക്കുമുള്ള ആശ്വാസം", "അസ്ഥികളും സന്ധികളും ബലപ്പെടുത്തൽ", "ഉപാപചയവും ഭാരനിയന്ത്രണവും", "ഉറക്കം വീണ്ടെടുക്കൽ & ഉത്കണ്ഠ കുറയ്ക്കൽ"]
            }
          ].map(card => (
            <div class="bg-white p-0 shadow-md border-t-2 border-primary-dark/10 hover:border-accent-gold transition-all duration-300 group flex flex-col justify-between hover:shadow-xl hover:-translate-y-1 rounded-lg overflow-hidden">
              <div class="aspect-[16/10] w-full overflow-hidden relative">
                <img src={card.img} alt={card.titleEn} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-80"></div>
                <div class="absolute bottom-4 left-4">
                  <span class="lang-en text-[10px] font-sans uppercase tracking-widest bg-accent-gold text-primary-dark font-bold px-3 py-1.5 rounded-full shadow-md">
                    {card.tagEn}
                  </span>
                  <span class="lang-ml font-malayalam text-[10px] bg-accent-gold text-primary-dark font-bold px-3 py-1.5 rounded-full shadow-md">
                    {card.tagMl}
                  </span>
                </div>
              </div>
              
              <div class="p-6 md:p-8 space-y-4 flex-1 flex flex-col">
                <h3 class="lang-en text-2xl text-primary-dark group-hover:text-accent-gold transition-colors duration-300 font-bold font-serif">{card.titleEn}</h3>
                <h3 class="lang-ml font-malayalam text-2xl text-primary-dark group-hover:text-accent-gold transition-colors duration-300 font-bold">{card.titleMl}</h3>
                
                <p class="lang-en text-text-muted font-sans text-base leading-relaxed mb-4">{card.descEn}</p>
                <p class="lang-ml font-malayalam text-text-muted font-medium text-base leading-relaxed mb-4">{card.descMl}</p>
                
                <ul class="space-y-3 mb-6 flex-1">
                  {card.bulletsEn.map((item, idx) => (
                    <li class="flex items-start gap-2 text-sm text-primary-dark/80 font-sans">
                      <CheckCircle2 className="text-accent-gold shrink-0 mt-0.5 w-4 h-4" /> 
                      <span class="lang-en">{item}</span>
                      <span class="lang-ml font-malayalam font-medium">{card.bulletsMl[idx]}</span>
                    </li>
                  ))}
                </ul>

                <div class="mt-auto pt-5 border-t border-accent-gold/10 flex justify-between items-center">
                  <span class="lang-en text-[10px] font-sans uppercase tracking-widest text-earth">Women's Care Protocol</span>
                  <span class="lang-ml font-malayalam text-[10px] tracking-widest text-earth">വനിതാ പരിചരണ പ്രോട്ടോക്കോൾ</span>
                  
                  <a href={`/appointment?treatment=${encodeURIComponent(card.titleEn)}`} class="text-primary font-bold text-sm hover:text-accent-gold transition-colors duration-300 flex items-center gap-1">
                    <span class="lang-en">Book Now</span>
                    <span class="lang-ml font-malayalam">ബുക്ക് ചെയ്യുക</span>
                    ➔
                  </a>
                </div>
              </div>
            </div>
          ))
        }

      </div>
    </div>
  </section>

  <!-- Holistic Approach Section -->
  <section class="py-20 relative bg-primary overflow-hidden">
    <div class="absolute inset-0 opacity-10 mix-blend-overlay">
      <img src="https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/herbal-garden-2.jpg" alt="" class="w-full h-full object-cover" />
    </div>
    <div class="container mx-auto px-4 relative z-10 max-w-6xl">
      <h3 class="lang-en text-3xl md:text-5xl text-white font-serif text-center mb-16">The Holistic She Care Approach</h3>
      <h3 class="lang-ml font-malayalam text-3xl md:text-5xl text-white font-bold text-center mb-16">സമഗ്ര ഷീ കെയർ സമീപനം</h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {
          [
            { titleEn: "Authentic Ayurveda", titleMl: "ആധികാരിക ആയുർവേദം", descEn: "Traditional Siddha & Ayurvedic therapies crafted for female physiology.", descMl: "സ്ത്രീ ശരീരഘടനയ്ക്ക് അനുയോജ്യമായ പാരമ്പര്യ സിദ്ധ, ആയുർവേദ ചികിത്സകൾ." },
            { titleEn: "Personalized Diet", titleMl: "വ്യക്തിഗത ഭക്ഷണക്രമം", descEn: "Nutrition plans tailored to your dosha and specific life stage.", descMl: "നിങ്ങളുടെ ദോഷത്തിനും ജീവിതഘട്ടത്തിനും അനുസരിച്ചുള്ള പോഷകാഹാര പദ്ധതികൾ." },
            { titleEn: "Yoga & Wellness", titleMl: "യോഗ & വെൽനസ്", descEn: "Guided exercises for physical balance, pelvic floor strength, and flexibility.", descMl: "ശാരീരിക സന്തുലിതാവസ്ഥ, പേശികളുടെ കരുത്ത് എന്നിവയ്ക്കുള്ള ഗൈഡഡ് വ്യായാമങ്ങൾ." },
            { titleEn: "Mental Health", titleMl: "മാനസികാരോഗ്യം", descEn: "Counseling and emotional support integrated into every treatment plan.", descMl: "ഓരോ ചികിത്സാ പദ്ധതിയിലും കൗൺസിലിംഗും വൈകാരിക പിന്തുണയും ഉൾപ്പെടുത്തിയിരിക്കുന്നു." }
          ].map(benefit => (
            <div class="bg-white/10 backdrop-blur-md border border-white/20 p-8 rounded-2xl hover:bg-white/15 transition-all">
              <CheckCircle2 className="text-accent-gold w-10 h-10 mb-6" />
              <h4 class="lang-en text-xl text-white font-bold mb-3">{benefit.titleEn}</h4>
              <h4 class="lang-ml font-malayalam text-xl text-white font-bold mb-3">{benefit.titleMl}</h4>
              <p class="lang-en text-white/80 leading-relaxed">{benefit.descEn}</p>
              <p class="lang-ml font-malayalam text-white/80 leading-relaxed font-medium">{benefit.descMl}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Book Slot / CTA Section -->
  <section class="py-24 bg-white relative">
    <div class="container mx-auto px-4 max-w-4xl relative z-10">
      <div class="bg-background-cream rounded-[3rem] p-10 md:p-16 text-center border border-accent-gold/20 shadow-2xl">
        <h4 class="lang-en text-3xl md:text-5xl font-serif text-primary-dark font-bold mb-6">Book Your Consultation</h4>
        <h4 class="lang-ml font-malayalam text-3xl md:text-5xl text-primary-dark font-bold mb-6">നിങ്ങളുടെ കൺസൾട്ടേഷൻ ബുക്ക് ചെയ്യൂ</h4>
        <p class="lang-en text-text-muted text-lg mb-10 max-w-2xl mx-auto leading-relaxed">
          Begin your personalized healing journey today. Our female wellness experts are here to listen, understand, and guide you.
        </p>
        <p class="lang-ml font-malayalam text-text-muted text-lg mb-10 max-w-2xl mx-auto leading-relaxed">
          നിങ്ങളുടെ വ്യക്തിഗത ചികിത്സാ യാത്ര ഇന്ന് തന്നെ ആരംഭിക്കുക. നിങ്ങളെ കേൾക്കാനും മനസ്സിലാക്കാനും സഹായിക്കാനും ഞങ്ങളുടെ വനിതാ വെൽനസ് വിദഗ്ദ്ധർ ഇവിടെയുണ്ട്.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
          <a href="/appointment" class="w-full sm:w-auto inline-flex items-center justify-center px-10 py-5 bg-primary text-white rounded-xl font-bold text-lg hover:bg-primary-dark shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-1">
            <CalendarHeart className="w-6 h-6 mr-3" />
            <span class="lang-en">Book a Slot Online</span>
            <span class="lang-ml font-malayalam normal-case tracking-normal">ഓൺലൈനിൽ ബുക്ക് ചെയ്യൂ</span>
          </a>
          <a href="tel:+918593821553" class="w-full sm:w-auto inline-flex items-center justify-center px-10 py-5 bg-white border-2 border-primary text-primary rounded-xl font-bold text-lg hover:bg-primary/5 transition-colors">
            <PhoneCall className="w-6 h-6 mr-3" />
            <span class="lang-en">Call Our Specialists</span>
            <span class="lang-ml font-malayalam normal-case tracking-normal">ഞങ്ങളെ വിളിക്കൂ</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
