---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CalendarHeart, PhoneCall, CheckCircle2, Flower2, Heart, Leaf, Sparkles } from 'lucide-react';
---

<BaseLayout title="She Care Package - Detailed Treatments">
  <Header slot="header" />

  <!-- Page Header -->
  <div class="bg-primary-dark py-24 text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <img src="/images/womens_health.png" alt="" class="w-full h-full object-cover" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-primary-dark via-primary-dark/80 to-transparent"></div>
    <div class="container mx-auto px-4 relative z-10 mt-12">
      <span class="lang-en text-accent-gold font-sans uppercase tracking-[0.3em] text-sm font-bold mb-2 block">Women's Wellness Journey</span>
      <span class="lang-ml font-malayalam text-accent-gold text-base font-semibold mb-2 block">വനിതാ വെൽനസ്</span>
      <h1 class="lang-en text-4xl md:text-6xl lg:text-7xl text-background-parchment font-serif leading-tight mb-6">She Care <span class="text-accent-gold italic">Package</span></h1>
      <h1 class="lang-ml font-malayalam text-4xl md:text-6xl text-background-parchment leading-tight mb-6">ഷീ കെയർ <span class="text-accent-gold">പാക്കേജ്</span></h1>
      <p class="text-white/80 max-w-2xl mx-auto text-lg md:text-xl font-sans">
        A sanctuary of healing tailored exclusively for women, blending ancient Ayurvedic wisdom with compassionate care through every stage of womanhood.
      </p>
    </div>
  </div>

  <!-- Detailed Treatments Section -->
  <section class="py-20 md:py-32 relative bg-background-parchment">
    <div class="container mx-auto px-4 sm:px-6 max-w-6xl">
      <div class="text-center mb-20">
        <h2 class="text-3xl md:text-5xl font-serif text-primary-dark font-bold mb-6">Comprehensive Care Phases</h2>
        <div class="w-24 h-1 bg-accent-gold mx-auto rounded-full"></div>
      </div>

      <div class="space-y-24 md:space-y-32">
        <!-- Menarche Care -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
          <div class="order-2 md:order-1 relative rounded-[2rem] overflow-hidden shadow-2xl group">
            <img src="/images/menarche_care.png" alt="Menarche Care" class="w-full h-[400px] sm:h-[500px] object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-primary-dark/80 to-transparent opacity-40"></div>
          </div>
          <div class="order-1 md:order-2 space-y-6">
            <div class="inline-flex items-center gap-3 px-4 py-2 bg-primary/10 rounded-full text-primary font-bold text-sm">
              <Flower2 size={18} /> Puberty & Menstrual Health
            </div>
            <h3 class="text-3xl md:text-4xl font-serif text-primary-dark font-bold">Menarche Care</h3>
            <p class="text-text-muted text-lg leading-relaxed">Guiding young women through their first hormonal transitions with natural balance, nurturing dietary guidance, and emotional support to establish a healthy foundation for womanhood.</p>
            <ul class="space-y-4 mt-6">
              {["Hormonal balancing therapies", "Nutritional counseling for teenagers", "Pain management for dysmenorrhea", "Stress reduction techniques"].map(item => (
                <li class="flex items-start gap-3 text-primary-dark/90 font-medium">
                  <CheckCircle2 class="text-accent-gold shrink-0 mt-0.5" size={22} /> 
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Prenatal Care -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
          <div class="space-y-6">
            <div class="inline-flex items-center gap-3 px-4 py-2 bg-primary/10 rounded-full text-primary font-bold text-sm">
              <Heart size={18} /> Pregnancy Wellness
            </div>
            <h3 class="text-3xl md:text-4xl font-serif text-primary-dark font-bold">Prenatal Care</h3>
            <p class="text-text-muted text-lg leading-relaxed">Nurturing both mother and baby with specialized Ayurvedic diets, gentle strengthening therapies, and emotional wellness support for a safe and beautiful pregnancy journey.</p>
            <ul class="space-y-4 mt-6">
              {["Garbhini Paricharya (Ayurvedic antenatal care)", "Gentle herbal oil massages", "Customized trimester-specific diet", "Yoga and meditation for expecting mothers"].map(item => (
                <li class="flex items-start gap-3 text-primary-dark/90 font-medium">
                  <CheckCircle2 class="text-accent-gold shrink-0 mt-0.5" size={22} /> 
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="relative rounded-[2rem] overflow-hidden shadow-2xl group">
            <img src="/images/prenatal_care.png" alt="Prenatal Care" class="w-full h-[400px] sm:h-[500px] object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-primary-dark/80 to-transparent opacity-40"></div>
          </div>
        </div>

        <!-- Postnatal Care -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
          <div class="order-2 md:order-1 relative rounded-[2rem] overflow-hidden shadow-2xl group">
            <img src="/images/postnatal_care.png" alt="Postnatal Care" class="w-full h-[400px] sm:h-[500px] object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-primary-dark/80 to-transparent opacity-40"></div>
          </div>
          <div class="order-1 md:order-2 space-y-6">
            <div class="inline-flex items-center gap-3 px-4 py-2 bg-primary/10 rounded-full text-primary font-bold text-sm">
              <Sparkles size={18} /> Recovery & Rejuvenation
            </div>
            <h3 class="text-3xl md:text-4xl font-serif text-primary-dark font-bold">Postnatal Care</h3>
            <p class="text-text-muted text-lg leading-relaxed">Aiding recovery with traditional strengthening treatments, restorative care, and postpartum mental health focus. We help mothers regain vitality and balance after childbirth.</p>
            <ul class="space-y-4 mt-6">
              {["Sutika Paricharya (Postpartum care)", "Abhyanga and traditional binding", "Lactation support through herbs", "Mental health and postpartum depression prevention"].map(item => (
                <li class="flex items-start gap-3 text-primary-dark/90 font-medium">
                  <CheckCircle2 class="text-accent-gold shrink-0 mt-0.5" size={22} /> 
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Menopause Care -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
          <div class="space-y-6">
            <div class="inline-flex items-center gap-3 px-4 py-2 bg-primary/10 rounded-full text-primary font-bold text-sm">
              <Leaf size={18} /> Graceful Aging
            </div>
            <h3 class="text-3xl md:text-4xl font-serif text-primary-dark font-bold">Menopause Care</h3>
            <p class="text-text-muted text-lg leading-relaxed">Easing the transition into menopause with cooling therapies, bone health support, and natural emotional balance treatments to ensure vitality in the golden years.</p>
            <ul class="space-y-4 mt-6">
              {["Natural relief for hot flashes & mood swings", "Bone and joint strengthening therapies", "Metabolism and weight management", "Sleep restoration and anxiety relief"].map(item => (
                <li class="flex items-start gap-3 text-primary-dark/90 font-medium">
                  <CheckCircle2 class="text-accent-gold shrink-0 mt-0.5" size={22} /> 
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="relative rounded-[2rem] overflow-hidden shadow-2xl group">
            <img src="/images/menopause_care.png" alt="Menopause Care" class="w-full h-[400px] sm:h-[500px] object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-primary-dark/80 to-transparent opacity-40"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Holistic Approach Section -->
  <section class="py-20 relative bg-primary overflow-hidden">
    <div class="absolute inset-0 opacity-10 mix-blend-overlay">
      <img src="/images/herbal-garden-2.jpg" alt="" class="w-full h-full object-cover" />
    </div>
    <div class="container mx-auto px-4 relative z-10 max-w-6xl">
      <h3 class="text-3xl md:text-5xl text-white font-serif text-center mb-16">The Holistic She Care Approach</h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {
          [
            { title: "Authentic Ayurveda", desc: "Traditional Siddha & Ayurvedic therapies crafted for female physiology." },
            { title: "Personalized Diet", desc: "Nutrition plans tailored to your dosha and specific life stage." },
            { title: "Yoga & Wellness", desc: "Guided exercises for physical balance, pelvic floor strength, and flexibility." },
            { title: "Mental Health", desc: "Counseling and emotional support integrated into every treatment plan." }
          ].map(benefit => (
            <div class="bg-white/10 backdrop-blur-md border border-white/20 p-8 rounded-2xl hover:bg-white/15 transition-all">
              <CheckCircle2 class="text-accent-gold w-10 h-10 mb-6" />
              <h4 class="text-xl text-white font-bold mb-3">{benefit.title}</h4>
              <p class="text-white/80 leading-relaxed">{benefit.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Book Slot / CTA Section -->
  <section class="py-24 bg-white relative">
    <div class="container mx-auto px-4 max-w-4xl relative z-10">
      <div class="bg-background-cream rounded-[3rem] p-10 md:p-16 text-center border border-accent-gold/20 shadow-2xl">
        <h4 class="text-3xl md:text-5xl font-serif text-primary-dark font-bold mb-6">Book Your Consultation</h4>
        <p class="text-text-muted text-lg mb-10 max-w-2xl mx-auto leading-relaxed">
          Take the first step towards profound wellness. Consult with our specialized female practitioners to create a care plan that perfectly matches your body's needs.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
          <a href="/appointment" class="w-full sm:w-auto inline-flex items-center justify-center px-10 py-5 bg-primary text-white rounded-xl font-bold text-lg hover:bg-primary-dark shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-1">
            <CalendarHeart class="w-6 h-6 mr-3" />
            Book a Slot Online
          </a>
          <a href="tel:+918593821553" class="w-full sm:w-auto inline-flex items-center justify-center px-10 py-5 bg-white border-2 border-primary text-primary rounded-xl font-bold text-lg hover:bg-primary/5 transition-colors">
            <PhoneCall class="w-6 h-6 mr-3" />
            Call Our Specialists
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
