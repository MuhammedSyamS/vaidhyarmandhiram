---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import TreatmentTabs from '../../components/TreatmentTabs';

export const prerender = true;
---

<BaseLayout title="Treatments">
  <Header slot="header" />

  <!-- Page Header -->
  <div class="bg-primary-dark py-24 text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <img src="https://res.cloudinary.com/dhqtquwxc/image/upload/f_auto,q_auto/v1/vaidhyarmandhiram/images/treatment-room-1.jpg" alt="" class="w-full h-full object-cover" />
    </div>
    <div class="container mx-auto px-4 relative z-10">
      <span class="lang-en text-accent-gold font-sans uppercase tracking-[0.3em] text-sm font-bold mb-2 block">Healing Therapies</span>
      <span class="lang-ml font-malayalam text-accent-gold text-base font-semibold mb-2 block">ചികിത്സാ രീതികൾ</span>
      <h1 class="lang-en text-4xl md:text-7xl text-background-parchment leading-tight">Authentic <span class="text-accent-gold">Ayurvedic Care</span></h1>
      <h1 class="lang-ml font-malayalam text-4xl md:text-6xl text-background-parchment leading-tight mt-2">ആധികാരിക <span class="text-accent-gold">ആയുർവേദ ചികിത്സ</span></h1>
    </div>
  </div>

  <Section background="parchment">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <p class="lang-en text-xl text-text-muted font-sans">
        Discover our range of traditional treatments, each prescribed according to your specific needs and body type. Our experts ensure every procedure follows classical protocols for maximum benefit.
      </p>
      <p class="lang-ml font-malayalam text-xl text-text-muted">
        നിങ്ങളുടെ ആവശ്യങ്ങൾക്കും ശരീരഘടനയ്ക്കും അനുസൃതമായി നിർദ്ദേശിക്കുന്ന പരമ്പരാഗത ചികിത്സാ രീതികൾ. ഓരോ ചികിത്സയും ശാസ്ത്രീയ പ്രോട്ടോക്കോൾ പാലിക്കുന്നതാണ്.
      </p>
    </div>
    <TreatmentTabs client:load />
  </Section>

  <!-- CTA Section -->
  <Section background="dark" className="text-center">
    <h2 class="lang-en text-3xl md:text-5xl mb-4 text-background-parchment">Consult with Our <span class="text-accent-gold">Experts</span></h2>
    <h2 class="lang-ml font-malayalam text-3xl md:text-4xl mb-4 text-background-parchment">ഞങ്ങളുടെ <span class="text-accent-gold">വിദഗ്ധരുമായി</span> കൂടിയാലോചിക്കൂ</h2>
    <p class="lang-en text-background-parchment/70 text-lg mb-10 max-w-2xl mx-auto">
      Not sure which treatment is right for you? Book a consultation with our experienced physicians for a personalized health assessment.
    </p>
    <p class="lang-ml font-malayalam text-background-parchment/70 text-lg mb-10 max-w-2xl mx-auto">
      ഏത് ചികിത്സയാണ് നിങ്ങൾക്ക് ശരിയെന്ന് ഉറപ്പില്ലേ? ഒരു വ്യക്തിഗത ആരോഗ്യ വിലയിരുത്തലിനായി ഞങ്ങളുടെ വിദഗ്ദ്ധ ഡോക്ടർമാരുമായി ബുക്ക് ചെയ്യൂ.
    </p>
    <a href="/appointment" class="btn-primary !bg-accent-gold !text-primary-dark text-xl px-12 py-4">
      <span class="lang-en">Book Consultation</span>
      <span class="lang-ml font-malayalam normal-case tracking-normal">കൺസൾട്ടേഷൻ ബുക്ക് ചെയ്യൂ</span>
    </a>
  </Section>

  <Footer slot="footer" />
</BaseLayout>
