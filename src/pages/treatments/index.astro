---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import TreatmentTabs from '../../components/TreatmentTabs';

export const prerender = true;
---

<BaseLayout title="Treatments">
  <Header slot="header" />

  <!-- Page Header -->
  <div class="bg-primary-dark py-24 text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <img src="https://images.unsplash.com/photo-1544161515-4ab6ce6db874?auto=format&fit=crop&q=80&w=2070" alt="" class="w-full h-full object-cover" />
    </div>
    <div class="container mx-auto px-4 relative z-10">
      <span class="text-accent-gold font-sans uppercase tracking-[0.3em] text-sm font-bold mb-4 block">Healing Therapies</span>
      <h1 class="text-4xl md:text-7xl font-serif text-background-parchment leading-tight">Authentic <span class="text-accent-gold italic">Ayurvedic Care</span></h1>
    </div>
  </div>

  <Section background="parchment">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <p class="text-xl text-text-muted font-sans">
        Discover our range of traditional treatments, each prescribed according to your specific needs and body type. Our experts ensure every procedure follows classical protocols for maximum benefit.
      </p>
    </div>
    <TreatmentTabs client:load />
  </Section>

  <!-- CTA Section -->
  <Section background="dark" className="text-center">
    <h2 class="text-3xl md:text-5xl font-serif mb-8 text-background-parchment">Consult with Our <span class="text-accent-gold">Experts</span></h2>
    <p class="text-background-parchment/70 text-lg mb-10 max-w-2xl mx-auto">
      Not sure which treatment is right for you? Book a consultation with Dr. P. Abdul Sathar Gurukkal for a personalized health assessment.
    </p>
    <a href="/appointment" class="btn-primary !bg-accent-gold !text-primary-dark text-xl px-12 py-4">Book Consultation</a>
  </Section>

  <Footer slot="footer" />
</BaseLayout>
