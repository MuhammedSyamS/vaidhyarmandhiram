---
import { ViewTransitions } from 'astro:transitions';
import '@fontsource/cormorant-garamond';
import '@fontsource/source-sans-3';
import '../styles/global.css';
import SplashIntro from '../components/SplashIntro.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: URL;
  type?: string;
}

const {
  title,
  description = "Experience authentic Kerala Ayurveda at Vaidyarmandiram Ayurveda Hospital. Founded by Dr. P. Abdul Sathar Gurukkal.",
  image = "/images/og-image.jpg",
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  type = "website",
} = Astro.props;

const siteName = "Vaidyarmandiram Ayurveda Hospital";
const fullTitle = `${title} | ${siteName}`;
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png?v=3" />
    <link rel="shortcut icon" type="image/png" href="/favicon.png?v=3" />
    <link rel="apple-touch-icon" href="/favicon.png?v=3" />
    <meta name="generator" content={Astro.generator} />
    <!-- Language: restore saved preference on initial load AND after every View Transition -->
    <script is:inline>
      // Runs immediately before first paint (no flash)
      (function applyStoredLang() {
        var lang = localStorage.getItem('vm-lang') || 'en';
        document.documentElement.setAttribute('data-lang', lang);
      })();

      // Re-apply after every Astro View Transition page swap
      // (Astro replaces <html> attrs from the new page, which resets data-lang)
      document.addEventListener('astro:after-swap', function() {
        var lang = localStorage.getItem('vm-lang') || 'en';
        document.documentElement.setAttribute('data-lang', lang);
      });
    </script>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <!-- Google Fonts Preconnect for Malayalam -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+Malayalam:wght@400;700&display=swap" rel="stylesheet">

    <!-- View Transitions -->
    <ViewTransitions />

    <!-- Structured Data -->
    <slot name="json-ld" />
  </head>
  <body class="bg-fixed bg-center bg-cover" style="background-image: url('/images/herbal-garden-2.jpg');">
    <SplashIntro />
    <div class="min-h-screen flex flex-col bg-white/40">
      <slot name="header" />
      <main class="flex-grow">
        <slot />
      </main>
      <slot name="footer" />
    </div>
  </body>
</html>
