---
import { ViewTransitions } from 'astro:transitions';
import '@fontsource/cormorant-garamond';
import '@fontsource/source-sans-3';
import '../styles/global.css';
import SplashIntro from '../components/SplashIntro.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: URL;
  type?: string;
}

const {
  title,
  description = "Experience authentic Kerala Ayurveda at Vaidyarmandiram Ayurveda Hospital. Founded by Dr. P. Abdul Sathar Gurukkal.",
  image = "/images/og-image.jpg",
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  type = "website",
} = Astro.props;

const siteName = "Vaidyarmandiram Ayurveda Hospital";
const fullTitle = `${title} | ${siteName}`;
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png?v=3" />
    <link rel="shortcut icon" type="image/png" href="/favicon.png?v=3" />
    <link rel="apple-touch-icon" href="/favicon.png?v=3" />
    <meta name="generator" content={Astro.generator} />
    <!-- Language: restore saved preference on initial load AND after every View Transition -->
    <script is:inline>
      // Runs immediately before first paint (no flash)
      (function applyStoredLang() {
        var lang = localStorage.getItem('vm-lang') || 'en';
        document.documentElement.setAttribute('data-lang', lang);
      })();

      // Re-apply after every Astro View Transition page swap
      // (Astro replaces <html> attrs from the new page, which resets data-lang)
      document.addEventListener('astro:after-swap', function() {
        var lang = localStorage.getItem('vm-lang') || 'en';
        document.documentElement.setAttribute('data-lang', lang);
      });
    </script>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <!-- Google Fonts Preconnect for Malayalam -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+Malayalam:wght@400;700&display=swap" rel="stylesheet">

    <!-- View Transitions -->
    <ViewTransitions />

    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Hospital",
        "name": "Gurukkal's Vaidhyarmandhiram Hospital LLP",
        "alternateName": "Vaidhyarmandhiram",
        "image": "https://www.vaidhyarmandhiram.com/images/og-image.jpg",
        "@id": "https://www.vaidhyarmandhiram.com/",
        "url": "https://www.vaidhyarmandhiram.com/",
        "telephone": "+918593821553",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Pangode, Kallara",
          "addressLocality": "Thiruvananthapuram",
          "addressRegion": "Kerala",
          "postalCode": "695609",
          "addressCountry": "IN"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 8.7833,
          "longitude": 76.9667
        },
        "medicalSpecialty": [
          "Ayurvedic",
          "Traditional Healthcare"
        ]
      }
    </script>
    <slot name="json-ld" />
  </head>
  <body>
    <SplashIntro />
    <div class="min-h-screen flex flex-col relative">
      <slot name="header" />
      <main class="flex-grow">
        <slot />
      </main>
      <slot name="footer" />

      <!-- Floating WhatsApp Button (Bottom Right) -->
      <a 
        href="https://wa.me/918593821553" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="fixed bottom-6 right-6 z-50 bg-[#25D366] text-white p-3.5 rounded-full shadow-[0_4px_15px_rgba(37,211,102,0.4)] hover:bg-[#20ba5a] hover:scale-110 transition-all duration-300 flex items-center justify-center group"
        aria-label="Chat on WhatsApp"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" class="w-6 h-6 sm:w-7 sm:h-7" fill="currentColor">
          <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
        </svg>
        <span class="absolute right-16 bg-primary-dark text-background-parchment text-xs font-sans font-bold py-1.5 px-3 rounded-md opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none whitespace-nowrap shadow-md border border-accent-gold/20">
          Chat with us
        </span>
      </a>

      <!-- Floating Store Button (Bottom Right, above WhatsApp) -->
      <button 
        id="store-float-btn"
        class="fixed bottom-[5.5rem] right-6 z-50 bg-accent-gold text-primary-dark p-3.5 rounded-full shadow-[0_4px_15px_rgba(184,134,11,0.4)] hover:bg-[#a2780a] hover:text-white hover:scale-110 transition-all duration-300 flex items-center justify-center group"
        aria-label="Medicine Store"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 sm:w-7 sm:h-7">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span class="absolute right-16 bg-primary-dark text-background-parchment text-xs font-sans font-bold py-1.5 px-3 rounded-md opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none whitespace-nowrap shadow-md border border-accent-gold/20">
          Medicine Store
        </span>
      </button>

      <!-- Store Coming Soon Modal -->
      <div id="store-modal" class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300">
        <div class="bg-background-parchment max-w-md w-full rounded-2xl overflow-hidden shadow-2xl border border-accent-gold/30 flex flex-col relative transform scale-95 transition-transform duration-300">
          <div class="h-2 bg-accent-gold w-full"></div>
          <button id="close-store-modal" class="absolute top-4 right-4 text-text-muted hover:text-primary-dark transition-colors text-xl font-bold">✕</button>
          <div class="p-8 space-y-6 text-center">
            <div class="w-16 h-16 bg-accent-gold/10 text-accent-gold rounded-full flex items-center justify-center mx-auto animate-pulse">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                <line x1="3" y1="6" x2="21" y2="6"/>
                <path d="M16 10a4 4 0 0 1-8 0"/>
              </svg>
            </div>
            <div class="space-y-2">
              <h4 class="text-2xl text-primary-dark font-serif font-bold">Medicine Store</h4>
              <span class="text-xs font-sans uppercase tracking-[0.2em] bg-accent-gold/20 text-accent-gold px-3 py-1 rounded-full font-bold">Coming Soon</span>
            </div>
            <p class="text-text-muted font-sans text-sm leading-relaxed">
              Our online store featuring authentic Ayurvedic formulations, organic herbal medicines, and curated wellness products will be launched soon. Stay tuned for convenient home delivery!
            </p>
            <button id="ok-store-modal" class="w-full btn-primary !bg-primary-dark !text-background-parchment py-3 rounded-lg font-bold font-sans text-sm hover:!bg-accent-gold hover:!text-primary-dark transition-colors">
              Understood
            </button>
          </div>
        </div>
      </div>
    </div>

    <script>
      function setupStoreModal() {
        const storeBtn = document.getElementById('store-float-btn');
        const storeModal = document.getElementById('store-modal');
        const closeStoreBtn = document.getElementById('close-store-modal');
        const okStoreBtn = document.getElementById('ok-store-modal');

        if (storeBtn && storeModal && closeStoreBtn && okStoreBtn) {
          const openModal = (e) => {
            e.preventDefault();
            storeModal.classList.remove('opacity-0', 'pointer-events-none');
            const innerContent = storeModal.querySelector('div');
            if (innerContent) innerContent.classList.remove('scale-95');
          };

          const closeModal = () => {
            storeModal.classList.add('opacity-0', 'pointer-events-none');
            const innerContent = storeModal.querySelector('div');
            if (innerContent) innerContent.classList.add('scale-95');
          };

          // Remove old listeners to prevent duplicates on view transitions
          storeBtn.removeEventListener('click', openModal);
          closeStoreBtn.removeEventListener('click', closeModal);
          okStoreBtn.removeEventListener('click', closeModal);

          storeBtn.addEventListener('click', openModal);
          closeStoreBtn.addEventListener('click', closeModal);
          okStoreBtn.addEventListener('click', closeModal);
          storeModal.addEventListener('click', (e) => {
            if (e.target === storeModal) closeModal();
          });
        }
      }

      // Init on initial load
      setupStoreModal();

      // Re-run safely on Astro page loads
      document.addEventListener('astro:page-load', setupStoreModal);
    </script>
  </body>
</html>
