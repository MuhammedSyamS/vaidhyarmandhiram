---
import { ViewTransitions } from 'astro:transitions';
import '@fontsource/cormorant-garamond';
import '@fontsource/source-sans-3';
import '../styles/global.css';
import SplashIntro from '../components/SplashIntro.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: URL;
  type?: string;
}

const {
  title,
  description = "Experience authentic Kerala Ayurveda at Vaidyarmandhiram Ayurveda Hospital. Founded by Dr. P. Abdul Sathar Gurukkal.",
  image = "/images/og-image.jpg",
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  type = "website",
} = Astro.props;

const siteName = "Vaidyarmandhiram Ayurveda Hospital";
const fullTitle = `${title} | ${siteName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <!-- Google Fonts Preconnect for Malayalam -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+Malayalam:wght@400;700&display=swap" rel="stylesheet">

    <!-- View Transitions -->
    <ViewTransitions />

    <!-- Structured Data -->
    <slot name="json-ld" />
  </head>
  <body>
    <SplashIntro />
    <div class="min-h-screen flex flex-col">
      <slot name="header" />
      <main class="flex-grow">
        <slot />
      </main>
      <slot name="footer" />
    </div>
  </body>
</html>
